# Local Remote Stargate Development Environment
# Copy to docker/.env.local-remote and customize
#
# Usage:
#   cp docker/env.local-remote.example docker/.env.local-remote
#   # Edit docker/.env.local-remote with your settings
#   docker compose --env-file docker/.env.local-remote -f docker/compose/dev-local.yml up

# ============================================================================
# Federation Configuration (REQUIRED)
# ============================================================================

# API key for Master ↔ Remote authentication
# Master sends this key when making requests to Remote
# Remote uses this key for WebSocket authentication to Master
FEDERATION_API_KEY=your-api-key-here

# Remote Stargate identifier
REMOTE_ID=local-remote

# ============================================================================
# Paths
# ============================================================================

# Models directory (host path, mounted read-only in Gateway container)
MODEL_PATH_ROOT=$HOME/.models

# Model catalog directory (optional, defaults to config/models)
# MODEL_CATALOG=./config/models

# Machine name (for gateway identity)
# MACHINE_NAME=local

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# GPU Configuration
# ============================================================================

# Enable GPU support (default: true)
GPU_ENABLED=true

# CUDA visible devices (default: 0, single GPU)
CUDA_VISIBLE_DEVICES=0

# ============================================================================
# Image Configuration
# ============================================================================

# Gateway/Stargate image (default: universal-llm-gateway:gpu)
# GATEWAY_IMAGE=universal-llm-gateway:gpu
