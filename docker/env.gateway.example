# env.gateway.example
# Example environment file for Gateway Docker deployment
# Copy to .env.gateway and customize for your setup
# 
# Usage: 
#   cp docker/env.gateway.example docker/.env.gateway
#   Edit docker/.env.gateway with your settings
#   docker compose --env-file docker/.env.gateway -f docker/docker-compose.gateway-env.yml up

# ============================================================================
# Model Configuration (REQUIRED)
# ============================================================================
MODEL_PATH_ROOT=/golem/models

# ============================================================================
# Service Configuration
# ============================================================================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9998
LOG_LEVEL=info
ENVIRONMENT=default

# ============================================================================
# Resource Paths
# ============================================================================
WORKER_LOG_DIR=/golem/logs/workers
SOCKET_DIR=/golem/output/sockets
MODEL_CACHE_DIR=/golem/models

# ============================================================================
# Timeouts and Graceful Shutdown
# ============================================================================
PROCESS_STARTUP_TIMEOUT=300
GATEWAY_SHUTDOWN_GRACE=30

# ============================================================================
# Features
# ============================================================================
# Model availability check: Filters /v1/models to only show models with available file paths
# Non-fatal - missing models are hidden from API, not an error
# Set to false to disable filtering (show all configured models)
ENABLE_MODEL_AVAILABILITY_CHECK=true

ENABLE_MANAGEMENT_API=true
DISABLE_HEALTH_CHECKING=false
DEBUG_MODE=false
ENABLE_PROFILING=false

