# =============================================================================
# Inference Engine Optimization Environment Variables
# =============================================================================
# Shared environment variables for all GPU-enabled containers running inference.
# This file is sourced by Docker Compose configurations to provide consistent
# optimization settings across all edge gateway deployments.
#
# Verified against: vLLM 0.15.1 (Feb 2026) — see vllm/envs.py
#
# Usage in docker-compose.yml:
#   services:
#     my-service:
#       env_file:
#         - ./engine-optimizations.env
#         - ../../.env.my-specific-config
#
# Override any setting by:
#   1. Setting the variable in your deployment-specific .env file
#   2. Setting the variable directly in the docker-compose.yml environment section
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Compilation Control
# -----------------------------------------------------------------------------

# TORCH_COMPILE_DISABLE (PyTorch variable)
# Default: 0 (compilation enabled)
# Rationale: Fully disables torch.compile(). Even with enforce_eager=True in
# engine config, torch.compile() can still trigger on first request causing
# 60-90s delays. Trades peak throughput for fast, predictable startup.
TORCH_COMPILE_DISABLE=1

# VLLM_ENABLE_INDUCTOR_MAX_AUTOTUNE
# Default (0.15.1): 1 (enabled)
# Rationale: Benchmarks multiple kernel implementations to find the fastest.
# Causes 30-60s delays on first compilation. Defensive override — inductor
# shouldn't trigger with TORCH_COMPILE_DISABLE=1, but guards against edge cases.
VLLM_ENABLE_INDUCTOR_MAX_AUTOTUNE=0

# VLLM_ENABLE_INDUCTOR_COORDINATE_DESCENT_TUNING
# Default (0.15.1): 1 (enabled)
# Rationale: Additional inductor tuning pass. Same reasoning as above.
VLLM_ENABLE_INDUCTOR_COORDINATE_DESCENT_TUNING=0


# -----------------------------------------------------------------------------
# 2. Runtime Performance
# -----------------------------------------------------------------------------

# VLLM_SLEEP_WHEN_IDLE
# Default (0.15.1): 0 (busy-poll scheduler loop)
# Rationale: Without this, vLLM's scheduler busy-polls at ~2000% CPU with no
# requests. Setting to 1 adds ~100ms latency on first request after idle period,
# acceptable for our multi-model gateway pattern where models sit idle between
# requests.
#
# NOTE (0.16.0): Intermittent hang observed where the vLLM HTTP server accepts
# UDS connections but stops processing HTTP requests entirely (no GPU activity,
# /health unreachable). Suspected race condition in the idle→active IPC reader
# transition (SpinSleepTimer in shm_broadcast.py). Set to 0 to eliminate the
# transition; cost is ~2000% CPU busy-poll per idle model. Re-evaluate after
# confirming the hang is eliminated.
VLLM_SLEEP_WHEN_IDLE=0

# PYTORCH_CUDA_ALLOC_CONF (PyTorch variable)
# Default: not set (standard block allocator)
# Rationale: expandable_segments avoids GPU memory fragmentation during model
# loading by using expandable memory segments instead of fixed-size blocks.
# Critical for our dynamic model loading/unloading pattern — reduces OOM risk
# when frequently swapping models in/out of VRAM.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True


# -----------------------------------------------------------------------------
# 3. Compilation & Kernel Caches
# -----------------------------------------------------------------------------
# CRITICAL: Without writable cache directories, Triton/FlashInfer/CUDA kernels
# recompile on every container restart causing 2-5 minute startup delays.
#
# The Docker Compose mounts a host volume for persistence:
#   ${HOME}/.cache/vllm:/golem/vllm_cache:rw
#
# The host directory is pre-created by the service controller (service_ctl.py)
# before docker compose up, so Docker does not create it as root:root.
# Cache subdirs (triton/, cuda/, .cache/flashinfer/) are created by golem-start.sh
# at container startup as appuser, so they are always correctly owned.

# VLLM_CACHE_ROOT
# Default (0.15.1): ~/.cache/vllm
# Rationale: Point to mounted volume. vLLM derives sub-paths from this root
# (torch_compile_cache/, assets/, etc.).
VLLM_CACHE_ROOT=/golem/vllm_cache

# TRITON_CACHE_DIR (Triton variable)
# Default: ~/.triton/cache
# Rationale: Triton JIT-compiles custom GPU kernels (attention, activation, etc.)
# on first use. Cached kernels load in milliseconds vs seconds to compile.
TRITON_CACHE_DIR=/golem/vllm_cache/triton

# CUDA_CACHE_PATH (NVIDIA driver variable)
# Default: ~/.nv/ComputeCache
# Rationale: Driver-level PTX-to-SASS compilation cache. Avoids recompilation
# of CUDA kernels across container restarts.
CUDA_CACHE_PATH=/golem/vllm_cache/cuda

# FLASHINFER_WORKSPACE_BASE (FlashInfer variable)
# Default: ~ (home directory)
# Rationale: FlashInfer derives its cache at $FLASHINFER_WORKSPACE_BASE/.cache/flashinfer
# and JIT-compiles attention kernels there. Without redirection, it caches at
# /home/appuser/.cache/flashinfer (inside the container) — ephemeral, causing
# 1-2 minute kernel recompilation on every restart.
FLASHINFER_WORKSPACE_BASE=/golem/vllm_cache

# XDG_CACHE_HOME (freedesktop.org standard)
# Default: ~/.cache
# Rationale: Standard base directory for user-specific cache files. Various
# libraries (HuggingFace, etc.) derive cache paths from this.
XDG_CACHE_HOME=/home/appuser/.cache


# -----------------------------------------------------------------------------
# 4. Attention Backend
# -----------------------------------------------------------------------------
# vLLM auto-selects the optimal attention backend based on hardware and model.
# No override needed for most deployments. Set in deployment-specific .env only
# if profiling reveals a better option for your workload:
#   VLLM_ATTENTION_BACKEND=FLASH_ATTN    (FlashAttention v2 — stable, well-tested)
#   VLLM_ATTENTION_BACKEND=FLASHINFER    (FlashInfer — fastest for some models)
#   VLLM_ATTENTION_BACKEND=XFORMERS     (xFormers — broad compatibility fallback)


# -----------------------------------------------------------------------------
# 5. DeepGemm Configuration
# -----------------------------------------------------------------------------
# DeepGemm JIT-compiles GEMM kernels on demand (FP8/NVFP4 quantized models).
# Standard quantizations (AWQ, GPTQ, Q8, Q4, BF16) do NOT use DeepGemm.
#
# VLLM_DEEP_GEMM_WARMUP
# Default (0.15.1): "relax" (heuristic warmup at startup — can add 1-2 minutes)
# Options: "skip" (no warmup), "relax" (heuristic), "full" (exhaustive)
# Rationale: Leave at default. Warmup only runs for models that use DeepGemm;
# no-op for standard models. If loading FP8 models and startup time matters,
# set to "skip" to defer kernel compilation to first request.
# VLLM_DEEP_GEMM_WARMUP=skip


# -----------------------------------------------------------------------------
# 6. OpenMP Configuration (llama.cpp GGUF models)
# -----------------------------------------------------------------------------

# Static scheduling provides consistent, low-variance performance for inference
OMP_SCHEDULE=static
OMP_DYNAMIC=false
OMP_NESTED=false

# Thread counts intentionally NOT set — allow auto-detection per machine.
# Override in deployment-specific .env if CPU contention is observed:
# OMP_NUM_THREADS=16
# MKL_NUM_THREADS=16
# OPENBLAS_NUM_THREADS=16

# OMP_WAIT_POLICY intentionally NOT set.
# CRITICAL: Do NOT set to ACTIVE — causes OpenMP threads to spin-wait at
# 100% CPU each when idle, resulting in 2000%+ CPU usage alongside vLLM.
# Default PASSIVE policy (unset) allows threads to sleep when idle.


# -----------------------------------------------------------------------------
# 7. Tokenizers
# -----------------------------------------------------------------------------

# TOKENIZERS_PARALLELISM (HuggingFace variable)
# Default: true
# Uncomment to suppress fork-safety warnings from HuggingFace tokenizers.
# Only cosmetic — does not affect performance.
# TOKENIZERS_PARALLELISM=false


# -----------------------------------------------------------------------------
# 8. Native llama-server Configuration
# -----------------------------------------------------------------------------

# LLAMA_USE_NATIVE_SERVER
# Default: true (use native llama-server)
# Set to "false" to use llama-cpp-python instead.
# Native server requires llama-server binary in PATH or LLAMA_SERVER_PATH set.
LLAMA_USE_NATIVE_SERVER=true

# LLAMA_SERVER_PATH
# Default: auto-detect from PATH
# Override llama-server binary path (default: auto-detect from PATH).
# Docker: /opt/llama-server/bin/llama-server (auto-added to PATH)
# Local: ~/.local/bin/llama-server (auto-detected)
# LLAMA_SERVER_PATH=/opt/llama-server/bin/llama-server

# LLAMA_SERVER_PARALLEL_SLOTS
# Default: 8
# Number of parallel inference slots (concurrent requests on same model).
# Higher values allow more concurrent requests but increase VRAM usage.
# LLAMA_SERVER_PARALLEL_SLOTS=8

# LLAMA_SERVER_CONTINUOUS_BATCHING
# Default: true
# Enable continuous batching (dynamic request scheduling for better throughput).
# Disable for simpler scheduling with lower latency variance.
# LLAMA_SERVER_CONTINUOUS_BATCHING=true


# =============================================================================
# Variables REMOVED (previously set, no longer functional in vLLM 0.15.1):
#
#   VLLM_USE_V1=1
#     Removed in 0.15.0. V1 is the only engine; variable has no effect.
#
#   VLLM_FLASH_ATTN_VERSION=2
#     Not a recognized vLLM or FlashAttention env var. No effect.
#
#   VLLM_DISABLE_CUDA_GRAPHS=0
#     Not a recognized vLLM env var. CUDA graph behavior is controlled by
#     enforce_eager in engine/model config, not environment.
# =============================================================================
