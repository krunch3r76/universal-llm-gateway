[Unit]
Description=grokbuild-worker FastAPI service
After=network.target

[Service]
Type=simple
User=io
ExecStart=/home/io/.venvs/universal/bin/python -m services.grokbuild_worker.main
WorkingDirectory=/mnt/torus/projects/universal-llm-gateway
Environment=PYTHONPATH=/mnt/torus/projects/universal-llm-gateway/libs
Environment=GROKBUILD_WORKER_HOST=127.0.0.1
Environment=GROKBUILD_WORKER_PORT=8090
Environment=GROKBUILD_SIDECAR_DIR=/home/io/.local/share/grokbuild-worker/sidecars
Environment=GROKBUILD_REGISTRY_PATH=/home/io/.local/share/grokbuild-worker/registry.json
Environment=GROK_BIN_PATH=/home/io/.local/bin/grok
Environment=GROK_AUTH_DIR=/home/io/.grok
Environment=PROJECTS_ROOT=/mnt/torus/projects
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
