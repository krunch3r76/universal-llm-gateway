#!/bin/sh
# Ensure a CDP lane unit is active and its port is listening.
set -eu

LANE="${1:?usage: cdp-lane-ensure <lane_name>}"
REPO="${ULG_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}"
PINS="$REPO/services/jupiter-cdp/pins.toml"

# Resolve lane_aliases (doordash -> gopuff) before the unit name is chosen.
# Missing alias target is invalid. Same port must not start a second unit.
LANE=$(python3 - "$PINS" "$LANE" <<'PY'
import sys, tomllib
pins, lane = sys.argv[1], sys.argv[2]
with open(pins, "rb") as f:
    doc = tomllib.load(f)
lanes = doc.get("lanes", {})
aliases = doc.get("lane_aliases", {})
resolved = str(aliases.get(lane, lane))
if resolved not in lanes or (lane in aliases and resolved == lane):
    sys.exit(1)
print(resolved)
PY
) || {
  echo "invalid lane: ${1}" >&2
  exit 1
}

PORT=$(python3 - "$PINS" "$LANE" <<'PY'
import sys, tomllib
pins, lane = sys.argv[1], sys.argv[2]
with open(pins, "rb") as f:
    print(tomllib.load(f)["lanes"][lane]["port"])
PY
)

systemctl --user start "cdp-lane@${LANE}.service"

deadline=$(( $(date +%s) + 20 ))
while [ "$(date +%s)" -lt "$deadline" ]; do
  if systemctl --user is-active --quiet "cdp-lane@${LANE}.service" \
    && curl -sf "http://127.0.0.1:${PORT}/json/version" >/dev/null 2>&1; then
    exit 0
  fi
  sleep 0.25
done

echo "cdp-lane-ensure: timeout waiting for ${LANE}:${PORT}" >&2
exit 1
