#!/bin/sh
# Ensure a CDP lane unit is active and its port is listening.
set -eu

LANE="${1:?usage: cdp-lane-ensure <lane_name>}"
REPO="${ULG_REPO:-$(cd "$(dirname "$0")/../.." && pwd)}"
PINS="$REPO/services/jupiter-cdp/pins.toml"

if ! python3 - "$PINS" "$LANE" <<'PY'
import sys, tomllib
pins, lane = sys.argv[1], sys.argv[2]
with open(pins, "rb") as f:
    lanes = tomllib.load(f).get("lanes", {})
sys.exit(0 if lane in lanes else 1)
PY
then
  echo "invalid lane: $LANE" >&2
  exit 1
fi

PORT=$(python3 - "$PINS" "$LANE" <<'PY'
import sys, tomllib
pins, lane = sys.argv[1], sys.argv[2]
with open(pins, "rb") as f:
    print(tomllib.load(f)["lanes"][lane]["port"])
PY
)

systemctl --user start "cdp-lane@${LANE}.service"

deadline=$(( $(date +%s) + 20 ))
while [ "$(date +%s)" -lt "$deadline" ]; do
  if systemctl --user is-active --quiet "cdp-lane@${LANE}.service" \
    && curl -sf "http://127.0.0.1:${PORT}/json/version" >/dev/null 2>&1; then
    exit 0
  fi
  sleep 0.25
done

echo "cdp-lane-ensure: timeout waiting for ${LANE}:${PORT}" >&2
exit 1
