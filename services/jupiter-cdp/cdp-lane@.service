[Unit]
Description=Jupiter CDP Chrome lane %i
After=network-online.target
PartOf=jupiter-cdp.target

[Service]
Type=notify
StartLimitIntervalSec=0
ExecStartPre=%h/.local/bin/wait-for-file ${ULG_REPO}/services/jupiter-cdp/pins.toml
ExecStart=%h/.local/bin/cdp-lane-launch %i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=jupiter-cdp.target
