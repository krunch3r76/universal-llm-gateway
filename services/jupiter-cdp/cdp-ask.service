[Unit]
Description=Jupiter cdp-ask satellite (manage env replay)

[Service]
Type=forking
PIDFile=%h/.gateway/cdp-ask.pid
EnvironmentFile=%h/.gateway/cdp-ask.env
ExecStart=%h/.local/bin/cdp-ask-start
Restart=on-failure
RestartSec=10
SuccessExitStatus=SIGTERM SIGINT
RefuseManualStop=yes

[Install]
WantedBy=jupiter-cdp.target
