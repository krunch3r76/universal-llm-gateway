[Unit]
Description=CA SCO unclaimed property hunter — bulk extract oneshot
After=network-online.target
Wants=network-online.target
; email-bridge is a host subprocess (manage), not a systemd unit — wait for UDS peer.
Documentation=man:systemd.service(5)

[Service]
Type=oneshot
WorkingDirectory=/mnt/torus/projects/universal-llm-gateway
Environment=PYTHONPATH=/mnt/torus/projects/universal-llm-gateway/libs
Environment=PAGER_NOTIFY_ENABLED=1
Environment=CORTEX_FILES_ROOT=/mnt/torus/mcp-data/files
ExecStartPre=/home/io/.venvs/universal/bin/python /mnt/torus/projects/universal-llm-gateway/scripts/unclaimed-property-hunt wait-pager-peer
; Roster path is resolved by the CLI to ~/.gateway/unclaimed_property_hunter/
; roster.yaml — deliberately outside the repo, which has a public remote.
ExecStart=/home/io/.venvs/universal/bin/python /mnt/torus/projects/universal-llm-gateway/scripts/unclaimed-property-hunt scheduled-extract

[Install]
WantedBy=default.target
