[Unit]
# Auxiliary seat-managed unit (not a `manage` fleet service).
# Pages when the gear-3 liaison ticker stops making progress.
#
# Why a separate timer instead of OnFailure= on liaison-ticker-10479:
# that unit has RestartSec=60 against StartLimitBurst=5/StartLimitIntervalSec=10,
# so five restarts can never land inside the ten-second window. It therefore
# never reaches `failed` and an OnFailure= hook would be dead code. Observed
# 2026-09-14: clock down ~14min at NRestarts=8 while the unit still read active.
Description=Liaison ticker watchdog (root 10479) — page on a stopped clock

[Service]
Type=oneshot
WorkingDirectory=/mnt/torus/projects/universal-llm-gateway
Environment=PYTHONPATH=/mnt/torus/projects/universal-llm-gateway/libs
Environment=CORTEX_FILES_ROOT=/mnt/torus/mcp-data/files
Environment=PATH=/home/io/.venvs/universal/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/io/.venvs/universal/bin/python scripts/liaison_ticker_watchdog.py --root 10479
