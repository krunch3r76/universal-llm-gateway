{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Tool Name Registry",
  "description": "JSON Schema for config/mcp/canonical.yaml. Enforces naming, FOL descriptor presence, and required fields for G1 CI gate.",
  "type": "object",
  "required": ["schema_version", "generated_by", "last_audited", "domains", "tools"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_by": {
      "type": "string"
    },
    "last_audited": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "domains": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {"$ref": "#/definitions/CanonicalTool"},
      "minItems": 1
    },
    "contract_vocabulary": {
      "type": "object",
      "required": ["density_triage"],
      "properties": {
        "density_triage": {"$ref": "#/definitions/ContractVocabularyEntry"}
      },
      "additionalProperties": false
    },
    "domain_endpoints": {"$ref": "#/definitions/DomainEndpoints"},
    "surface_primary_domains": {"$ref": "#/definitions/SurfacePrimaryDomains"},
    "cortex_families": {"$ref": "#/definitions/CortexFamilies"},
    "overflow_register_surfaces": {"$ref": "#/definitions/OverflowRegisterSurfaces"}
  },
  "additionalProperties": false,
  "definitions": {
    "EndpointSurface": {
      "type": "string",
      "enum": ["life", "code", "code_overflow"]
    },
    "EndpointSurfaceList": {
      "type": "array",
      "items": {"$ref": "#/definitions/EndpointSurface"},
      "minItems": 1,
      "uniqueItems": true
    },
    "DomainEndpoints": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {"$ref": "#/definitions/EndpointSurfaceList"},
        "exceptions": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/EndpointSurfaceList"}
        }
      },
      "additionalProperties": false
    },
    "SurfacePrimaryDomains": {
      "type": "object",
      "required": ["life", "code"],
      "properties": {
        "life": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "code": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "CortexFamily": {
      "type": "string",
      "enum": ["read", "write", "session", "gate", "admin"]
    },
    "CortexOpList": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "CortexFamilies": {
      "type": "object",
      "required": ["defaults", "uncurated"],
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/EndpointSurfaceList"}
        },
        "uncurated": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/CortexOpList"}
        }
      },
      "additionalProperties": false
    },
    "OverflowRegisterSurfaces": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/EndpointSurfaceList"}
    },
    "ContractVocabularyEntry": {
      "type": "object",
      "required": ["fol_descriptor", "accepted_values", "introduced"],
      "properties": {
        "fol_descriptor": {
          "type": "string",
          "description": "FOL-style invariant body for the accepted-value set.",
          "minLength": 20
        },
        "accepted_values": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mechanical",
              "judgment_required",
              "cross_cutting",
              "dispatch_surface",
              "admission_path",
              "trivial",
              "recon_pending"
            ]
          },
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true
        },
        "introduced": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "CanonicalTool": {
      "type": "object",
      "required": [
        "canonical_name",
        "domain",
        "operation",
        "dispatcher_call_shape",
        "flat_call_shape",
        "fol_descriptor",
        "json_schema",
        "skill_uri",
        "seat_visibility",
        "mandate_safety",
        "cache_priority"
      ],
      "properties": {
        "canonical_name": {
          "type": "string",
          "description": "Unique key. Form: <domain>_<operation>. Must match G8 naming pattern.",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$"
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "operation": {
          "type": "string"
        },
        "dispatcher_call_shape": {
          "type": "object",
          "required": ["tool", "dispatch_key", "dispatch_value"],
          "properties": {
            "tool": {"type": "string"},
            "dispatch_key": {
              "type": "string",
              "description": "D8-normalized: must be 'op' for all entries (Phase D cutover enforces this)."
            },
            "dispatch_value": {"type": "string"}
          },
          "additionalProperties": false
        },
        "flat_call_shape": {
          "type": "object",
          "required": ["tool", "substrate_qualified"],
          "properties": {
            "tool": {"type": "string"},
            "substrate_qualified": {
              "type": "string",
              "pattern": "^user-vortex__"
            }
          },
          "additionalProperties": false
        },
        "fol_descriptor": {
          "type": "string",
          "description": "FOL-style invariant body. Must contain at least one of: ∀ ∃ ⟹ ¬ ∈ (enforced by G6).",
          "minLength": 20
        },
        "json_schema": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string"},
            "properties": {"type": "object"},
            "required": {"type": "array"}
          }
        },
        "skill_uri": {
          "type": "string",
          "pattern": "^(agent_skill|rule):[a-z][a-z0-9_-]*$"
        },
        "seat_visibility": {
          "type": "array",
          "items": {"type": "string", "enum": ["mcp", "mcp_claude"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "mandate_safety": {
          "type": "string",
          "enum": ["read_only", "write", "destructive", "mutating"]
        },
        "cache_priority": {
          "type": "string",
          "enum": ["always_loaded", "on_demand"]
        },
        "introduced": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "deprecated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "remove_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "replacement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$"
        },
        "notes": {
          "type": "string"
        },
        "family": {
          "$ref": "#/definitions/CortexFamily",
          "description": "Cortex census family for curated ops (derive_cortex_surface)."
        },
        "endpoint_visibility": {
          "$ref": "#/definitions/EndpointSurfaceList",
          "description": "Per-op endpoint override; defaults come from cortex_families.defaults."
        }
      },
      "additionalProperties": false
    }
  }
}
