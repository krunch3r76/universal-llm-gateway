# Universal LLM Gateway - Environment Configuration
#
# Copy this file and rename for your deployment:
#   cp .env.example .env.gpu-master-myhost
#
# Generate secure federation keys:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# IMPORTANT: Never commit .env files with real keys.
# All .env.* files (except .env.example) are in .gitignore.

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=DEBUG

# =============================================================================
# Cortex API (used by journal_extract handlers)
# =============================================================================
# Containerized Stargate/Gateway deployments should use:
#   CORTEX_API_URL=http://cortex-api:8300
# Host-process deployments can use:
#   CORTEX_API_URL=http://127.0.0.1:8300

# =============================================================================
# Federation API Keys
# =============================================================================
# Each key must match between Master and the corresponding Remote.
# Generate unique keys per remote node.

# Key for authenticating Remote node "node-1"
FEDERATION_KEY_NODE_1="CHANGE_ME_generate_with_secrets_token_urlsafe"

# Key for authenticating to Edge container on node-1
FEDERATION_KEY_EDGE_NODE_1="CHANGE_ME_generate_with_secrets_token_urlsafe"

# =============================================================================
# Gateway API Key
# =============================================================================
# Required. Stargate uses this to authenticate to the Gateway.
GATEWAY_API_KEY="CHANGE_ME_generate_with_secrets_token_urlsafe"

# =============================================================================
# MCP Server
# =============================================================================
# Bearer token for the internet-facing MCP server (:443).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN="CHANGE_ME_generate_with_secrets_token_urlsafe"

# Optional: enables web_search tool. Get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=""

# Path to active Firefox profile directory for browser automation tools.
# Find yours: ls ~/.mozilla/firefox/*.default-release*
# Example: FIREFOX_PROFILE_DIR="/home/io/.mozilla/firefox/4dt8vx31.default-release-1758939280366"
FIREFOX_PROFILE_DIR=""

# Enable Playwright Firefox browser automation tools (browser_navigate, browser_click, etc.).
# Disabled by default — enabling requires a container restart with the browser override,
# which applies a narrow seccomp relaxation (unshare/clone3/setns for Firefox sandbox).
#
# To enable:
#   1. Set ENABLE_BROWSER_TOOLS=true here
#   2. Restart with: docker compose -f docker/compose/mcp-server.yml \
#                                   -f docker/compose/mcp-server-browser.override.yml up -d
#
# To disable: restart without the override (tools disappear, seccomp returns to default).
ENABLE_BROWSER_TOOLS=false

# SQLite databases for Claude context store.
# Create ~/mcp-data/sqlite.yaml with database mappings:
#   sqlite:
#     max_rows: 100
#     allow_destructive: false
#     databases:
#       default:
#         path: /data/databases/context.db
#         description: "Primary Claude context store"
# Database files are stored under ~/mcp-data/databases/

# =============================================================================
# Build Configuration
# =============================================================================
# BUILD_SCOPE=all          # all | llama (skip vLLM build)
# LLAMA_USE_NATIVE_SERVER=true

# =============================================================================
# Debug
# =============================================================================
# STARGATE_DEBUG_REQUEST_SNAPSHOTS=true
