{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/seat-write-session-start.sh"
      },
      {
        "command": "python3 scripts/cursor/resume_fence_hook.py --event sessionStart"
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/seat-write-session-end.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/register-seat-write.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 scripts/cursor/resume_fence_hook.py --event beforeSubmitPrompt"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 scripts/cursor/resume_fence_hook.py --event beforeMCPExecution",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 scripts/cursor/resume_fence_hook.py --event beforeShellExecution",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 scripts/cursor/resume_fence_hook.py --event beforeReadFile",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 scripts/cursor/resume_fence_hook.py --event preToolUse",
        "failClosed": true
      }
    ]
  }
}
