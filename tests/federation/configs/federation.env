# Federation Test - API Keys and Environment Variables
# Source this file before starting Stargate instances

# Federation API keys (use secure random values in production)
# For testing, we use simple values

# Master → Jupiter API key (used by localhost Master to connect to jupiter Remote)
export FEDERATION_KEY_JUPITER="test-key-master-to-jupiter-12345"

# Jupiter → Master authentication (used by jupiter Remote to validate localhost Master)
export FEDERATION_KEY_FROM_LOCALHOST="test-key-master-to-jupiter-12345"

# Note: In production, generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
