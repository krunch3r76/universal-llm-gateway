# Tests are tracked (operator bind 2026-07-31, a:27411). Untracked tests had made
# every cross-seat "tests pass" claim unverifiable from the repo; repo-wide ignores
# (**/test_*.py, **/*_test.py, **/conftest.py, tests/*) were removed in 71e6f0e9.
# There is no blanket test ignore today — tests are tracked because nothing ignores
# them, not because individual paths are negated. Prior ! allowlist lines were
# historical residue from the removed rules and have been pruned.
# Root-anchored: rsync --filter=:- .gitignore ignores git ! negations.
# Use /foo/ not foo/ when foo/ also appears as a source directory elsewhere in the tree.
/templates/
# Root-level model weight directory only — NOT */models/ Python source trees.
/models/
# Weight file extensions (any path; complements /models/ depth rule)
*.safetensors
*.gguf
*.pt
*.pth
*.onnx
.cursorignore
# GitHub Actions workflows are tracked; other dot-github content stays local
.github/*
!.github/workflows/
!.github/workflows/*.yml
proposals/
summaries/

.git/
changelog/
# Local pipeline development workspace (not for public release)
# Mature pipelines go in pipelines/ (tracked)
pipelines.local/

# Local-only MCP tools (not for public release; same idea as pipelines.local)
services/mcp-server/tools/local/

# Cursor IDE MCP tool descriptor cache (machine-local, managed by Cursor)
mcps/

# Local-only service controller plugins (not for public release)
scripts/model_manager/ui/controller/service_ctl/local/

# Local-only scripts (not for public release; same idea as pipelines.local)
scripts.local/

# RAG scope vocabulary (auto-generated, per-machine)
scope_vocabulary.yaml

# Model rates catalog projection (cloud-proxy ingest → host state; ¬ tracked)
# Seed SOT: config/model_rates.yaml. Override: MODEL_RATES_CATALOG_PATH.
# Default path is ~/.gateway/model_rates_catalog.yaml (outside the repo).
# Legacy repo data/ regen from pre-refactor processes — ignore if it reappears.
data/

