# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
/build/
*.egg
.venv/
venv/
ENV/
env/

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project specific
*.log
*.sqlite
*.db
.pytest_cache/
.coverage
htmlcov/
logs/

# PyArmor license files (NEVER commit)
pyarmor-regfile-*.zip
pyarmor-regcode-*.txt

# Environment files (contain secrets - NEVER commit)
.env.*
*.env.local
.env.*.local
config/env/*.local
# Keep example files tracked
!.env.example
!.env.*.example
tmp/
docs/

# IDE - Keep settings.json but ignore other VS Code files
.vscode/
.cursor/

# Ruff cache (MUST be added BEFORE running ruff format/check)
.ruff_cache/

# Type checking
.mypy_cache/
.pytype/
.pyre/

prompts/
tests/
templates/
!config/templates/
.cursorignore
.github/
proposals/
# Model weight/binary files — NOT the static catalog or source code
models/
!config/models/
!services/_universal-llm-gateway/src/routers/**/models/
summaries/

.git/
changelog/
# Local pipeline development workspace (not for public release)
# Mature pipelines go in pipelines/ (tracked)
pipelines.local/

# Development artifacts
report.txt
ATTRIBUTION.txt

# Generated images (regenerate from PlantUML sources in docs)
*.svg
*.png

# Documentation — only root README.md, CONTRIBUTING.md, and examples/adding-model-workflow-cpu.md are public
**/*.md
!/README.md
!/CONTRIBUTING.md
!/examples/adding-model-workflow-cpu.md

# Internal architecture/proposal notes
**/proposals/
services/universal-stargate/docs/
libs/universal_transport/tmp/
services/universal-stargate/systems/graphics/references/
docker/docs/
