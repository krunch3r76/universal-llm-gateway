# Copy to ~/.config/ulg-impresario/env (mode 600). Never commit the real file.
#
# Required for HTTP /v1/info and channel push:
AGENT_SDK_BEARER_TOKEN=
#
# House MCP bearer (impresario host HTTP connection). Same secret family as cursor-sdk
# bridge MCP_TOKEN / ~/.gateway/mcp.yaml auth_token_env (often MCP_AUTH_TOKEN):
# ULG_MCP_TOKEN=
# House MCP HTTP base (default https://mcp.k-1.me/mcp/code when unset — not CDP :9338):
# ULG_MCP_HTTP_URL=https://mcp.k-1.me/mcp/code
# Optional overrides: MCP_URL on cursor-sdk bridge; scheme-less host:port → /mcp/code appended
#
# Bus identity (defaults shown):
# House lane thread id the impresario polls (worker thread for this seat):
ULG_IMPRESARIO_LANE=20908
# Review mail when paste-resolve is unsupported. Live deploy must set this too.
ULG_IMPRESARIO_REVIEW_MAILBOX=grok-bot-gc1
ULG_IMPRESARIO_MAILBOX=impresario-sdk
#
# Host gates (defaults safe for overnight):
ULG_MODEL_TURNS=0
ULG_LIVE_STEER=0
ULG_BUS_MODE=poll
#
# Model turns (only when CURSOR_API_KEY is present):
# CURSOR_API_KEY=
#
# Serve layout:
ULG_IMPRESARIO_STATE_ROOT=/home/io/.local/state/ulg-impresario
