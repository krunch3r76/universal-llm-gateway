#!/usr/bin/env python3
"""Agent Bus UI — browser-based thread viewer and reply tool.

Serves a single-page web UI backed by a local FastAPI proxy that forwards
requests to the agent-bus UDS socket.

Usage:
  agent-bus-ui             # serve on http://localhost:7779
  agent-bus-ui --port 8080
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

import httpx
import uvicorn
import yaml
from fastapi import FastAPI, HTTPException, Request, Response
from fastapi.responses import HTMLResponse

_SOCKET = os.environ.get("AGENT_BUS_SOCK", "/tmp/universal-protocol/agent-bus.sock")
_MCP_YAML = Path.home() / ".gateway" / "mcp.yaml"
_DEFAULT_PORT = 7779


def _resolve_token() -> str:
    try:
        with open(_MCP_YAML) as f:
            cfg = yaml.safe_load(f)
        token = cfg.get("AGENT_BUS_TOKEN", "")
        if not token:
            print("AGENT_BUS_TOKEN not found in ~/.gateway/mcp.yaml", file=sys.stderr)
            sys.exit(1)
        return token
    except Exception as e:
        print(f"Failed to read token: {e}", file=sys.stderr)
        sys.exit(1)


_TOKEN = ""

app = FastAPI(title="agent-bus-ui-proxy")

_HTML = r"""<!DOCTYPE html>
