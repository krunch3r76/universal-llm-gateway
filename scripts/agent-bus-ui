<header>
  <h1>Agent <span>Bus</span></h1>
  <div class="header-actions">
    <button class="btn-secondary btn-sm" onclick="openNewThread()">+ New Thread</button>
    <button class="btn-secondary btn-sm" onclick="refresh()">↺ Refresh</button>
  </div>
</header>
<div class="main">
  <div class="sidebar">
    <div class="sidebar-header">
      <div class="tabs">
        <div class="tab active" onclick="setFilter('active', this)">Active</div>
        <div class="tab" onclick="setFilter('closed', this)">Closed</div>
        <div class="tab" onclick="setFilter('all', this)">All</div>
      </div>
    </div>
    <div class="thread-list" id="thread-list">
      <div style="padding:16px;text-align:center;color:var(--text-dim)"><span class="spinner"></span></div>
    </div>
  </div>
  <div class="detail" id="detail">
    <div class="detail-empty">Select a thread to view turns</div>
  </div>
</div>

<!-- New thread modal -->
<div class="modal-overlay" id="new-thread-modal">
  <div class="modal">
    <h2>New Thread</h2>
    <div class="form-row"><label class="form-label">Slug</label><input type="text" id="nt-slug" placeholder="e.g. review-task-123"></div>
    <div class="form-row"><label class="form-label">To</label>
      <select id="nt-to">
        <option value="web">web</option>
        <option value="api">api</option>
        <option value="cursor">cursor</option>
        <option value="kaywan">kaywan</option>
      </select>
    </div>
    <div class="form-row"><label class="form-label">Subject</label><input type="text" id="nt-subject" placeholder="Thread subject"></div>
    <div class="form-row"><label class="form-label">Body</label><textarea id="nt-body" rows="5" placeholder="First turn body…"></textarea></div>
    <div class="modal-actions">
      <button class="btn-secondary" onclick="closeNewThread()">Cancel</button>
      <button class="btn-primary" onclick="submitNewThread()">Post</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
let currentFilter = 'active';
let currentThread = null;
let threads = [];
let turns = [];

async function api(method, path, body) {
  const opts = { method, headers: { 'Content-Type': 'application/json' } };
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch('/api' + path, opts);
  if (!res.ok) {
    const err = await res.json().catch(() => ({ detail: res.statusText }));
    throw new Error(JSON.stringify(err.detail || err));
  }
  return res.json();
}

function toast(msg, isError) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'toast show' + (isError ? ' error' : '');
  setTimeout(() => el.className = 'toast', 3000);
}

function setFilter(f, el) {
  currentFilter = f;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  loadThreads();
}

async function loadThreads(preserveScroll = false) {
  const listEl = document.getElementById('thread-list');
  const savedScrollTop = preserveScroll && listEl ? listEl.scrollTop : 0;
  try {
    const data = await api('GET', '/threads?status=' + currentFilter);
    threads = data.threads || [];
    renderThreadList();
    if (preserveScroll && listEl) {
      listEl.scrollTop = savedScrollTop;
    }
  } catch (e) {
    document.getElementById('thread-list').innerHTML = '<div style="padding:12px;color:var(--red);font-size:12px">Failed to load threads</div>';
  }
}

function renderThreadList() {
  const el = document.getElementById('thread-list');
  if (!threads.length) {
    el.innerHTML = '<div style="padding:16px;text-align:center;color:var(--text-dim);font-size:13px">No threads</div>';
    return;
  }
  el.innerHTML = threads.map(t => `
    <div class="thread-item ${t.unread_count > 0 ? 'has-unread' : ''} ${currentThread?.id === t.id ? 'active' : ''}"
         onclick="selectThread('${t.id}')">
      <div class="thread-slug">
        <span>${t.slug}</span>
        ${t.unread_count > 0 ? `<span class="unread-badge">${t.unread_count}</span>` : ''}
      </div>
      <div class="thread-meta">
        <span class="status-chip status-${t.status}">${t.status}</span>
        ${t.last_subject ? ' · ' + escHtml(t.last_subject) : ''}
        · ${t.turn_count} turn${t.turn_count !== 1 ? 's' : ''}
      </div>
    </div>
  `).join('');
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function fmtTime(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
}

async function selectThread(id) {
  currentThread = threads.find(t => t.id === id) || { id };
  renderThreadList();
  await loadTurns(false, 'top');
}

async function loadTurns(preserveForm, scrollMode = 'preserve') {
  if (!currentThread) return;
  const detail = document.getElementById('detail');
  const existingTurnsList = document.getElementById('turns-list');

  // Snapshot form values before any re-render
  const savedFrom    = preserveForm ? (document.getElementById('reply-from')?.value    ?? '') : '';
  const savedTo      = preserveForm ? (document.getElementById('reply-to')?.value      ?? '') : '';
  const savedSubject = preserveForm ? (document.getElementById('reply-subject')?.value ?? '') : '';
  const savedBody    = preserveForm ? (document.getElementById('reply-body')?.value    ?? '') : '';
  const savedScrollTop = existingTurnsList ? existingTurnsList.scrollTop : 0;

  if (!preserveForm) {
    detail.innerHTML = '<div class="detail-empty"><span class="spinner"></span></div>';
  }
  try {
    const [threadData, turnsData] = await Promise.all([
      api('GET', '/threads/' + currentThread.id),
      api('GET', '/turns?thread=' + currentThread.id + '&last=100')
    ]);
    currentThread = threadData;
    turns = turnsData.turns || [];
    renderDetail();

    const turnsList = document.getElementById('turns-list');
    if (turnsList) {
      if (scrollMode === 'bottom') {
        turnsList.scrollTop = turnsList.scrollHeight;
      } else if (scrollMode === 'preserve') {
        turnsList.scrollTop = savedScrollTop;
      } else {
        turnsList.scrollTop = 0;
      }
    }

    // Restore form values after re-render
    if (preserveForm) {
      const fromEl    = document.getElementById('reply-from');
      const toEl      = document.getElementById('reply-to');
      const subjectEl = document.getElementById('reply-subject');
      const bodyEl    = document.getElementById('reply-body');
      if (fromEl    && savedFrom)    fromEl.value    = savedFrom;
      if (toEl      && savedTo)      toEl.value      = savedTo;
      if (subjectEl && savedSubject) subjectEl.value = savedSubject;
      if (bodyEl    && savedBody)    bodyEl.value    = savedBody;
    }
  } catch (e) {
    if (!preserveForm) {
      detail.innerHTML = '<div class="detail-empty" style="color:var(--red)">Failed to load thread</div>';
    }
  }
}

function renderDetail() {
  const t = currentThread;
  if (!t) return;
  const isClosed = t.status === 'closed';
  const lastTurn = turns[turns.length - 1];
  const afterTurn = lastTurn ? lastTurn.turn_number : 0;

  document.getElementById('detail').innerHTML = `
    <div class="detail-header">
      <div>
        <div class="detail-title">${escHtml(t.slug)} <span class="status-chip status-${t.status}">${t.status}</span></div>
        <div class="detail-subtitle">${t.id} · ${t.turn_count} turns${t.summary ? ' · ' + escHtml(t.summary) : ''}</div>
      </div>
      <div class="detail-actions">
        ${t.unread_count > 0 ? `<button class="btn-secondary btn-sm" onclick="markAllRead()">Mark read</button>` : ''}
        ${!isClosed ? `<button class="btn-danger btn-sm" onclick="closeThread()">Close</button>` : ''}
      </div>
    </div>
    <div class="turns" id="turns-list">
      ${turns.length === 0 ? '<div style="color:var(--text-dim);font-size:13px;text-align:center;padding:32px">No turns yet</div>' :
        turns.map(turn => `
        <div class="turn ${!turn.read_at ? 'unread' : ''} ${turn.from === 'cursor' ? 'from-cursor' : ''}">
          <div class="turn-header">
            <div style="display:flex;align-items:center;gap:8px">
              ${!turn.read_at ? '<div class="turn-unread-dot"></div>' : ''}
              <span class="turn-from ${turn.from === 'cursor' ? 'cursor' : ''}">${escHtml(turn.from || '')}</span>
              <span class="turn-arrow">→</span>
              <span class="turn-to">${escHtml(turn.to || '')}</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
              <span class="turn-number">#${turn.turn_number}</span>
              <span class="turn-ts">${fmtTime(turn.created_at)}</span>
            </div>
          </div>
          ${turn.subject ? `<div class="turn-subject">${escHtml(turn.subject)}</div>` : ''}
          <div class="turn-body">${escHtml(turn.body || '')}</div>
        </div>
      `).join('')}
    </div>
    ${!isClosed ? `
    <div class="reply-area">
      <div class="reply-form">
        <div class="form-row">
          <span class="form-label">From</span>
          <select id="reply-from" style="max-width:160px">
            ${['web','api','cursor','kaywan'].map(a =>
              `<option value="${a}" ${(lastTurn?.to||'cursor') === a ? 'selected' : ''}>${a}</option>`
            ).join('')}
          </select>
          <span class="form-label" style="width:auto;margin-left:8px">To</span>
          <select id="reply-to" style="max-width:160px">
            ${['web','api','cursor','kaywan'].map(a =>
              `<option value="${a}" ${(lastTurn?.from||'') === a ? 'selected' : ''}>${a}</option>`
            ).join('')}
          </select>
          <span class="form-label" style="width:auto;margin-left:8px">Subject</span>
          <input type="text" id="reply-subject" value="${lastTurn?.subject ? escHtml('Re: ' + lastTurn.subject) : ''}" placeholder="reply subject">
        </div>
        <textarea id="reply-body" placeholder="Write your reply…" rows="4"></textarea>
        <div class="form-actions">
          <input type="hidden" id="reply-after-turn" value="${afterTurn}">
          <button class="btn-primary" onclick="submitReply()">Send Reply</button>
        </div>
      </div>
    </div>
    ` : '<div style="padding:12px 20px;background:var(--surface);border-top:1px solid var(--border);font-size:12px;color:var(--text-dim);text-align:center">Thread is closed</div>'}
  `;

}

async function submitReply() {
  const from = document.getElementById('reply-from').value;
  const to = document.getElementById('reply-to').value;
  const subject = document.getElementById('reply-subject').value.trim();
  const body = document.getElementById('reply-body').value.trim();
  const afterTurn = parseInt(document.getElementById('reply-after-turn').value, 10);

  if (!subject || !body) { toast('subject and body are required', true); return; }

  try {
    await api('POST', '/turns', {
      thread: currentThread.id,
      from,
      to,
      subject,
      body,
      status: 'open',
      after_turn: afterTurn,
    });
    toast('Reply sent');
    await loadTurns(false, 'bottom');
    await loadThreads();
  } catch (e) {
    toast('Failed: ' + e.message, true);
  }
}

async function markAllRead() {
  try {
    await api('GET', '/turns?thread=' + currentThread.id + '&last=500&mark_read=true');
    toast('Marked all read');
    await loadTurns(false, 'preserve');
    await loadThreads();
  } catch (e) {
    toast('Failed: ' + e.message, true);
  }
}

async function closeThread() {
  const summary = prompt('Closing summary (optional):') ?? '';
  try {
    await api('PATCH', '/threads/' + currentThread.id + '/close', { summary, mark_all_read: true });
    toast('Thread closed');
    await loadThreads();
    await loadTurns(false, 'preserve');
  } catch (e) {
    toast('Failed: ' + e.message, true);
  }
}

function openNewThread() { document.getElementById('new-thread-modal').classList.add('open'); }
function closeNewThread() { document.getElementById('new-thread-modal').classList.remove('open'); }

async function submitNewThread() {
  const slug = document.getElementById('nt-slug').value.trim();
  const to = document.getElementById('nt-to').value.trim();
  const subject = document.getElementById('nt-subject').value.trim();
  const body = document.getElementById('nt-body').value.trim();

  if (!slug || !to || !subject || !body) { toast('All fields required', true); return; }

  try {
    const res = await api('POST', '/threads/with-turn', {
      slug, to, subject, body,
      from: 'cursor',
      status: 'open',
      after_turn: 0,
    });
    toast('Thread created');
    closeNewThread();
    ['nt-slug','nt-to','nt-subject','nt-body'].forEach(id => document.getElementById(id).value = '');
    await loadThreads();
    selectThread(res.thread.id);
  } catch (e) {
    toast('Failed: ' + e.message, true);
  }
}

async function refresh() {
  await loadThreads(true);
}

// Close modal on overlay click
document.getElementById('new-thread-modal').addEventListener('click', e => {
  if (e.target === e.currentTarget) closeNewThread();
});

loadThreads();
setInterval(refresh, 30000);
</script>
</body>
</html>
"""


@app.get("/", response_class=HTMLResponse)
async def ui() -> HTMLResponse:
    return HTMLResponse(_HTML)


@app.api_route(
    "/api/{path:path}",
    methods=["GET", "POST", "PATCH", "PUT", "DELETE"],
)
async def proxy(path: str, request: Request) -> Response:
    """Proxy all /api/* requests to the agent-bus UDS socket."""
    body = await request.body()
    qs = request.url.query
    target = f"http://localhost/{path}" + (f"?{qs}" if qs else "")

    transport = httpx.HTTPTransport(uds=_SOCKET)
    headers = {
        "Authorization": f"Bearer {_TOKEN}",
        "Content-Type": request.headers.get("content-type", "application/json"),
    }

    try:
        with httpx.Client(transport=transport, timeout=10.0) as client:
            resp = client.request(
                method=request.method,
                url=target,
                content=body or None,
                headers=headers,
            )
    except (httpx.ConnectError, FileNotFoundError):
        raise HTTPException(
            status_code=503,
            detail="agent-bus socket unavailable — is the service running?",
        )

    return Response(
        content=resp.content,
        status_code=resp.status_code,
        media_type=resp.headers.get("content-type", "application/json"),
    )


def main() -> None:
    global _TOKEN
    parser = argparse.ArgumentParser(description="Agent Bus UI")
    parser.add_argument("--port", type=int, default=_DEFAULT_PORT)
    parser.add_argument("--host", default="0.0.0.0")
    args = parser.parse_args()

    _TOKEN = _resolve_token()
    print(f"Agent Bus UI → http://{args.host}:{args.port}", flush=True)
    uvicorn.run(app, host=args.host, port=args.port, log_level="warning")


if __name__ == "__main__":
    main()
