#!/usr/bin/env python3
"""Download curated third-party API documentation into docs/thirdparty/.

Pages are fetched as raw markdown from their public .md URLs and written
to docs/thirdparty/{source}/ for RAG ingestion.

Usage:
  scripts/ingest-thirdparty-docs [--dry-run] [--force] [--source mcp|claude-api]
  scripts/ingest-thirdparty-docs --list
"""

from __future__ import annotations

import argparse
import sys
import time
from pathlib import Path

import httpx

REPO_ROOT = Path(__file__).resolve().parent.parent
OUTPUT_ROOT = REPO_ROOT / "docs" / "thirdparty"

# ---------------------------------------------------------------------------
# Curated page lists
# Each entry: (url, relative_output_path, description)
# ---------------------------------------------------------------------------

