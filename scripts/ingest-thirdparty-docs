ALL_SOURCES: dict[str, list[tuple[str, str, str]]] = {
    "mcp": MCP_PAGES,
    "claude-api": CLAUDE_API_PAGES,
}


def download_page(url: str, dest: Path, *, dry_run: bool, force: bool) -> bool:
    """Fetch a markdown page and write it to dest. Returns True on success."""
    if dest.exists() and not force:
        print(f"  [cached] {dest.relative_to(REPO_ROOT)}")
        return True

    if dry_run:
        print(f"  [dry-run] {url} → {dest.relative_to(REPO_ROOT)}")
        return True

    try:
        with httpx.Client(timeout=30.0, follow_redirects=True) as client:
            resp = client.get(url, headers={"Accept": "text/markdown, text/plain, */*"})
        resp.raise_for_status()
        content = resp.text
        # Sanity check: skip if response looks like an HTML error page
        if content.strip().startswith("<!DOCTYPE") or "<html" in content[:200]:
            print(f"  [warn] HTML response (not markdown), skipping: {url}")
            return False
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(content, encoding="utf-8")
        kb = len(resp.content) // 1024
        print(f"  [ok] {dest.relative_to(REPO_ROOT)} ({kb}KB)")
        return True
    except httpx.HTTPStatusError as exc:
        print(f"  [error] HTTP {exc.response.status_code}: {url}")
        return False
    except Exception as exc:  # noqa: BLE001
        print(f"  [error] {exc}: {url}")
        return False


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Download curated third-party API docs for RAG ingestion"
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="Print actions without writing files"
    )
    parser.add_argument(
        "--force", action="store_true", help="Re-download even if file exists"
    )
    parser.add_argument(
        "--source",
        choices=["mcp", "claude-api"],
        help="Only download pages for this source (default: all)",
    )
    parser.add_argument("--list", action="store_true", help="List pages and exit")
    args = parser.parse_args()

    sources = {args.source: ALL_SOURCES[args.source]} if args.source else ALL_SOURCES

    if args.list:
        total = 0
        for source, pages in sources.items():
            print(f"\n[{source}] — {len(pages)} pages")
            for url, local, description in pages:
                print(f"  {local:55s}  {description}")
            total += len(pages)
        print(f"\nTotal: {total} pages")
        return

    total = sum(len(p) for p in sources.values())
    print(f"Downloading {total} pages → {OUTPUT_ROOT.relative_to(REPO_ROOT)}")
    if args.dry_run:
        print("(dry-run — no files written)\n")

    succeeded = failed = skipped = 0
    for source, pages in sources.items():
        print(f"\n── {source} ({len(pages)} pages) ──")
        for url, local, _description in pages:
            dest = OUTPUT_ROOT / local
            already_exists = dest.exists()
            ok = download_page(url, dest, dry_run=args.dry_run, force=args.force)
            if ok:
                if already_exists and not args.force and not args.dry_run:
                    skipped += 1
                else:
                    succeeded += 1
            else:
                failed += 1
            if not args.dry_run and ok and not already_exists:
                time.sleep(0.5)

    print(f"\n{'=' * 50}")
    print(f"Done: {succeeded} downloaded, {skipped} cached, {failed} failed")
    if failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
