#!/usr/bin/env bash
# Query any Stargate model/pipeline from the command line.
# Default: rag-answer (query rewriting + RAG retrieval via rag-context, then grounded answer)
#
# Usage:
#   ask "What does research say about RRF k parameter tuning?"
#   ask -m phi-4-q4-k-m-16384 "Explain transformer attention"
#   ask -m rag-answer "How does HyDE compare to query rewriting?"
#   echo "question" | ask
#   ask -r                          # raw JSON response
#   ask -M arcee-ai/trinity-large-preview:free "question"  # cloud model via rag-answer
#   ask -o q1_gpt.txt "question"    # saves to ./tmp/ask/q1_gpt.txt by default
#   ask -d ./tmp/my-run -o out.txt "question"

set -euo pipefail

STARGATE_URL="${STARGATE_URL:-http://localhost:9999}"
MODEL="rag-answer"
RAW=false
OUT_DIR="${ASK_OUT_DIR:-./}"
OUT_FILE=""
SCOPE=""
SOURCE_PREFIXES=()
ANSWER_MODEL=""

usage() {
	cat <<'EOF'
Usage: ask [-m MODEL] [-M ANSWER_MODEL] [-u URL] [-r] [-s SCOPE] [-p PREFIX] [-d OUT_DIR] [-o OUT_FILE] [QUESTION]

  -m MODEL         Model or pipeline ID (default: rag-answer)
  -M ANSWER_MODEL  Override the answer model via pipeline_options.model
                   (e.g. arcee-ai/trinity-large-preview:free)
  -u URL           Stargate URL (default: http://localhost:9999)
  -r               Print raw JSON response
  -s SCOPE         scope_override: research|project|both
  -p PREFIX        RAG source prefix path (repeatable)
  -d OUT_DIR       Output directory for relative -o paths (default: $ASK_OUT_DIR or ./)
  -o OUT_FILE      Save output to file. If relative, saved under OUT_DIR.
  -h               Show this help

Question can be passed as argument or piped via stdin.
EOF
	exit 0
}

while getopts "m:M:u:rs:p:o:d:h" opt; do
	case "$opt" in
	m) MODEL="$OPTARG" ;;
	M) ANSWER_MODEL="$OPTARG" ;;
	u) STARGATE_URL="$OPTARG" ;;
	r) RAW=true ;;
	s) SCOPE="$OPTARG" ;;
	p) SOURCE_PREFIXES+=("$OPTARG") ;;
	o) OUT_FILE="$OPTARG" ;;
	d) OUT_DIR="$OPTARG" ;;
	h) usage ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))

if [ $# -gt 0 ]; then
	QUESTION="$*"
elif [ ! -t 0 ]; then
	QUESTION="$(cat)"
else
	echo "Error: no question provided" >&2
	usage
fi

# Build pipeline_options only if any tuning flags were set
PIPELINE_OPTS=""
if [ -n "$SCOPE" ] || [ ${#SOURCE_PREFIXES[@]} -gt 0 ] || [ -n "$ANSWER_MODEL" ]; then
	PIPELINE_OPTS=$(jq -nc \
		--arg scope "$SCOPE" \
		--arg answer_model "$ANSWER_MODEL" \
		--argjson prefixes "$(printf '%s\n' "${SOURCE_PREFIXES[@]}" | jq -R . | jq -sc .)" \
		'{} +
         (if $scope != "" then {scope_override: $scope} else {} end) +
         (if ($prefixes | length) > 0 then {rag_source_prefixes: $prefixes} else {} end) +
         (if $answer_model != "" then {model: $answer_model} else {} end)')
fi

if [ -n "$PIPELINE_OPTS" ]; then
	BODY=$(jq -nc --arg model "$MODEL" --arg q "$QUESTION" \
		--argjson opts "$PIPELINE_OPTS" '{
        model: $model,
        messages: [{role: "user", content: $q}],
        stream: false,
        pipeline_options: $opts
    }')
else
	BODY=$(jq -nc --arg model "$MODEL" --arg q "$QUESTION" '{
        model: $model,
        messages: [{role: "user", content: $q}],
        stream: false
    }')
fi

RESPONSE=$(curl -sf --max-time 180 \
	"${STARGATE_URL}/v1/chat/completions?disable_profile=true" \
	-H 'Content-Type: application/json' \
	-d "$BODY") || {
	echo "Error: request failed (is Stargate running on ${STARGATE_URL}?)" >&2
	exit 1
}

if [ "$RAW" = true ]; then
	OUTPUT="$(echo "$RESPONSE" | jq .)"
else
	OUTPUT="$(echo "$RESPONSE" | jq -r '.choices[0].message.content // "No response content"')"
fi

printf '%s\n' "$OUTPUT"

if [ -n "$OUT_FILE" ]; then
	if [[ "$OUT_FILE" = /* ]]; then
		TARGET="$OUT_FILE"
		mkdir -p "$(dirname "$TARGET")"
	else
		mkdir -p "$OUT_DIR"
		TARGET="$OUT_DIR/$OUT_FILE"
	fi
	printf '%s\n' "$OUTPUT" >"$TARGET"
	echo "Saved: $TARGET" >&2
fi
