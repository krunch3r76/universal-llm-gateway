#!/usr/bin/env python3
"""Regenerate MCP-predicated vs capability-clean classification table.

Single SOT: ``tasks/specs/stage2-skill-mcp-classification-disposition.md``.
Projects the disposition pipe-table into ``libs/implement_admission/skill_mcp_classification.py``.

Usage:
  scripts/gen-skill-mcp-classification            # rewrite module in place
  scripts/gen-skill-mcp-classification --check    # exit non-zero on drift (CI gate)
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from dataclasses import dataclass
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_REPO_ROOT / "libs"))

from implement_admission.skill_source_table import canonical_table_key  # noqa: E402

_DISPOSITION = (
    _REPO_ROOT / "tasks" / "specs" / "stage2-skill-mcp-classification-disposition.md"
)
_OUTPUT = _REPO_ROOT / "libs" / "implement_admission" / "skill_mcp_classification.py"

_TABLE_HEADER = re.compile(
    r"^\|\s*slug\s*\|\s*verdict\s*\|\s*rule\s*\|\s*basis\s*\|\s*note\s*\|\s*$"
)
_TABLE_ROW = re.compile(
    r"^\|\s*(?P<slug>[^|]+?)\s*\|\s*(?P<verdict>[^|]+?)\s*\|\s*(?P<rule>[^|]+?)\s*\|\s*(?P<basis>[^|]+?)\s*\|\s*(?P<note>[^|]*?)\s*\|\s*$"
)
_VALID_VERDICTS = frozenset({"mcp_predicated", "capability_clean", "orphan"})


@dataclass(frozen=True, slots=True)
class DispositionRow:
    slug: str
    verdict: str
    rule: str
    basis: str
    note: str


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    return f"sha256:{digest}"


def _parse_disposition(text: str) -> list[DispositionRow]:
    rows: list[DispositionRow] = []
    in_table = False
    for line in text.splitlines():
        if _TABLE_HEADER.match(line):
            in_table = True
            continue
        if not in_table:
            continue
        if not line.startswith("|"):
            break
        if re.match(r"^\|\s*[-:]+\s*\|", line):
            continue
        match = _TABLE_ROW.match(line)
        if not match:
            raise ValueError(f"malformed disposition row: {line!r}")
        rows.append(
            DispositionRow(
                slug=match.group("slug").strip(),
                verdict=match.group("verdict").strip(),
                rule=match.group("rule").strip(),
                basis=match.group("basis").strip(),
                note=match.group("note").strip(),
            )
        )
    if not rows:
        raise ValueError("disposition table not found or empty")
    return rows


def _build_classification(
    rows: list[DispositionRow],
) -> tuple[dict[str, bool], dict[str, str]]:
    """Return (predicated map, slug→rule for non-orphan rows)."""
    predicated: dict[str, bool] = {}
    slug_rules: dict[str, str] = {}
    for row in rows:
        if row.verdict not in _VALID_VERDICTS:
            raise ValueError(
                f"unknown verdict {row.verdict!r} for slug {row.slug!r}"
            )
        if row.verdict == "orphan":
            continue
        key = canonical_table_key(row.slug)
        value = row.verdict == "mcp_predicated"
        if key in predicated and predicated[key] != value:
            raise ValueError(
                f"alias collision on {key!r}: {predicated[key]!r} vs {value!r} "
                f"(slugs {row.slug!r} and prior)"
            )
        predicated[key] = value
        slug_rules[row.slug] = row.rule
    return predicated, slug_rules


def _classification_digest(predicated: dict[str, bool]) -> str:
    payload = json.dumps(predicated, sort_keys=True, separators=(",", ":")).encode()
    return "sha256:" + hashlib.sha256(payload).hexdigest()


def _render_module(
    predicated: dict[str, bool],
    *,
    disposition_sha256: str,
    classification_digest: str,
) -> str:
    lines = [
        '"""Build-time generated skill MCP-predicated classification (S2.a / F2).',
        "",
        "Hot paths read this table only — never infer from body grep at dispatch.",
        '"""',
        "",
        "from __future__ import annotations",
        "",
        "import json",
        "from typing import Final",
        "",
        "from implement_admission.skill_source_table import canonical_table_key",
        "",
        'TEMPLATE_VERSION: Final[str] = "1"',
        "",
        "SKILL_MCP_PREDICATED: Final[dict[str, bool]] = {",
    ]
    for key in sorted(predicated):
        lines.append(f'    "{key}": {predicated[key]!r},')
    lines.extend(
        [
            "}",
            "",
            f"CLASSIFICATION_DIGEST: Final[str] = {classification_digest!r}",
            "",
            f"DISPOSITION_SOURCE_SHA256: Final[str] = {disposition_sha256!r}",
            "",
            "",
            "class SkillClassificationMissingError(LookupError):",
            '    """Canonical slug absent from the committed classification table."""',
            "",
            "",
            "def skill_mcp_predicated(slug_or_entity_id: str) -> bool:",
            '    """Return whether the skill is MCP-predicated (fail-loud on missing row)."""',
            "    key = canonical_table_key(slug_or_entity_id)",
            "    try:",
            "        return SKILL_MCP_PREDICATED[key]",
            "    except KeyError as exc:",
            "        raise SkillClassificationMissingError(",
            "            f\"canonical slug {key!r} absent from skill MCP classification \"",
            '            f"(template_version={TEMPLATE_VERSION})"',
            "        ) from exc",
            "",
            "",
            "def classification_bytes_for_digest() -> bytes:",
            '    """Stable serialization for determinism / drift probes."""',
            "    return json.dumps(",
            "        SKILL_MCP_PREDICATED, sort_keys=True, separators=(\",\", \":\")",
            "    ).encode()",
            "",
        ]
    )
    return "\n".join(lines) + "\n"


def generate() -> str:
    if not _DISPOSITION.exists():
        raise FileNotFoundError(_DISPOSITION)
    disposition_text = _DISPOSITION.read_text(encoding="utf-8")
    rows = _parse_disposition(disposition_text)
    predicated, _ = _build_classification(rows)
    disposition_sha256 = _sha256_file(_DISPOSITION)
    classification_digest = _classification_digest(predicated)
    return _render_module(
        predicated,
        disposition_sha256=disposition_sha256,
        classification_digest=classification_digest,
    )


def main(check: bool) -> int:
    rendered = generate()
    if not _OUTPUT.exists():
        if check:
            print(f"DRIFT {_OUTPUT.relative_to(_REPO_ROOT)} — module missing", file=sys.stderr)
            return 1
        _OUTPUT.write_text(rendered, encoding="utf-8")
        print(f"WROTE {_OUTPUT.relative_to(_REPO_ROOT)}")
        print("\nOK gen-skill-mcp-classification: classification table generated")
        return 0

    committed = _OUTPUT.read_text(encoding="utf-8")
    if committed == rendered:
        print(f"OK   {_OUTPUT.relative_to(_REPO_ROOT)} — up to date")
        print("\nOK gen-skill-mcp-classification: classification table consistent")
        return 0

    if check:
        print(
            f"DRIFT {_OUTPUT.relative_to(_REPO_ROOT)} — "
            "run scripts/gen-skill-mcp-classification to regenerate.",
            file=sys.stderr,
        )
        return 1

    _OUTPUT.write_text(rendered, encoding="utf-8")
    print(f"WROTE {_OUTPUT.relative_to(_REPO_ROOT)} — classification table regenerated")
    print("\nOK gen-skill-mcp-classification: classification table regenerated")
    return 0


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Exit non-zero on drift without rewriting (CI gate mode)",
    )
    sys.exit(main(parser.parse_args().check))
