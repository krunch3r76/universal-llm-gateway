#!/bin/sh
# Start cdp-ask for systemd Type=forking (sources manage-written env file).
set -eu

ENV_FILE="${HOME}/.gateway/cdp-ask.env"
if [ ! -f "$ENV_FILE" ]; then
  echo "missing $ENV_FILE" >&2
  exit 1
fi
# shellcheck disable=SC1090
. "$ENV_FILE"

REPO="${ULG_REPO:?ULG_REPO required in cdp-ask.env}"
PORT="${PORT:-8770}"
PIDFILE="${HOME}/.gateway/cdp-ask.pid"

# systemd user units set INVOCATION_ID on ExecStart. Type=forking refuses a
# MainPID that was not born in this service cgroup ("PID does not belong to
# service … Refusing"), so adopt-in-place is illegal under systemd.
_under_systemd() {
  [ -n "${INVOCATION_ID:-}" ]
}

_listening_pid() {
  ss -tlnp "sport = :${PORT}" 2>/dev/null \
    | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' \
    | head -1
}

# True when /health JSON has a non-empty standing_pins object (at least one key).
_standing_pins_populated() {
  body="$1"
  printf '%s' "$body" \
    | grep -q '"standing_pins"[[:space:]]*:[[:space:]]*{[[:space:]]*"'
}

_pid_has_ulg_repo() {
  pid="$1"
  [ -r "/proc/${pid}/environ" ] || return 1
  tr '\0' '\n' < "/proc/${pid}/environ" | grep -q '^ULG_REPO=.'
}

# Echo adoptable listener pid on stdout, or return 1.
# Adoption requires HTTP /health + non-empty standing_pins + ULG_REPO in environ.
# Empty pins is the ULG_REPO-less orphan signature (pass-6 residual).
_adoptable_listener_pid() {
  body="$(curl -sf "http://127.0.0.1:${PORT}/health" 2>/dev/null)" || return 1
  _standing_pins_populated "$body" || return 1
  live_pid="$(_listening_pid)"
  [ -n "$live_pid" ] || return 1
  _pid_has_ulg_repo "$live_pid" || return 1
  printf '%s\n' "$live_pid"
  return 0
}

_refresh_pidfile_if_healthy() {
  live_pid="$(_adoptable_listener_pid)" || return 1
  echo "$live_pid" > "$PIDFILE"
  return 0
}

# Unconditionally clear :PORT so a cgroup-born spawn can bind (systemd path).
_kill_port_listener() {
  live_pid="$(_listening_pid)"
  [ -n "$live_pid" ] || return 0
  echo "cdp-ask-start: clearing pid=${live_pid} on :${PORT} before cgroup spawn" >&2
  kill "$live_pid" 2>/dev/null || true
  i=0
  while [ "$i" -lt 30 ]; do
    [ -z "$(_listening_pid)" ] && break
    sleep 0.1
    i=$((i + 1))
  done
  leftover="$(_listening_pid)"
  if [ -n "$leftover" ]; then
    kill -9 "$leftover" 2>/dev/null || true
    sleep 0.1
  fi
  rm -f "$PIDFILE"
}

# Kill a :PORT listener that answers but is not adoptable so a fresh start can bind.
# Returns 0 when port is clear (or nothing listened). Returns 1 if listener became
# adoptable mid-check (pidfile already refreshed — caller should exit 0).
# Manage/SSH path only — never used under systemd (see _under_systemd).
_kill_unadoptable_listener() {
  live_pid="$(_listening_pid)"
  [ -n "$live_pid" ] || return 0
  if adoptable_pid="$(_adoptable_listener_pid)"; then
    echo "$adoptable_pid" > "$PIDFILE"
    return 1
  fi
  echo "cdp-ask-start: refusing adopt of pid=${live_pid} (empty standing_pins or missing ULG_REPO); killing for fresh start" >&2
  kill "$live_pid" 2>/dev/null || true
  i=0
  while [ "$i" -lt 30 ]; do
    [ -z "$(_listening_pid)" ] && break
    sleep 0.1
    i=$((i + 1))
  done
  leftover="$(_listening_pid)"
  if [ -n "$leftover" ]; then
    kill -9 "$leftover" 2>/dev/null || true
    sleep 0.1
  fi
  rm -f "$PIDFILE"
  return 0
}

if ! _under_systemd; then
  # Direct manage/SSH invoke may adopt a healthy listener it already owns.
  if _refresh_pidfile_if_healthy; then
    exit 0
  fi

  if [ -f "$PIDFILE" ]; then
    old_pid="$(cat "$PIDFILE")"
    if kill -0 "$old_pid" 2>/dev/null \
      && curl -sf "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
      if _refresh_pidfile_if_healthy; then
        exit 0
      fi
    fi
  fi

  # Listener may still hold :PORT after a refused adopt — clear it before spawn.
  if ! _kill_unadoptable_listener; then
    exit 0
  fi
else
  # systemd Type=forking: MainPID must be born under this ExecStart cgroup.
  _kill_port_listener
fi

mkdir -p /tmp/logs/cdp-ask "${HOME}/.gateway"

setsid env \
  CORTEX_FILES_ROOT="${CORTEX_FILES_ROOT:?}" \
  EVENTS_INGEST_TCP="${EVENTS_INGEST_TCP:?}" \
  ULG_CODE_VERSION="${ULG_CODE_VERSION:-}" \
  ULG_REPO="$REPO" \
  "$HOME/.venvs/universal/bin/python" "$REPO/scripts/cdp-ask" --port "$PORT" \
  </dev/null >/tmp/logs/cdp-ask/start.log 2>&1 &

echo $! > "$PIDFILE"
