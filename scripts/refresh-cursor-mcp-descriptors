#!/usr/bin/env bash
# Refresh MCP tool descriptors for all Cursor workspace projects.
#
# Fetches the live tool list from the MCP server and writes per-tool JSON
# descriptor files to every Cursor project's mcps/ directory that has a
# user-vortex server registered. Also writes to the ULG vortex directory.
#
# Run after:
#   - New tools are added to the MCP server
#   - Tool descriptions or schemas are changed
#   - The MCP server is rebuilt/redeployed
#   - A new Cursor workspace project directory is used
#
# Usage:
#   ./scripts/refresh-cursor-mcp-descriptors
#
# After running, reload each Cursor window (Ctrl+Shift+P → Developer: Reload Window)
# for the agent to pick up changes.

set -euo pipefail

MCP_URL="${MCP_URL:-https://mcp.k-1.me/mcp}"
MCP_YAML="${MCP_YAML:-$HOME/.gateway/mcp.yaml}"
CURSOR_PROJECTS="$HOME/.cursor/projects"

if [ -z "${MCP_TOKEN:-}" ] && [ -f "${MCP_YAML}" ]; then
  MCP_TOKEN=$(python3 - "${MCP_YAML}" <<'PY'
from pathlib import Path
import os
import sys

path = Path(sys.argv[1]).expanduser()
auth_token = ""
auth_token_env = ""
for raw_line in path.read_text(encoding="utf-8").splitlines():
    line = raw_line.strip()
    if not line or line.startswith("#"):
        continue
    if not line.startswith("auth_token:") and not line.startswith("auth_token_env:"):
        continue
    key, value = line.split(":", 1)
    value = value.split("#", 1)[0].strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        value = value[1:-1]
    if key.strip() == "auth_token":
        auth_token = value.strip()
    elif key.strip() == "auth_token_env":
        auth_token_env = value.strip()

if auth_token_env:
    env_val = os.environ.get(auth_token_env, "").strip()
    if env_val:
        print(env_val)
        raise SystemExit(0)
if auth_token:
    print(auth_token)
PY
  )
fi

if [ -z "${MCP_TOKEN:-}" ]; then
  echo "ERROR: MCP token not configured." >&2
  echo "  Set MCP_TOKEN env var, or set auth_token_env/auth_token in ${MCP_YAML}" >&2
  exit 1
fi

echo "Fetching tool list from ${MCP_URL}..."

RESPONSE=$(curl -sf -X POST "${MCP_URL}" \
  -H "Authorization: Bearer ${MCP_TOKEN}" \
  -H "Content-Type: application/json" \
  -H "Accept: application/json, text/event-stream" \
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}' \
  | grep "^data:" | sed 's/^data: //')

if [ -z "${RESPONSE}" ]; then
  echo "ERROR: No response from MCP server. Is it running?" >&2
  echo "  Check: docker ps | grep mcp-server" >&2
  echo "  Check: curl -sk https://mcp.k-1.me/health" >&2
  exit 1
fi

write_descriptors() {
  local tools_dir="$1"
  local server_id="$2"
  local metadata_path
  metadata_path="$(dirname "$tools_dir")/SERVER_METADATA.json"

  mkdir -p "$tools_dir"
  printf '{\n  "serverIdentifier": "%s",\n  "serverName": "vortex"\n}\n' "$server_id" > "$metadata_path"

  echo "${RESPONSE}" | python3 -c "
import sys, json, os

data = json.load(sys.stdin)
tools = data['result']['tools']
base = sys.argv[1]

current_names = {t['name'] for t in tools}
for f in os.listdir(base):
    if f.endswith('.json'):
        name = f[:-5]
        if name not in current_names:
            os.remove(os.path.join(base, f))
            print(f'  removed stale: {name}', file=sys.stderr)

for tool in tools:
    fname = os.path.join(base, tool['name'] + '.json')
    descriptor = {
        'name': tool['name'],
        'description': tool['description'],
        'inputSchema': tool['inputSchema'],
    }
    with open(fname, 'w') as f:
        json.dump(descriptor, f, indent=2)

print(len(tools))
" "$tools_dir"
}

TOTAL_TARGETS=0

# ULG primary: vortex (written by this script historically)
ULG_VORTEX="${CURSOR_PROJECTS}/mnt-torus-projects-universal-llm-gateway/mcps/vortex/tools"
if [ -d "$(dirname "$(dirname "$ULG_VORTEX")")" ]; then
  COUNT=$(write_descriptors "$ULG_VORTEX" "vortex")
  echo "  ULG vortex: ${COUNT} tools"
  TOTAL_TARGETS=$((TOTAL_TARGETS + 1))
fi

# All workspaces: user-vortex (Cursor's auto-registered name for user-level servers)
for project_dir in "${CURSOR_PROJECTS}"/*/mcps/user-vortex; do
  [ -d "$project_dir" ] || continue
  tools_dir="${project_dir}/tools"
  ws_name="$(basename "$(dirname "$(dirname "$project_dir")")")"
  COUNT=$(write_descriptors "$tools_dir" "user-vortex")
  echo "  ${ws_name}: ${COUNT} tools"
  TOTAL_TARGETS=$((TOTAL_TARGETS + 1))
done

echo ""
echo "Updated ${TOTAL_TARGETS} workspace(s)"
echo ""
echo "Next step: reload each Cursor window (Ctrl+Shift+P → Developer: Reload Window)"
echo "Agents will pick up the new descriptors on next session start."
