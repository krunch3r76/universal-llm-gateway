#!/usr/bin/env python3
"""Report timeout-prone models from Stargate event logs for agent workflows.

This helper summarizes timeout-related events and groups them by model ID so
agents can quickly identify unstable reviewers before retrying consultation.
"""

from __future__ import annotations

import argparse
import json
import re
from collections import Counter
from dataclasses import dataclass
from pathlib import Path
from typing import cast

DEFAULT_EVENTS_PATH = Path("/tmp/stargate-events/current.jsonl")
MODEL_FROM_ERROR_RE = re.compile(r"\bmodel\s+([A-Za-z0-9_./:-]+)")


@dataclass
class TimeoutRecord:
    """Timeout observation keyed by model and originating pipeline signal."""

    model_id: str
    signal: str
    pipeline_id: str | None
    error: str


@dataclass
class _Args(argparse.Namespace):
    """Typed argparse namespace with concrete defaults for helper flags."""

    events: str = str(DEFAULT_EVENTS_PATH)
    pipeline: str | None = None
    tail: int = 5000
    json: bool = False


def _parse_event_line(line: str) -> dict[str, object] | None:
    """Parse one JSONL line, returning None for malformed content."""
    text = line.strip()
    if not text:
        return None
    try:
        raw = cast(object, json.loads(text))
    except json.JSONDecodeError:
        return None
    if not isinstance(raw, dict):
        return None
    return {str(key): value for key, value in cast(dict[object, object], raw).items()}


def _extract_model_id(payload: dict[str, object], signal: str) -> str:
    """Extract a model identifier from payload fields or timeout error text."""
    model = payload.get("model_id")
    if isinstance(model, str) and model:
        return model
    error = str(payload.get("error", ""))
    match = MODEL_FROM_ERROR_RE.search(error)
    if match:
        return match.group(1)
    if signal == "pipeline.step.model.fallback.suppressed":
        return "(model-missing-on-fallback-event)"
    return "(unknown)"


def _is_timeout_event(signal: str, payload: dict[str, object]) -> bool:
    """Return True when signal/payload indicates timeout behavior."""
    text = " ".join(
        [
            signal,
            str(payload.get("error", "")),
            str(payload.get("primary_error_type", "")),
            str(payload.get("error_type", "")),
            str(payload.get("outcome", "")),
            str(payload.get("msg_type", "")),
        ]
    ).lower()
    return "timeout" in text or "timed out" in text


def _load_timeout_records(
    event_path: Path, pipeline_filter: str | None, tail_lines: int | None
) -> list[TimeoutRecord]:
    """Load timeout records from a Stargate JSONL event file."""
    if not event_path.exists():
        raise FileNotFoundError(f"Event file not found: {event_path}")
    lines = event_path.read_text(errors="replace").splitlines()
    if tail_lines is not None and tail_lines > 0:
        lines = lines[-tail_lines:]

    records: list[TimeoutRecord] = []
    for line in lines:
        event = _parse_event_line(line)
        if not event:
            continue
        signal_obj = event.get("signal", "")
        signal = signal_obj if isinstance(signal_obj, str) else str(signal_obj)
        payload_obj = event.get("payload", {})
        if not isinstance(payload_obj, dict):
            continue
        payload = {
            str(key): value
            for key, value in cast(dict[object, object], payload_obj).items()
        }
        pipeline_id_obj = payload.get("pipeline_id")
        pipeline_id = pipeline_id_obj if isinstance(pipeline_id_obj, str) else None
        if pipeline_filter and pipeline_id != pipeline_filter:
            continue
        if not _is_timeout_event(signal, payload):
            continue
        records.append(
            TimeoutRecord(
                model_id=_extract_model_id(payload, signal),
                signal=signal,
                pipeline_id=pipeline_id,
                error=str(payload.get("error", "")),
            )
        )
    return records


def _print_text_report(
    records: list[TimeoutRecord], pipeline_filter: str | None
) -> None:
    """Print a human-readable timeout model summary with representative examples."""
    if pipeline_filter:
        print(f"Timeout model summary (pipeline={pipeline_filter})")
    else:
        print("Timeout model summary (all pipelines)")
    if not records:
        print("- no timeout events found")
        return

    counts = Counter(r.model_id for r in records)
    first_example: dict[str, TimeoutRecord] = {}
    for r in records:
        _ = first_example.setdefault(r.model_id, r)
    for model_id, count in counts.most_common():
        example = first_example[model_id]
        pipeline_note = (
            f", pipeline={example.pipeline_id}" if example.pipeline_id else ""
        )
        print(f"- {model_id}: {count} event(s), signal={example.signal}{pipeline_note}")
        if example.error:
            print(f"  sample_error: {example.error}")


def main() -> None:
    """Parse CLI flags and emit timeout model summaries for operators and agents."""
    parser = argparse.ArgumentParser(
        description="Summarize timeout-prone models from Stargate event logs."
    )
    _ = parser.add_argument(
        "--events",
        default=str(DEFAULT_EVENTS_PATH),
        help=f"Path to Stargate JSONL events (default: {DEFAULT_EVENTS_PATH})",
    )
    _ = parser.add_argument(
        "--pipeline",
        default=None,
        help="Optional pipeline_id filter (for example: code-review)",
    )
    _ = parser.add_argument(
        "--tail",
        type=int,
        default=5000,
        help="Scan only the last N lines (default: 5000, 0 = full file)",
    )
    _ = parser.add_argument(
        "--json",
        action="store_true",
        help="Output machine-readable JSON instead of text",
    )
    args = parser.parse_args(namespace=_Args())

    events_path = Path(args.events)
    pipeline_filter = args.pipeline
    tail_value = args.tail
    emit_json = args.json
    tail_lines = None if tail_value == 0 else tail_value
    records = _load_timeout_records(
        event_path=events_path,
        pipeline_filter=pipeline_filter,
        tail_lines=tail_lines,
    )
    if emit_json:
        print(
            json.dumps(
                [
                    {
                        "model_id": r.model_id,
                        "signal": r.signal,
                        "pipeline_id": r.pipeline_id,
                        "error": r.error,
                    }
                    for r in records
                ],
                indent=2,
            )
        )
        return
    _print_text_report(records, pipeline_filter)


if __name__ == "__main__":
    main()
