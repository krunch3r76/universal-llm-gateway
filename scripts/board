#!/usr/bin/env bash
# One-shot restore / focus for the dispatch board (tmux session 0).
#
#   board          # create, respawn if dead, or select if live
#   Ctrl-b B       # same, when bound (see end of this script's comments)
#
set -euo pipefail
# Resolve through ~/.local/bin/board symlink so ROOT is the repo, not ~/.local.
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
SESSION="${BOARD_TMUX_SESSION:-0}"
NAME=dispatch-board
LAUNCH="$ROOT/scripts/tmux-dispatch-board"

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "no tmux session '$SESSION'" >&2
  exit 1
fi

if tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$NAME"; then
  target="$SESSION:$NAME"
  dead="$(tmux display-message -t "$target" -p '#{pane_dead}' 2>/dev/null || echo 1)"
  if [[ "$dead" == "1" ]]; then
    tmux set-option -t "$target" remain-on-exit on
    tmux respawn-pane -t "$target" -k "$LAUNCH"
  fi
  tmux select-window -t "$target"
else
  tmux new-window -t "$SESSION:" -n "$NAME" "$LAUNCH"
  tmux set-option -t "$SESSION:$NAME" remain-on-exit on
  target="$SESSION:$NAME"
  tmux select-window -t "$target"
fi
tmux set-option -w -t "$target" pane-border-status top
tmux set-option -w -t "$target" pane-border-format ' #{pane_title} '
tmux set-option -w -t "$target" @dispatch_board_section SDK
tmux set-option -w -t "$target" status-right ' #{pane_title} · #{@dispatch_board_section} '
