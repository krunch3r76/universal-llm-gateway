#!/usr/bin/env python3
"""Agent Bus CLI — fetch, reply, list threads over UDS.

Bypasses the MCP stdio proxy entirely, talking directly to the agent-bus
service over its Unix domain socket.  Designed for use by Cursor agents
(via Shell tool) to avoid extension-host freezes on large payloads.

Usage:
  agent-bus fetch-unread --to cursor --mark-read
  agent-bus fetch-unread --thread 049 --mark-read
  agent-bus fetch --to cursor --last 1 --unread --mark-read
  agent-bus fetch --thread 049 --unread --context 3 --mark-read
  agent-bus fetch --thread 049 --last 5
  agent-bus post --slug "my-topic" --to web --subject "Title" --body-file /tmp/body.md
  agent-bus post --slug "my-topic" --to web --subject "Title" --body-file /tmp/body.md --allow-long-body
  agent-bus post --slug "my-topic" --to web --subject "Title" --body "text" --attach /tmp/file.json
  agent-bus reply --thread 049 --to web --subject "done" --body "Phase 1 shipped" --after-turn 3
  agent-bus reply --thread 049 --to web --subject "CHECKPOINT v2" --body-file /tmp/cp.md --after-turn 153 --supersedes-turn 153
  agent-bus reply --thread 049 --to web --subject "done" --body-file /tmp/reply.md --after-turn 3 --allow-long-body
  agent-bus reply --thread 049 --to web --subject "done" --body-file /tmp/reply.md --after-turn 3 --attach /tmp/results.csv
  agent-bus threads
  agent-bus threads --status closed
  agent-bus update-thread --thread 049 --status closed --summary "Entity resolution shipped"
  agent-bus delete-thread --thread 054
  agent-bus delete-thread --thread 054 --force
  agent-bus delete-turn --thread 053 --turn 14
  agent-bus delete-turn --thread 053 --turn 14 --force
  agent-bus mark-closed-read   # mark every turn read in all closed threads (incl. superseded)
"""

from __future__ import annotations

import argparse
import hashlib
import json
import mimetypes
import os
import sys
from pathlib import Path
from typing import Any
from urllib.parse import urlencode

_SOCKET = os.environ.get("AGENT_BUS_SOCK", "/tmp/universal-protocol/agent-bus.sock")
_MCP_YAML = Path.home() / ".gateway" / "mcp.yaml"


def _resolve_token() -> str:
    """Read AGENT_BUS_TOKEN from ~/.gateway/mcp.yaml."""
    try:
        import yaml

        with open(_MCP_YAML) as f:
            cfg = yaml.safe_load(f)
        token = cfg.get("AGENT_BUS_TOKEN", "")
        if not token:
            print("AGENT_BUS_TOKEN not found in ~/.gateway/mcp.yaml", file=sys.stderr)
            sys.exit(1)
        return token
    except Exception as e:
        print(f"Failed to read token from {_MCP_YAML}: {e}", file=sys.stderr)
        sys.exit(1)


def _request(
    method: str,
    path: str,
    token: str,
    body: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """HTTP request to agent-bus over UDS."""
    import httpx

    transport = httpx.HTTPTransport(uds=_SOCKET)
    headers = {"Authorization": f"Bearer {token}"}
    with httpx.Client(transport=transport, timeout=10.0) as client:
        resp = client.request(
            method, f"http://localhost{path}", json=body, headers=headers
        )
        resp.raise_for_status()
        return resp.json()


def _thread_unread_count(thread: str, token: str, to: str | None = None) -> int:
    """Count unread turns in a thread, optionally scoped to a recipient inbox.

    No `last` cap (F7): a thread with >200 unread previously under-sized the
    fetch window and silently dropped unread turns. The server returns every
    matching unread row when `last` is omitted.
    """
    params: dict[str, Any] = {"thread": thread, "unread": "true", "compact": "true"}
    if to:
        params["to"] = to
    peek = _request("GET", f"/turns?{urlencode(params)}", token)
    return len(peek.get("turns", []))


def _thread_identity(thread: str, token: str) -> dict[str, str]:
    """Canonical id + slug from GET /threads/{id} (IDE tab titles, citations)."""
    detail = _request("GET", f"/threads/{thread}", token)
    thread_id = detail.get("id")
    slug = detail.get("slug")
    if thread_id is None or not isinstance(slug, str) or not slug:
        raise KeyError(f"GET /threads/{thread} missing id or slug: {detail!r}")
    return {"id": str(thread_id), "slug": slug}


def _has_earlier_turns(turns: list[dict[str, Any]], window: int) -> bool:
    """True iff the thread has turns older than the fetched window.

    A pure length>=window probe gives a false positive at the exact-N boundary
    (F6): a thread with exactly `window` turns reports earlier turns that don't
    exist. Turns are ordered DESC, so the oldest fetched is turns[-1]; if its
    turn_number is 1 it is the genuine first turn and nothing precedes it.
    """
    if len(turns) < window or not turns:
        return False
    return turns[-1].get("turn_number") != 1


def _cmd_fetch(args: argparse.Namespace, token: str) -> None:
    context = getattr(args, "context", 0)
    indent = None if getattr(args, "compact", False) else 2

    if context > 0 and args.thread:
        # Phase 1: count unread turns to size the fetch window.
        # TOCTOU note (F9): a turn arriving between this peek and the phase-2
        # fetch below can skew fetch_last / has_earlier by one. Advisory only —
        # the next fetch self-corrects.
        unread_count = _thread_unread_count(args.thread, token, to=getattr(args, "to", None))

        # Phase 2: fetch (context + unread + 1) turns — the +1 is a probe that
        # lets us detect whether earlier turns exist without a separate count query.
        # ¬mark_read here: marking before trim would acknowledge the probe (and the
        # newest turn, pre-fix) without ever displaying it (F1/F3). Mark-read is
        # applied below, scoped to the surviving displayed turns.
        fetch_last = context + max(unread_count, 1) + 1
        fetch_params: dict[str, Any] = {"thread": args.thread, "last": fetch_last}
        if getattr(args, "compact", False):
            fetch_params["compact"] = "true"

        result = _request("GET", f"/turns?{urlencode(fetch_params)}", token)
        turns = result.get("turns", [])

        # Server orders turn_number DESC, so turns[-1] is the OLDEST turn (the probe)
        # and turns[0] is the newest. Drop the oldest probe, never the newest (F1).
        # _has_earlier_turns also guards the exact-N boundary (F6): when the oldest
        # fetched turn is turn_number 1 it is a real turn, not a probe — keep it.
        has_earlier = _has_earlier_turns(turns, fetch_last)
        if has_earlier:
            turns = turns[:-1]  # drop oldest probe, keep context + unread window

        if args.mark_read:
            for t in turns:
                if t.get("read_at") is None:
                    read_resp = _request("PATCH", f"/turns/{t['id']}/read", token)
                    t["read_at"] = read_resp.get("read_at")

        thread_info: dict[str, Any] = {
            **_thread_identity(args.thread, token),
            "turns_in_response": len(turns),
            "unread_count": unread_count,
            "has_earlier_turns": has_earlier,
        }
        if has_earlier:
            thread_info["notice"] = (
                f"This thread has turns before those shown. "
                f"Use --last {fetch_last + 20} --thread {args.thread} to fetch more context."
            )

        output = dict(result)
        output["turns"] = turns
        output["_thread_info"] = thread_info
        print(json.dumps(output, indent=indent, default=str))
        return

    # Standard path — always attach _thread_info when fetching a specific thread
    # so the agent knows whether it has the full picture.
    params: dict[str, Any] = {"last": args.last}
    if args.thread:
        params["thread"] = args.thread
    if args.to:
        params["to"] = args.to
    # --unread is independent of --to: the server filters on read_at regardless
    # of the inbox filter, so forward it whenever requested (F2).
    if args.unread:
        params["unread"] = "true"
    if getattr(args, "compact", False):
        params["compact"] = "true"
    if args.mark_read:
        params["mark_read"] = "true"
    result = _request("GET", f"/turns?{urlencode(params)}", token)

    if args.thread:
        turns = result.get("turns", [])
        has_earlier = _has_earlier_turns(turns, args.last)
        thread_info = {
            **_thread_identity(args.thread, token),
            "turns_in_response": len(turns),
            # Emit unread_count on this path too so _thread_info has a stable
            # shape across both fetch paths (F8).
            "unread_count": _thread_unread_count(
                args.thread, token, to=getattr(args, "to", None)
            ),
            "has_earlier_turns": has_earlier,
        }
        if has_earlier:
            thread_info["notice"] = (
                f"Fetched {args.last} turn(s) — thread may have earlier turns. "
                f"Use --last {args.last * 2} or --context 3 to widen the window."
            )
        result["_thread_info"] = thread_info

    print(json.dumps(result, indent=indent, default=str))


def _cmd_fetch_unread(args: argparse.Namespace, token: str) -> None:
    """Fetch all unread turns for --to or --thread with no count cap."""
    indent = None if getattr(args, "compact", False) else 2
    params: dict[str, Any] = {"unread": "true"}
    if args.thread:
        params["thread"] = args.thread
    if args.to:
        params["to"] = args.to
    if getattr(args, "compact", False):
        params["compact"] = "true"
    if args.mark_read:
        params["mark_read"] = "true"
    result = _request("GET", f"/turns?{urlencode(params)}", token)
    print(json.dumps(result, indent=indent, default=str))


def _resolve_supersedes_turn_id(
    thread: str, turn_number: int, token: str
) -> int:
    """Map a thread-local turn_number to the store turn id for supersedes_turn."""
    qs = urlencode({"thread": thread, "turn_number": turn_number})
    turn = _request("GET", f"/turns/by-number?{qs}", token)
    return int(turn["id"])


def _resolve_attachments(paths: list[str] | None) -> list[dict[str, Any]] | None:
    """Build attachment metadata from file paths, computing sha256 + size."""
    if not paths:
        return None
    attachments: list[dict[str, Any]] = []
    for p in paths:
        fp = Path(p)
        if not fp.exists():
            print(f"Attachment not found: {p}", file=sys.stderr)
            sys.exit(1)
        data = fp.read_bytes()
        attachments.append(
            {
                "filename": fp.name,
                "path": str(fp.resolve()),
                "mime_type": mimetypes.guess_type(fp.name)[0],
                "size_bytes": len(data),
                "sha256": hashlib.sha256(data).hexdigest(),
            }
        )
    return attachments


def _cmd_post(args: argparse.Namespace, token: str) -> None:
    """Atomically create a new thread and first turn via POST /threads/with-turn."""
    if args.body_file:
        body_text = Path(args.body_file).read_text(encoding="utf-8")
    elif args.body:
        body_text = args.body
    else:
        print("post requires --body or --body-file", file=sys.stderr)
        sys.exit(1)
    payload: dict[str, Any] = {
        "slug": args.slug,
        "from": args.from_agent,
        "to": args.to,
        "subject": args.subject,
        "body": body_text,
        "status": "open",
        "after_turn": 0,
    }
    if args.summary:
        payload["summary"] = args.summary
    if args.allow_long_body:
        payload["allow_long_body"] = True
    atts = _resolve_attachments(args.attach)
    if atts:
        payload["attachments"] = atts
    result = _request("POST", "/threads/with-turn", token, body=payload)
    print(json.dumps(result, indent=2, default=str))


def _cmd_reply(args: argparse.Namespace, token: str) -> None:

    if args.body_file:
        body_text = Path(args.body_file).read_text(encoding="utf-8")
    elif args.body:
        body_text = args.body
    else:
        print("reply requires --body or --body-file", file=sys.stderr)
        sys.exit(1)
    payload: dict[str, Any] = {
        "thread": args.thread,
        "from": args.from_agent,
        "to": args.to,
        "subject": args.subject,
        "body": body_text,
        "status": args.status,
        "after_turn": args.after_turn,
    }
    if args.supersedes_turn is not None:
        payload["supersedes_turn"] = args.supersedes_turn
    if args.allow_long_body:
        payload["allow_long_body"] = True
    atts = _resolve_attachments(args.attach)
    if atts:
        payload["attachments"] = atts
    result = _request("POST", "/turns", token, body=payload)
    if args.mark_read:
        qs = urlencode({"thread": args.thread, "last": 1, "mark_read": "true"})
        _request("GET", f"/turns?{qs}", token)
    print(json.dumps(result, indent=2, default=str))


def _cmd_append(args: argparse.Namespace, token: str) -> None:
    """Append content to an unread turn's body."""
    if args.body_file:
        content = Path(args.body_file).read_text(encoding="utf-8")
    elif args.body:
        content = args.body
    else:
        print("append requires --body or --body-file", file=sys.stderr)
        sys.exit(1)

    qs = urlencode({"thread": args.thread, "turn_number": args.turn})
    turn = _request("GET", f"/turns/by-number?{qs}", token)
    turn_id = turn["id"]

    result = _request("PATCH", f"/turns/{turn_id}", token, body={"append": content})
    print(json.dumps(result, indent=2, default=str))


def _cmd_threads(args: argparse.Namespace, token: str) -> None:
    params = {} if args.status == "all" else {"status": args.status}
    qs = urlencode(params)
    path = f"/threads?{qs}" if qs else "/threads"
    result = _request("GET", path, token)
    print(json.dumps(result, indent=2, default=str))


def _cmd_mark_closed_read(args: argparse.Namespace, token: str) -> None:
    """Set read_at on all turns in threads with status=closed (incl. superseded)."""
    result = _request("GET", "/threads?status=closed", token)
    threads = result.get("threads", [])
    for t in threads:
        tid = t["id"]
        qs = urlencode(
            {
                "thread": tid,
                "last": args.last,
                "mark_read": "true",
                "include_superseded": "true",
            }
        )
        _request("GET", f"/turns?{qs}", token)
    after = _request("GET", "/threads?status=closed", token)
    still = [
        x["id"] for x in after.get("threads", []) if (x.get("unread_count") or 0) > 0
    ]
    print(
        json.dumps(
            {
                "threads_marked": len(threads),
                "threads_still_unread": still,
            },
            indent=2,
        )
    )
    if still:
        sys.exit(1)


def _cmd_update_thread(args: argparse.Namespace, token: str) -> None:
    if (
        not args.status
        and not args.summary
        and not args.add_tags
        and not args.remove_tags
    ):
        print(
            "update-thread requires --status, --summary, --add-tag, and/or --remove-tag",
            file=sys.stderr,
        )
        sys.exit(1)

    if args.status == "closed":
        payload: dict[str, Any] = {}
        if args.summary:
            payload["summary"] = args.summary
        mark = args.mark_read if args.mark_read is not None else True
        payload["mark_all_read"] = mark
        result = _request("PATCH", f"/threads/{args.thread}/close", token, body=payload)
    else:
        payload = {}
        if args.status:
            payload["status"] = args.status
        if args.summary:
            payload["summary"] = args.summary
        if args.add_tags:
            payload["add_tags"] = args.add_tags
        if args.remove_tags:
            payload["remove_tags"] = args.remove_tags
        result = _request("PATCH", f"/threads/{args.thread}", token, body=payload)

    print(json.dumps(result, indent=2, default=str))


def _cmd_delete_thread(args: argparse.Namespace, token: str) -> None:
    import httpx

    params = urlencode({"force": "true"}) if args.force else ""
    path = f"/threads/{args.thread}?{params}" if params else f"/threads/{args.thread}"
    try:
        result = _request("DELETE", path, token)
    except httpx.HTTPStatusError as e:
        detail = ""
        try:
            detail = e.response.json().get("detail", "")
        except Exception:
            pass
        msg = detail or f"HTTP {e.response.status_code}"
        print(f"delete-thread failed: {msg}", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(result, indent=2, default=str))


def _cmd_delete_turn(args: argparse.Namespace, token: str) -> None:
    import httpx

    qs = urlencode({"thread": args.thread, "turn_number": args.turn})
    turn = _request("GET", f"/turns/by-number?{qs}", token)
    turn_id = turn["id"]

    force_params = urlencode({"force": "true"}) if args.force else ""
    path = f"/turns/{turn_id}?{force_params}" if force_params else f"/turns/{turn_id}"
    try:
        result = _request("DELETE", path, token)
    except httpx.HTTPStatusError as e:
        detail = ""
        try:
            detail = e.response.json().get("detail", "")
        except Exception:
            pass
        msg = detail or f"HTTP {e.response.status_code}"
        print(f"delete-turn failed: {msg}", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(result, indent=2, default=str))


def _cmd_checkpoint(args: argparse.Namespace, token: str) -> None:
    del token
    from agent_bus_store.checkpoint_projection import project_checkpoint_body
    from agent_bus_store.checkpoint_projection_wiring import (
        build_post_resolvers,
    )

    residue = Path(args.residue_file).read_text(encoding="utf-8")
    resolvers = build_post_resolvers(root_thread=args.thread)
    body = project_checkpoint_body(
        root_thread=args.thread,
        residue=residue,
        resolvers=resolvers,
    )
    sys.stdout.write(body)
    if not body.endswith("\n"):
        sys.stdout.write("\n")


def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Agent Bus CLI — direct UDS access.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    sub = p.add_subparsers(dest="command", required=True)

    # fetch
    f = sub.add_parser("fetch", help="Fetch turns (inbox or thread history)")
    f.add_argument("--to", help="Agent name for inbox mode")
    f.add_argument("--thread", help="Thread ID for thread history mode")
    f.add_argument("--last", type=int, default=5, help="Max turns (default 5)")
    f.add_argument(
        "--unread", action="store_true", help="Filter to unread (inbox mode)"
    )
    f.add_argument(
        "--mark-read", action="store_true", help="Mark returned turns as read"
    )
    f.add_argument("--compact", action="store_true", help="Omit turn bodies")
    f.add_argument(
        "--context",
        type=int,
        default=0,
        metavar="N",
        help="Fetch N prior turns as context before the first unread turn (default 0)",
    )

    # fetch-unread (explicit: all unread, no last cap)
    fu = sub.add_parser(
        "fetch-unread",
        help="Fetch all unread turns for a recipient or thread (no count limit)",
    )
    fu.add_argument("--to", help="Agent name (inbox mode)")
    fu.add_argument("--thread", help="Thread ID (thread mode)")
    fu.add_argument(
        "--mark-read", action="store_true", help="Mark returned turns as read"
    )
    fu.add_argument("--compact", action="store_true", help="Omit turn bodies")

    # post (new thread + first turn)
    po = sub.add_parser("post", help="Create a new thread and post the first turn")
    po.add_argument("--slug", required=True, help="Thread slug (human-readable name)")
    po.add_argument("--to", required=True, help="Recipient agent")
    po.add_argument("--subject", required=True)
    po.add_argument("--body", help="Inline body text")
    po.add_argument("--body-file", help="Read body from file path")
    po.add_argument("--summary", help="Thread summary")
    po.add_argument("--from-agent", default="cursor", help="Sender (default: cursor)")
    po.add_argument(
        "--allow-long-body",
        action="store_true",
        help=(
            "Explicitly bypass the 8k briefing limit for rare inline long-form "
            "messages; prefer sidecar markdown by default"
        ),
    )
    po.add_argument(
        "--attach",
        action="append",
        metavar="PATH",
        help="Attach a file (repeatable); auto-computes filename, size, sha256",
    )

    # reply
    r = sub.add_parser("reply", help="Post a turn to a thread")
    r.add_argument("--thread", required=True)
    r.add_argument("--to", required=True, help="Recipient agent")
    r.add_argument("--subject", required=True)
    r.add_argument("--body", help="Inline body text")
    r.add_argument("--body-file", help="Read body from file path")
    r.add_argument("--after-turn", type=int, required=True)
    r.add_argument("--from-agent", default="cursor", help="Sender (default: cursor)")
    r.add_argument(
        "--status", default="open", help="Thread status hint (default: open)"
    )
    r.add_argument(
        "--allow-long-body",
        action="store_true",
        help=(
            "Explicitly bypass the 8k briefing limit for rare inline long-form "
            "messages; prefer sidecar markdown by default"
        ),
    )
    r.add_argument(
        "--mark-read",
        action="store_true",
        help="Mark this turn as read immediately (for self-closing notes)",
    )
    r.add_argument(
        "--attach",
        action="append",
        metavar="PATH",
        help="Attach a file (repeatable); auto-computes filename, size, sha256",
    )
    r.add_argument(
        "--supersedes-turn",
        type=int,
        metavar="TURN_NUMBER",
        help=(
            "Turn number in this thread to supersede structurally "
            "(sets turns.status=superseded and links supersedes_turn)"
        ),
    )

    # append
    ap = sub.add_parser("append", help="Append content to an unread turn's body")
    ap.add_argument("--thread", required=True)
    ap.add_argument("--turn", type=int, required=True, help="Turn number")
    ap.add_argument("--body", help="Inline text to append")
    ap.add_argument("--body-file", help="Read append content from file")

    # threads
    t = sub.add_parser("threads", help="List threads")
    t.add_argument(
        "--status",
        default="active",
        help="Filter: active, closed, all (default: active)",
    )

    mcr = sub.add_parser(
        "mark-closed-read",
        help="Mark all turns read in closed threads (incl. superseded)",
    )
    mcr.add_argument(
        "--last",
        type=int,
        default=50_000,
        help="Max turns per thread to fetch/mark (default 50000)",
    )

    # update-thread
    u = sub.add_parser("update-thread", help="Update thread status/summary")
    u.add_argument("--thread", required=True)
    u.add_argument("--status", help="New status")
    u.add_argument("--summary", help="Thread summary")
    u.add_argument(
        "--add-tag",
        action="append",
        dest="add_tags",
        default=[],
        metavar="TAG",
        help="Add tag without replacing others (repeatable)",
    )
    u.add_argument(
        "--remove-tag",
        action="append",
        dest="remove_tags",
        default=[],
        metavar="TAG",
        help="Remove tag without affecting others (repeatable)",
    )
    mark_grp = u.add_mutually_exclusive_group()
    mark_grp.add_argument(
        "--mark-read",
        dest="mark_read",
        action="store_true",
        default=None,
        help="Mark all turns read (default when closing)",
    )
    mark_grp.add_argument(
        "--no-mark-read",
        dest="mark_read",
        action="store_false",
        help="Skip marking turns read even when closing",
    )

    # delete-thread
    d = sub.add_parser("delete-thread", help="Delete a thread and all its turns")
    d.add_argument("--thread", required=True)
    d.add_argument(
        "--force",
        action="store_true",
        help="Delete even if turns have been read",
    )

    # delete-turn
    dt = sub.add_parser("delete-turn", help="Delete a single turn from a thread")
    dt.add_argument("--thread", required=True)
    dt.add_argument("--turn", type=int, required=True, help="Turn number")
    dt.add_argument(
        "--force",
        action="store_true",
        help="Delete even if the turn has been read",
    )

    cp = sub.add_parser(
        "checkpoint",
        help="Assemble a projected CHECKPOINT body from authored residue",
    )
    cp.add_argument("--thread", required=True, help="Root thread id")
    cp.add_argument(
        "--residue-file",
        required=True,
        help="Path to authored residue markdown",
    )

    return p


def main() -> None:
    """Parse CLI arguments, resolve the agent-bus socket token, and dispatch the subcommand."""
    args = _build_parser().parse_args()
    token = _resolve_token()
    try:
        {
            "fetch": _cmd_fetch,
            "fetch-unread": _cmd_fetch_unread,
            "post": _cmd_post,
            "reply": _cmd_reply,
            "append": _cmd_append,
            "threads": _cmd_threads,
            "mark-closed-read": _cmd_mark_closed_read,
            "update-thread": _cmd_update_thread,
            "delete-thread": _cmd_delete_thread,
            "delete-turn": _cmd_delete_turn,
            "checkpoint": _cmd_checkpoint,
        }[args.command](args, token)
    except FileNotFoundError:
        print(
            f"Agent-bus socket not found at {_SOCKET}. "
            "Is the agent-bus service running?",
            file=sys.stderr,
        )
        sys.exit(1)
    except Exception as e:
        print(f"agent-bus error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
