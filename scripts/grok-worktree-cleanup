#!/usr/bin/env bash
# Remove an ad-hoc grok-direct worktree via local git (grokbuild-worker retired).
set -euo pipefail

WORKTREE_ROOT="${WORKTREE_ROOT:-/mnt/torus/projects/ulg-grok-worktrees}"

usage() {
  echo "Usage: scripts/grok-worktree-cleanup <name>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

name="$1"
worktree_path="${WORKTREE_ROOT}/${name}"

if [[ ! -d "$worktree_path" ]]; then
  echo "worktree path does not exist: ${worktree_path}" >&2
  exit 1
fi

if git -C "$worktree_path" status --porcelain | grep -q .; then
  echo "worktree has uncommitted changes: ${worktree_path}" >&2
  exit 1
fi

git -C "$worktree_path" worktree remove "$worktree_path"
echo "removed worktree ${name} under ${WORKTREE_ROOT}"
