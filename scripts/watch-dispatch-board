#!/usr/bin/env python3
"""Full-screen curses dispatch board — folded state dashboard for tmux.

Consumes ``SupervisorProjection`` frames from :class:`MonitorController` (same
path as ``python -m scripts.model_manager.ui.dispatch_monitor --watch live``).
Sibling scroll tail: ``scripts/watch-dispatch-tail``.

Usage::

  ./scripts/watch-dispatch-board
  tmux new-window -n dispatch-board ./scripts/tmux-dispatch-board
"""

from __future__ import annotations

import argparse
import asyncio
import curses
import os
import sys
import threading
from typing import Any

_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

from scripts.model_manager.ui.dispatch_monitor.core.curses_board import (  # noqa: E402
    CursesBoard,
)
from scripts.model_manager.ui.dispatch_monitor.core.dtos import (  # noqa: E402
    SupervisorProjection,
)
from scripts.model_manager.ui.dispatch_monitor.ulg.controller import (  # noqa: E402
    MonitorController,
)
from scripts.model_manager.ui.dispatch_monitor.ulg.manage_charter_hold import (  # noqa: E402
    charter_hold_status,
)
from scripts.model_manager.ui.dispatch_monitor.ulg.tail_selection import (  # noqa: E402
    DEFAULT_SELECTION_PATH,
    ensure_prose_pane,
    move_selection,
    tail_targets,
    write_selection,
)


class _SharedState:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.frame: SupervisorProjection | None = None
        self.hold: bool | None = None
        self.status = "starting…"
        self.stop = threading.Event()


def _poll_hold(state: _SharedState, *, interval_s: float) -> None:
    while not state.stop.is_set():
        try:
            result = charter_hold_status(timeout=5.0)
            held = result.get("held")
            if isinstance(held, bool):
                with state.lock:
                    state.hold = held
            elif "error" in result:
                with state.lock:
                    state.hold = None
        except Exception:  # noqa: BLE001 — keep board alive
            with state.lock:
                state.hold = None
        state.stop.wait(interval_s)


def _run_controller(state: _SharedState, *, seed_minutes: int) -> None:
    controller = MonitorController(seed_minutes=seed_minutes)

    def on_projection(frame: SupervisorProjection) -> None:
        with state.lock:
            state.frame = frame
            if state.status in {"starting…", "seeding…"}:
                state.status = "live"

    async def _main() -> None:
        with state.lock:
            state.status = "seeding…"
        try:
            await controller.run(on_projection=on_projection)
        except Exception as exc:  # noqa: BLE001
            with state.lock:
                state.status = f"controller error: {exc}"
        while not state.stop.is_set():
            await asyncio.sleep(0.5)

    try:
        asyncio.run(_main())
    except KeyboardInterrupt:
        state.stop.set()


def _selection_verb(key: int) -> str | None:
    if key in (ord("j"), curses.KEY_DOWN):
        return "down"
    if key in (ord("k"), curses.KEY_UP):
        return "up"
    if key in (10, 13, curses.KEY_ENTER):
        return "enter"
    return None


def _curses_main(stdscr: Any, state: _SharedState, *, seed_minutes: int) -> None:
    board = CursesBoard(stdscr, seed_minutes=seed_minutes)
    index = 0
    tail_status = "j/k select · enter opens the transcript pane"
    launcher = os.path.join(os.path.dirname(__file__), "tmux-dispatch-prose")
    while not state.stop.is_set():
        with state.lock:
            frame = state.frame
            hold = state.hold
            status = state.status
        targets = tail_targets(frame.sdk, frame.cdp) if frame is not None else []
        index, _ = move_selection(index, len(targets), "")
        selected = targets[index].key if targets else None
        board.set_hold(hold)
        board.set_status(f"{status}  {tail_status}")
        board.paint(frame, selected_key=selected)
        try:
            key = stdscr.getch()
        except curses.error:
            continue
        if key in (ord("q"), ord("Q")):
            state.stop.set()
            break
        verb = _selection_verb(key)
        if verb is None or not targets:
            continue
        index, arm = move_selection(index, len(targets), verb)
        if not arm:
            continue
        target = targets[index]
        write_selection(DEFAULT_SELECTION_PATH, target)
        pane = ensure_prose_pane(launcher)
        if pane == "opened":
            tail_status = f"transcript pane opened · {target.label}"
        elif pane == "already_open":
            tail_status = f"transcript following {target.label}"
        elif pane == "not_in_tmux":
            tail_status = f"selection written · run scripts/tmux-dispatch-prose · {target.label}"
        else:
            tail_status = f"transcript pane failed ({pane})"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--seed-minutes",
        type=int,
        default=60,
        help="cold-start history window (default 60)",
    )
    parser.add_argument(
        "--hold-poll-s",
        type=float,
        default=5.0,
        help="charter hold status poll interval (default 5)",
    )
    args = parser.parse_args(argv)

    state = _SharedState()
    hold_thread = threading.Thread(
        target=_poll_hold,
        args=(state,),
        kwargs={"interval_s": args.hold_poll_s},
        daemon=True,
    )
    ctrl_thread = threading.Thread(
        target=_run_controller,
        args=(state,),
        kwargs={"seed_minutes": args.seed_minutes},
        daemon=True,
    )
    hold_thread.start()
    ctrl_thread.start()

    try:
        curses.wrapper(
            lambda stdscr: _curses_main(stdscr, state, seed_minutes=args.seed_minutes)
        )
    except KeyboardInterrupt:
        state.stop.set()
        return 0
    finally:
        state.stop.set()
        ctrl_thread.join(timeout=2.0)
        hold_thread.join(timeout=1.0)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
