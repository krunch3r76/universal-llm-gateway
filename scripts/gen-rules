#!/usr/bin/env python3
"""Generate cursor `.mdc` rule files from `agent-surface/` neutral-canonical sources.

Usage:
    scripts/gen-rules --target {cursor|command-map|agent-guides-rules|agent-skill-bundles|cortex-rules} [--check] [--dry-run]

Targets:
    cursor       Emit `.cursor/rules/cursor-boot_ws.mdc` + `.cursor/rules/mcp-tool-awareness_ws.mdc`;
                 run drift-check between `core_ws.mdc` Subagent Model Selection table and
                 `agent-surface/table-variants/subagent-model-table.cursor.md`.
    command-map  Emit `docs/agent-guides/mvw-command-map.md` from
                 `agent-surface/sources/command-map.md` (wildcard target blocks).
    agent-guides-rules  Emit `docs/agent-guides/rules/*.md` from the MVW conduct manifest
                 in `libs/gen_rules/agent_guides.py` (wildcard `target:*` blocks).
    agent-skill-bundles  Emit `.cursor/skills/<slug>/SKILL.md` for agent-surface overlap
                 slugs in `libs/gen_rules/agent_skill_bundles.py` (wildcard `target:*`
                 blocks + `frontmatter:skill`).
    cortex-rules Upsert `rule:<slug>` cortex projections (source_uri + digest +
                 applicability) via scripts/cortex/ingest_rules.py. Run AFTER
                 agent-guides-rules so generated files exist to digest.

Flags:
    --check     Diff-gate: exit non-zero if generated output differs from committed
                file. No writes.
    --dry-run   Print what would be written/spliced; do not modify files.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

# Allow direct execution from the workspace tree without PYTHONPATH gymnastics.
_REPO = Path(__file__).resolve().parent.parent
if str(_REPO / "libs") not in sys.path:
    sys.path.insert(0, str(_REPO / "libs"))

from gen_rules.agent_guides import emit_agent_guides_rules  # noqa: E402
from gen_rules.agent_skill_bundles import emit_agent_skill_bundles  # noqa: E402

_SCRIPTS_CORTEX = _REPO / "scripts" / "cortex"
if str(_SCRIPTS_CORTEX) not in sys.path:
    sys.path.insert(0, str(_SCRIPTS_CORTEX))
from gen_rules.check import diff_against, extract_core_subagent_table  # noqa: E402
from gen_rules.parser import parse_source  # noqa: E402
from gen_rules.renderer import _do_not_edit, render_cursor_mdc  # noqa: E402
from ingest_rules import main as ingest_rules_main  # noqa: E402

# Section registry: single source of authoritative IDs and paths. The migration
# entry-point (`scripts/gen-rules`) stays under SLOC budget by delegating parse/
# render/check to libs/gen_rules/.
SECTIONS = {
    "boot-protocol": {
        "source": "agent-surface/sources/boot-protocol.md",
        "cursor_out": ".cursor/rules/cursor-boot_ws.mdc",
    },
    "mcp-tool-awareness": {
        "source": "agent-surface/sources/mcp-tool-awareness.md",
        "cursor_out": ".cursor/rules/mcp-tool-awareness_ws.mdc",
    },
    "subagent-model-table": {
        "cursor_variant": "agent-surface/table-variants/subagent-model-table.cursor.md",
        "core_mdc": ".cursor/rules/core_ws.mdc",
    },
    "command-map": {
        "source": "agent-surface/sources/command-map.md",
        "out": "docs/agent-guides/mvw-command-map.md",
    },
}


def _workspace_root() -> Path:
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
        return Path(out)
    except subprocess.CalledProcessError:
        return _REPO


def _emit_cursor(root: Path, *, check: bool, dry_run: bool) -> int:
    """Generate `.cursor/rules/*.mdc` outputs and run drift-check.

    Returns process exit code (0 OK, 1 on drift / write failure).
    """
    fail = 0
    for sect_id in ("boot-protocol", "mcp-tool-awareness"):
        spec = SECTIONS[sect_id]
        source_path = root / spec["source"]
        out_path = root / spec["cursor_out"]
        parsed = parse_source(source_path)
        rendered = render_cursor_mdc(parsed, source_rel=spec["source"])
        if dry_run:
            print(f"--- {out_path} ---")
            print(rendered, end="")
            continue
        if check:
            current = out_path.read_text() if out_path.exists() else ""
            d = diff_against(
                current,
                rendered,
                label_expected=str(out_path),
                label_actual="<generated>",
            )
            if d:
                print(d, end="")
                print(
                    f"DRIFT: {out_path} out of sync with {spec['source']}",
                    file=sys.stderr,
                )
                fail = 1
            continue
        out_path.write_text(rendered)
        print(f"wrote {out_path}")

    spec = SECTIONS["subagent-model-table"]
    core_table = extract_core_subagent_table(root / spec["core_mdc"])
    cursor_variant = (root / spec["cursor_variant"]).read_text()
    if not cursor_variant.endswith("\n"):
        cursor_variant += "\n"
    d = diff_against(
        core_table,
        cursor_variant,
        label_expected=spec["core_mdc"],
        label_actual=spec["cursor_variant"],
    )
    if d:
        print(d, end="")
        print(
            f"DRIFT: {spec['cursor_variant']} disagrees with {spec['core_mdc']} "
            "subagent-model-table. Update the variant file (do NOT modify core_ws.mdc).",
            file=sys.stderr,
        )
        fail = 1
    elif not dry_run and not check:
        print(f"OK drift-check: {spec['cursor_variant']} matches {spec['core_mdc']}")

    return fail


def _emit_command_map(root: Path, *, check: bool, dry_run: bool) -> int:
    """Emit MVW command map for all seats (wildcard target blocks)."""
    spec = SECTIONS["command-map"]
    source_path = root / spec["source"]
    out_path = root / spec["out"]
    parsed = parse_source(source_path)
    body = "".join(b.content for b in parsed.blocks if b.target == "*")
    rendered = _do_not_edit(spec["source"]) + "\n" + body
    if not rendered.endswith("\n"):
        rendered += "\n"

    if dry_run:
        print(f"--- {out_path} ---")
        print(rendered, end="")
        return 0

    if check:
        current = out_path.read_text() if out_path.exists() else ""
        d = diff_against(
            current,
            rendered,
            label_expected=str(out_path),
            label_actual="<generated>",
        )
        if d:
            print(d, end="")
            print(
                f"DRIFT: {out_path} out of sync with {spec['source']}", file=sys.stderr
            )
            return 1
        return 0

    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(rendered)
    print(f"wrote {out_path}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--target",
        choices=(
            "cursor",
            "command-map",
            "agent-guides-rules",
            "agent-skill-bundles",
            "cortex-rules",
        ),
        required=True,
    )
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)

    root = _workspace_root()
    if args.target == "cursor":
        rc = _emit_cursor(root, check=args.check, dry_run=args.dry_run)
    elif args.target == "command-map":
        rc = _emit_command_map(root, check=args.check, dry_run=args.dry_run)
    elif args.target == "agent-guides-rules":
        rc = emit_agent_guides_rules(root, check=args.check, dry_run=args.dry_run)
    elif args.target == "agent-skill-bundles":
        rc = emit_agent_skill_bundles(root, check=args.check, dry_run=args.dry_run)
    else:
        ingest_argv: list[str] = ["--root", str(root)]
        if args.check:
            ingest_argv.append("--check")
        if args.dry_run:
            ingest_argv.append("--dry-run")
        rc = ingest_rules_main(ingest_argv)

    if args.check and rc == 0:
        print(f"OK gen-rules --check --target {args.target}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
