#!/usr/bin/env bash
# Frontier-model panel for deep consultation calls.
#
# Runs `consult -r planner` with a curated set of top frontier models
# and an extended timeout. Called by agents executing the /consult-plan
# Cursor command (step 6: deep call) — not invoked directly by users.
#
# Cost: 3-model panel (o3 + gpt-5.4 + gemini-3.1-pro). gpt-5.4 is used instead
# of gpt-5.4-pro (~12× cheaper: $2.50/$15 vs $30/$180 per 1M tokens).
# Reserve gpt-5.4-pro for extremely difficult problems (invoke with explicit --models if needed).
#
# Usage:
#   consult-frontier "Describe the change" -f relevant/files...
#   consult-frontier -Q /tmp/question.txt -f services/foo/ -o /tmp/plan.md
#
# All extra arguments are forwarded to `consult -r planner`.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

FRONTIER_MODELS=(
    openai/o3
    openai/gpt-5.4
    google/gemini-3.1-pro-preview
)

exec "$SCRIPT_DIR/consult" \
    -r planner \
    --models "${FRONTIER_MODELS[@]}" \
    --timeout 360 \
    "$@"
