#!/usr/bin/env python3
"""General-purpose multi-model consultation with role templates and RAG.

Query multiple models in parallel (or chained sequentially) with a
configurable role and optional RAG context + file injection.

Usage:
  consult "How should we handle WebSocket reconnection?"
  consult -r architect "Should routing use events or polling?" -f systems/routing/
  consult -r reviewer -f capacity/ledger.py  # structured pipeline (default for reviewer)
  consult -r planner "Add per-model timeouts" -o plan.md
  consult --models qwen3-32b-awq-32768 google/gemini-2.5-pro "question"
  consult --chain -r planner --models local cloud "complex question"
  consult --no-rag "question"
  consult --rag-pipeline "complex multi-faceted question"
"""

from __future__ import annotations

import argparse
import sys
import textwrap
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))

from consult_lib.constants import (
    DEFAULT_ROLE,
    DEFAULT_STARGATE_URL,
    REVIEWER_DEFAULT_MODELS,
)
from consult_lib.context import collect_context_file_paths
from consult_lib.core import ConsultResult, execute_consult
from consult_lib.model_selection import (
    load_roles,
    select_models_for_role,
    split_role_config,
)
from consult_lib.output import format_output, format_pipeline_review_output
from consult_lib.pipeline import (
    build_reviewer_pipeline_model_overrides,
    run_code_review_pipeline,
)
from transport_utils.rag_client import DEFAULT_RAG_URL


def _build_parser(role_prompts: dict[str, str]) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Multi-model consultation with role templates and RAG",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            Roles:
              architect    Evaluate architecture, trade-offs, improvements
              reviewer     Code review via pipeline (structured findings, validated)
              planner      Implementation plan: files, steps, risks
              researcher   Research-grounded Q&A (default)
              modularizer  Split oversized files respecting SLOC and SRP
              prompt_engineer  Diagnose pipeline step failures, suggest fixes

            Examples:
              consult "How should we handle reconnection?"
              consult -r architect "Event bus: pub/sub vs direct?" -f docs/event-contracts.md
              consult -r reviewer -f capacity/ledger.py  # structured pipeline (default for reviewer)
              consult -r planner "Add per-model timeouts" -o plan.md
              consult --chain -r planner --models local cloud "complex question"
              consult --models qwen3-32b-awq-32768 google/gemini-2.5-pro "question"
              consult --cloud-only -r reviewer -f myfile.py "question"
              consult --cloud-only --models google/gemini-2.5-pro "question"
        """),
    )
    parser.add_argument("question", nargs="?", help="Question to consult on")
    parser.add_argument(
        "-r",
        "--role",
        default=DEFAULT_ROLE,
        choices=list(role_prompts),
        help=f"Consultation role (default: {DEFAULT_ROLE})",
    )
    parser.add_argument(
        "-f",
        "--context-files",
        action="append",
        default=[],
        metavar="PATH",
        help="Files/directories to include as context (repeatable)",
    )
    parser.add_argument(
        "--models",
        nargs="+",
        default=None,
        metavar="MODEL",
        help="Models to query (default: role-based auto-selection)",
    )
    parser.add_argument(
        "-o", "--output", default=None, metavar="FILE", help="Save results to file"
    )
    parser.add_argument(
        "-u", "--stargate-url", default=DEFAULT_STARGATE_URL, help="Stargate URL"
    )
    parser.add_argument(
        "--rag-url",
        default=DEFAULT_RAG_URL,
        help="RAG service URL (default: unix socket)",
    )
    parser.add_argument("--no-rag", action="store_true", help="Disable RAG")
    parser.add_argument(
        "--scope",
        default="project",
        help="RAG retrieval scope (default: project). "
        "Available scopes fetched from RAG service.",
    )
    parser.add_argument(
        "--rag-pipeline",
        nargs="?",
        const="rag-context",
        default=None,
        metavar="PIPELINE",
        help="Use intelligent RAG pipeline (default: rag-context)",
    )
    parser.add_argument(
        "--timeout", type=float, default=300.0, help="Per-model timeout in seconds"
    )
    parser.add_argument("--list-roles", action="store_true", help="List roles and exit")
    parser.add_argument(
        "--chain",
        action="store_true",
        help="Chain models sequentially: first as analyst, rest as reviewers",
    )
    parser.add_argument(
        "--chain-directive",
        default=None,
        metavar="TEXT",
        help="Custom reviewer directive for chained mode",
    )
    parser.add_argument(
        "--cloud-only",
        action="store_true",
        help=(
            "Restrict to cloud models only (IDs containing '/'). "
            "Errors if none are available."
        ),
    )
    parser.add_argument("--pipeline", action="store_true", help=argparse.SUPPRESS)
    return parser


def _results_to_dicts(results: list[ConsultResult]) -> list[dict[str, Any]]:
    """Convert ConsultResult list back to dicts for format_output compatibility."""
    out: list[dict[str, Any]] = []
    for r in results:
        d: dict[str, Any] = {"model_id": r.model_id}
        if r.error:
            d["error"] = r.error
        else:
            d["response"] = r.response_text
            d["prompt_tokens"] = r.prompt_tokens
            d["completion_tokens"] = r.completion_tokens
            d["latency_ms"] = r.latency_ms
        if r.phase:
            d["phase"] = r.phase
        out.append(d)
    return out


def _run_reviewer_pipeline(
    args: argparse.Namespace,
    parser: argparse.ArgumentParser,
    target_models: list[str],
) -> str:
    """Handle reviewer pipeline mode (separate from execute_consult)."""
    context_file_paths = collect_context_file_paths(args.context_files)
    if not context_file_paths:
        parser.error("--pipeline requires at least one --context-files path")
    pipeline_options: dict[str, Any] | None = None
    overrides = build_reviewer_pipeline_model_overrides(target_models)
    if overrides:
        pipeline_options = {"model_ref_overrides": overrides}
        print(
            "Pipeline reviewer model overrides: "
            + ", ".join(f"{k}={v}" for k, v in overrides.items()),
            file=sys.stderr,
        )
    print(
        f"Pipeline mode: estimating batches for {len(context_file_paths)} files",
        file=sys.stderr,
    )
    try:
        batch_results = run_code_review_pipeline(
            stargate_url=args.stargate_url,
            files=context_file_paths,
            timeout=args.timeout,
            pipeline_options=pipeline_options,
        )
    except Exception as exc:
        parser.error(f"--pipeline failed: {exc}")
    return format_pipeline_review_output(
        question=args.question,
        file_paths=context_file_paths,
        batches=batch_results,
    )


def main() -> None:
    raw_roles = load_roles()
    role_prompts, role_requirements = split_role_config(raw_roles)
    parser = _build_parser(role_prompts)
    args = parser.parse_args()

    if args.role == "reviewer":
        args.pipeline = True

    if args.list_roles:
        for name, prompt in role_prompts.items():
            marker = " (default)" if name == DEFAULT_ROLE else ""
            print(f"\n=== {name}{marker} ===")
            print(prompt)
        sys.exit(0)

    if not args.question:
        if not sys.stdin.isatty():
            args.question = sys.stdin.read().strip()
        if not args.question:
            parser.error("No question provided")

    if args.pipeline:
        target_models = args.models or REVIEWER_DEFAULT_MODELS
        # --cloud-only overrides source in the requirements so the unified
        # endpoint enforces cloud-only selection server-side.
        reviewer_requirements = role_requirements
        if args.cloud_only and "reviewer" in role_requirements:
            reviewer_requirements = {
                **role_requirements,
                "reviewer": {**role_requirements["reviewer"], "source": "cloud"},
            }
        selected = select_models_for_role("reviewer", reviewer_requirements, args.stargate_url)
        if selected and not args.models:
            target_models = selected
        output = _run_reviewer_pipeline(args, parser, target_models)
        print(output)
        if args.output:
            out_path = Path(args.output)
            out_path.parent.mkdir(parents=True, exist_ok=True)
            out_path.write_text(output)
            print(f"Saved: {out_path}", file=sys.stderr)
        return

    try:
        results = execute_consult(
            args.question,
            role=args.role,
            context_files=[Path(p) for p in args.context_files]
            if args.context_files
            else None,
            scope=args.scope,
            chain=args.chain,
            models=args.models,
            stargate_url=args.stargate_url,
            rag_url=args.rag_url,
            no_rag=args.no_rag,
            use_rag_pipeline=args.rag_pipeline is not None,
            timeout=args.timeout,
            chain_directive=args.chain_directive,
            cloud_only=args.cloud_only,
        )
    except (ValueError, RuntimeError) as exc:
        parser.error(str(exc))

    result_dicts = _results_to_dicts(results)
    output = format_output(
        args.question,
        args.role,
        result_dicts,
        None,
        args.context_files,
        chained=args.chain,
    )
    print(output)

    if args.output:
        out_path = Path(args.output)
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(output)
        print(f"Saved: {out_path}", file=sys.stderr)


if __name__ == "__main__":
    main()
