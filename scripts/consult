#!/usr/bin/env python3
"""General-purpose multi-model consultation with role templates and RAG.

Query multiple models in parallel (or chained sequentially) with a
configurable role and optional RAG context + file injection.

Usage:
  consult "How should we handle WebSocket reconnection?"
  consult -r architect "Should routing use events or polling?" -f systems/routing/
  consult -r reviewer -f capacity/ledger.py  # structured pipeline (default for reviewer)
  consult -r planner "Add per-model timeouts" -o plan.md
  consult --models qwen3-32b-awq-32768 google/gemini-2.5-pro "question"
  consult --chain -r planner --models local cloud "complex question"
  consult --no-rag "question"
  consult --rag-pipeline "complex multi-faceted question"
"""

from __future__ import annotations

import argparse
import sys
import textwrap
from pathlib import Path
from typing import Any

# Ensure consult_lib is importable regardless of working directory.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from consult_lib.constants import (
    DEFAULT_MODELS,
    DEFAULT_ROLE,
    DEFAULT_STARGATE_URL,
    REVIEWER_DEFAULT_MODELS,
)
from consult_lib.context import collect_context_file_paths, read_context_files
from consult_lib.model_selection import (
    fetch_available_model_ids,
    load_roles,
    select_models_for_role,
    split_role_config,
    warn_local_model_for_role,
)
from consult_lib.output import format_output, format_pipeline_review_output
from consult_lib.pipeline import (
    build_reviewer_pipeline_model_overrides,
    run_code_review_pipeline,
)
from consult_lib.query import build_prompt, query_chain, query_parallel
from consult_lib.rag import (
    fetch_rag_direct,
    fetch_rag_pipeline,
    fetch_scope_choices,
    rag_socket_present,
)
from transport_utils.rag_client import DEFAULT_RAG_URL


def _build_parser(role_prompts: dict[str, str]) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Multi-model consultation with role templates and RAG",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            Roles:
              architect    Evaluate architecture, trade-offs, improvements
              reviewer     Code review via pipeline (structured findings, validated)
              planner      Implementation plan: files, steps, risks
              researcher   Research-grounded Q&A (default)
              modularizer  Split oversized files respecting SLOC and SRP

            Examples:
              consult "How should we handle reconnection?"
              consult -r architect "Event bus: pub/sub vs direct?" -f docs/event-contracts.md
              consult -r reviewer -f capacity/ledger.py  # structured pipeline (default for reviewer)
              consult -r planner "Add per-model timeouts" -o plan.md
              consult --chain -r planner --models local cloud "complex question"
              consult --models qwen3-32b-awq-32768 google/gemini-2.5-pro "question"
              consult --cloud-only -r reviewer -f myfile.py "question"
              consult --cloud-only --models google/gemini-2.5-pro "question"
        """),
    )
    parser.add_argument("question", nargs="?", help="Question to consult on")
    parser.add_argument(
        "-r",
        "--role",
        default=DEFAULT_ROLE,
        choices=list(role_prompts),
        help=f"Consultation role (default: {DEFAULT_ROLE})",
    )
    parser.add_argument(
        "-f",
        "--context-files",
        action="append",
        default=[],
        metavar="PATH",
        help="Files/directories to include as context (repeatable)",
    )
    parser.add_argument(
        "--models",
        nargs="+",
        default=None,
        metavar="MODEL",
        help="Models to query (default: qwen3-32b + ernie + gemini-2.5-flash)",
    )
    parser.add_argument(
        "-o", "--output", default=None, metavar="FILE", help="Save results to file"
    )
    parser.add_argument(
        "-u", "--stargate-url", default=DEFAULT_STARGATE_URL, help="Stargate URL"
    )
    parser.add_argument(
        "--rag-url",
        default=DEFAULT_RAG_URL,
        help="RAG service URL (default: unix socket)",
    )
    parser.add_argument("--no-rag", action="store_true", help="Disable RAG")
    parser.add_argument(
        "--scope",
        default="project",
        help="RAG retrieval scope (default: project). "
        "Available scopes fetched from RAG service.",
    )
    parser.add_argument(
        "--rag-pipeline",
        nargs="?",
        const="rag-context",
        default=None,
        metavar="PIPELINE",
        help="Use intelligent RAG pipeline (default: rag-context)",
    )
    parser.add_argument(
        "--timeout", type=float, default=300.0, help="Per-model timeout in seconds"
    )
    parser.add_argument("--list-roles", action="store_true", help="List roles and exit")
    parser.add_argument(
        "--chain",
        action="store_true",
        help="Chain models sequentially: first as analyst, rest as reviewers",
    )
    parser.add_argument(
        "--chain-directive",
        default=None,
        metavar="TEXT",
        help="Custom reviewer directive for chained mode",
    )
    parser.add_argument(
        "--cloud-only",
        action="store_true",
        help=(
            "Restrict to cloud models only (IDs containing '/'). "
            "Errors if none are available — use to ensure cloud intelligence "
            "rather than silently falling back to local GPU models."
        ),
    )
    parser.add_argument("--pipeline", action="store_true", help=argparse.SUPPRESS)
    return parser


def _resolve_target_models(
    args: argparse.Namespace,
    role_select: dict[str, dict[str, Any]],
    parser: argparse.ArgumentParser,
) -> list[str]:
    """Resolve target models from explicit args, profile selection, or defaults."""
    if args.models:
        warn_local_model_for_role(args.role, args.models, role_select)
        target_models = args.models
    else:
        selected = select_models_for_role(args.role, role_select, args.stargate_url)
        if selected:
            print(f"Models for '{args.role}': {', '.join(selected)}", file=sys.stderr)
            target_models = selected
        else:
            defaults = (
                REVIEWER_DEFAULT_MODELS if args.role == "reviewer" else DEFAULT_MODELS
            )
            print(
                f"Selection path: static-defaults ({', '.join(defaults)})",
                file=sys.stderr,
            )
            target_models = defaults

    if not args.cloud_only:
        return target_models

    available_model_ids = fetch_available_model_ids(args.stargate_url)
    if available_model_ids is None:
        parser.error(
            "--cloud-only: failed to fetch available models from Stargate.\n"
            f"  Check: curl -s {args.stargate_url}/v1/models"
        )
    available_cloud_models = {m for m in available_model_ids if "/" in m}
    if not available_cloud_models:
        parser.error(
            "--cloud-only: no cloud models currently exposed by Stargate.\n"
            "  Cloud proxy may be down."
        )
    cloud_models = [m for m in target_models if "/" in m]
    local_excluded = [m for m in target_models if "/" not in m]
    if not cloud_models:
        parser.error(
            "--cloud-only: selected models do not contain cloud IDs ('/').\n"
            "  Pass --models with cloud IDs or enable cloud auto-select."
        )
    missing = [m for m in cloud_models if m not in available_cloud_models]
    if missing:
        parser.error(
            f"--cloud-only: selected cloud models are not currently available:\n"
            f"  {', '.join(missing)}"
        )
    if local_excluded:
        print(
            f"--cloud-only: excluded local models: {', '.join(local_excluded)}",
            file=sys.stderr,
        )
    return cloud_models


def main() -> None:
    raw_roles = load_roles()
    role_prompts, role_select = split_role_config(raw_roles)
    parser = _build_parser(role_prompts)
    args = parser.parse_args()

    if args.role == "reviewer":
        args.pipeline = True

    if args.list_roles:
        for name, prompt in role_prompts.items():
            marker = " (default)" if name == DEFAULT_ROLE else ""
            print(f"\n=== {name}{marker} ===")
            print(prompt)
        sys.exit(0)

    if not args.question:
        if not sys.stdin.isatty():
            args.question = sys.stdin.read().strip()
        if not args.question:
            parser.error("No question provided")

    if not args.no_rag:
        if not rag_socket_present(args.rag_url):
            print(
                "RAG service not available (socket absent); running without context retrieval",
                file=sys.stderr,
            )
            args.no_rag = True
        else:
            available_scopes = fetch_scope_choices(rag_url=args.rag_url)
            if args.scope not in available_scopes:
                parser.error(
                    f"Unknown --scope '{args.scope}'. Available scopes: "
                    f"{', '.join(sorted(available_scopes))}"
                )

    target_models = _resolve_target_models(args, role_select, parser)

    if args.chain and len(target_models) < 2:
        parser.error("--chain requires at least 2 models")

    if args.pipeline:
        context_file_paths = collect_context_file_paths(args.context_files)
        if not context_file_paths:
            parser.error("--pipeline requires at least one --context-files path")
        pipeline_options: dict[str, Any] | None = None
        if args.role == "reviewer":
            overrides = build_reviewer_pipeline_model_overrides(target_models)
            if overrides:
                pipeline_options = {"model_ref_overrides": overrides}
                print(
                    "Pipeline reviewer model overrides: "
                    + ", ".join(f"{k}={v}" for k, v in overrides.items()),
                    file=sys.stderr,
                )
        print(
            f"Pipeline mode: estimating batches for {len(context_file_paths)} files",
            file=sys.stderr,
        )
        try:
            batch_results = run_code_review_pipeline(
                stargate_url=args.stargate_url,
                files=context_file_paths,
                timeout=args.timeout,
                pipeline_options=pipeline_options,
            )
        except Exception as exc:
            parser.error(f"--pipeline failed: {exc}")
        output = format_pipeline_review_output(
            question=args.question,
            file_paths=context_file_paths,
            batches=batch_results,
        )
        print(output)
        if args.output:
            out_path = Path(args.output)
            out_path.parent.mkdir(parents=True, exist_ok=True)
            out_path.write_text(output)
            print(f"Saved: {out_path}", file=sys.stderr)
        return

    system_prompt = role_prompts[args.role]
    file_context: list[str] | None = None
    if args.context_files:
        file_context = read_context_files(args.context_files)
        if file_context:
            print(f"Read {len(file_context)} context blocks", file=sys.stderr)

    rag_findings: list[str] | None = None
    rag_error: str | None = None
    if not args.no_rag:
        print("Retrieving RAG context...", file=sys.stderr)
        if args.rag_pipeline:
            rag_findings, rag_error = fetch_rag_pipeline(
                args.question,
                pipeline_id=args.rag_pipeline,
                stargate_url=args.stargate_url,
                rag_url=args.rag_url,
                scope_override=args.scope,
            )
        else:
            rag_findings, rag_error = fetch_rag_direct(
                args.question,
                rag_url=args.rag_url,
                scope=args.scope,
            )
        if rag_error:
            print(f"RAG: {rag_error} (continuing without)", file=sys.stderr)
        elif rag_findings:
            print(f"RAG: {len(rag_findings)} findings", file=sys.stderr)

    user_prompt = build_prompt(args.question, rag_findings, file_context)
    mode = "chained" if args.chain else "parallel"
    print(
        f"Consulting {len(target_models)} model(s) as {args.role} ({mode})...",
        file=sys.stderr,
    )

    if args.chain:
        results = query_chain(
            models=target_models,
            system_prompt=system_prompt,
            user_prompt=user_prompt,
            stargate_url=args.stargate_url,
            timeout=args.timeout,
            chain_directive=args.chain_directive,
        )
    else:
        results = query_parallel(
            models=target_models,
            system_prompt=system_prompt,
            user_prompt=user_prompt,
            stargate_url=args.stargate_url,
            timeout=args.timeout,
        )

    output = format_output(
        args.question,
        args.role,
        results,
        rag_error,
        args.context_files,
        chained=args.chain,
    )
    print(output)

    if args.output:
        out_path = Path(args.output)
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(output)
        print(f"Saved: {out_path}", file=sys.stderr)


if __name__ == "__main__":
    main()
