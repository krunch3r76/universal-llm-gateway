#!/usr/bin/env bash
# Run claude.ai Skills upload/status on Jupiter where Chrome CDP lives.
#
# Cursor and other remote seats often have no DISPLAY and no CDP on :9222.
# Playwright must SSH to Jupiter (DISPLAY=:1, logged-in claude.ai profile).
#
# Usage:
#   scripts/cortex/claude-ai-sync-jupiter ensure-chrome
#   scripts/cortex/claude-ai-sync-jupiter ensure-chrome --port 9223 --profile-suffix ask
#   scripts/cortex/claude-ai-sync-jupiter status
#   scripts/cortex/claude-ai-sync-jupiter upload --slugs my-skill --continue-on-error
#   scripts/cortex/claude-ai-sync-jupiter upload --slugs my-skill --replace --continue-on-error
#   scripts/cortex/claude-ai-sync-jupiter upload --all --continue-on-error   # NEW slugs only
#   # --all --replace is refused unless --force-replace-all (never the default)
#   scripts/cortex/claude-ai-sync-jupiter uninstall --slugs retired-skill
#   scripts/cortex/claude-ai-sync-jupiter restore-connector
#   scripts/cortex/claude-ai-sync-jupiter project-chrome ensure|destroy|get|render-prompt …
#   scripts/cortex/claude-ai-sync-jupiter project-ask --uuid UUID --prompt-file …
#   scripts/cortex/claude-ai-sync-jupiter project-ask --cdp-port 9223 --profile-suffix ask --uuid … --prompt-file …
#   scripts/cortex/claude-ai-sync-jupiter project-ask --cdp-port 9223 --profile-suffix ask \\
#     --converse --no-uuid --model fable-5 --prompt-file t1.md --out-dir …
#
# Parallel seats: primary CDP is :9222 + claude-ai-chrome-profile (attended).
# Automated seats MUST use register-lane / project-ask --register (default) —
# never hand-pick --port. See libs/claude_bundles/cdp_registry.py.
#
#   scripts/cortex/claude-ai-sync-jupiter register-lane --holder seat-a --purpose ask
#   scripts/cortex/claude-ai-sync-jupiter project-ask --register --purpose ask --uuid … --prompt-file …
#   scripts/cortex/claude-ai-sync-jupiter deregister-lane --registration-id <id>
#   scripts/cortex/claude-ai-sync-jupiter list-lanes
#
# Legacy explicit warm pool (attended / --no-register only):
#   scripts/cortex/claude-ai-sync-jupiter ensure-chrome --port 9223 --profile-suffix ask
#
# MCP connector playbook: agent_skill:claude-ai-mcp-connect
# Env: CLAUDE_AI_SSH_HOST (default jupiter), CLAUDE_AI_SSH_USER (default krunch3r)

set -euo pipefail

HOST="${CLAUDE_AI_SSH_HOST:-jupiter}"
USER="${CLAUDE_AI_SSH_USER:-krunch3r}"
SSH="${USER}@${HOST}"
REMOTE_REPO="/mnt/torus/projects/universal-llm-gateway"
PY='~/.venvs/universal/bin/python'
usage() {
  sed -n '2,24p' "$0" | sed 's/^# \?//'
  echo ""
  echo "Commands: ensure-chrome | status | upload | uninstall | restore-connector |"
  echo "          project-chrome | project-ask |"
  echo "          register-lane | deregister-lane | list-lanes"
  exit "${1:-0}"
}

# Parse optional --port / --profile-suffix / --cdp-port before subcommand args.
CDP_PORT=9222
PROFILE_SUFFIX=""
parse_chrome_flags() {
  local out=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port|--cdp-port)
        CDP_PORT="${2:?}"
        shift 2
        ;;
      --profile-suffix)
        PROFILE_SUFFIX="${2:?}"
        shift 2
        ;;
      *)
        out+=("$1")
        shift
        ;;
    esac
  done
  PARSED_ARGS=("${out[@]+"${out[@]}"}")
}

ensure_chrome() {
  local port="$1"
  local suffix="${2:-}"
  # Expand HOME on Jupiter (never pass a local-literal '$HOME/...').
  # shellcheck disable=SC2029
  ssh "$SSH" "PORT='${port}' SUFFIX='${suffix}' bash -s" <<'REMOTE'
set -e
PORT="${PORT:-9222}"
PRIMARY="${HOME}/.gateway/claude-ai-chrome-profile"
if [[ -n "${SUFFIX}" ]]; then
  PROFILE="${PRIMARY}-${SUFFIX}"
else
  PROFILE="${PRIMARY}"
fi
LOG="/tmp/chrome-cdp-claude-ai-${PORT}.log"

if curl -sf "http://127.0.0.1:${PORT}/json/version" >/dev/null 2>&1; then
  # CDP already up — attest the LIVE process owning :PORT uses the expected
  # user-data-dir. Early-exit must not trust the caller's requested profile:
  # a lane started under one suffix, later attached with a different suffix,
  # would bleed across cookie/account lanes (24612 residual / T1).
  # cmdline separator varies: renderers keep NUL-separated argv, but Chrome's
  # main (browser) process rewrites argv to a single space-joined string. Map
  # NUL->space so both parse uniformly; profile paths carry no spaces.
  OBSERVED_DIR=""
  for pid in $(pgrep -f "remote-debugging-port=${PORT}" 2>/dev/null); do
    [[ -r "/proc/${pid}/cmdline" ]] || continue
    cmd="$(tr '\0' ' ' < "/proc/${pid}/cmdline")"
    # Exact port (lookahead rejects a longer numeric like 92220 for 9222).
    if grep -qP -- "--remote-debugging-port=${PORT}(?![0-9])" <<<"${cmd}"; then
      OBSERVED_DIR="$(grep -oP -- '--user-data-dir=\K\S+' <<<"${cmd}" | head -n1)"
      [[ -n "${OBSERVED_DIR}" ]] && break
    fi
  done
  if [[ -z "${OBSERVED_DIR}" ]]; then
    echo "error: CDP up on :${PORT} but no chrome process with --user-data-dir found — cannot attest profile" >&2
    exit 3
  fi
  EXP_CANON="$(realpath -m "${PROFILE}")"
  OBS_CANON="$(realpath -m "${OBSERVED_DIR}")"
  if [[ "${EXP_CANON}" != "${OBS_CANON}" ]]; then
    echo "error: CDP on :${PORT} is owned by a MISMATCHED profile — refusing to attach" >&2
    echo "  expected user-data-dir: ${EXP_CANON}" >&2
    echo "  observed user-data-dir: ${OBS_CANON}" >&2
    exit 3
  fi
  echo "CDP already up on :${PORT}: $(curl -s "http://127.0.0.1:${PORT}/json/version" | python3 -c "import sys,json; print(json.load(sys.stdin).get('Browser','?'))")"
  echo "profile=${PROFILE} (attested user-data-dir=${OBS_CANON})"
  exit 0
fi

# Secondary profiles: clone cookies from primary once (exclude Singleton locks).
if [[ "${PROFILE}" != "${PRIMARY}" && ! -d "${PROFILE}/Default" ]]; then
  echo "Seeding ${PROFILE} from ${PRIMARY} (cookies/session)…"
  mkdir -p "${PROFILE}"
  rsync -a --exclude='Singleton*' --exclude='lockfile' --exclude='.org.chromium.*' \
    "${PRIMARY}/" "${PROFILE}/" || true
fi

# Fail-closed if this profile lane is ACTIVELY leased (flock held by a live
# holder). Relaunching would kill an active session — the exact hazard the
# lane allocator exists to prevent (Fable adjudication, thread 4917).
LANE_LOCK="${HOME}/.gateway/cdp-lanes/${SUFFIX}.lock"
if [[ -n "${SUFFIX}" && -e "${LANE_LOCK}" ]] && ! flock -n "${LANE_LOCK}" true 2>/dev/null; then
  echo "error: profile '${SUFFIX}' is actively leased (${LANE_LOCK}) — refusing to relaunch an active lane" >&2
  exit 3
fi
# Kill ONLY the exact listener on this port (never a broad -f substring, which
# is one accident away from killing the wrong Chrome). Do NOT touch other ports.
LISTENER_PID="$(ss -ltnpH "sport = :${PORT}" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -n1)"
[[ -n "${LISTENER_PID}" ]] && kill "${LISTENER_PID}" 2>/dev/null || true
sleep 1
DISPLAY=:1 nohup google-chrome \
  --remote-debugging-port="${PORT}" \
  --remote-allow-origins=* \
  --user-data-dir="${PROFILE}" \
  --no-first-run \
  --no-default-browser-check \
  > "${LOG}" 2>&1 &
echo "Chrome PID: $!  port=${PORT}  profile=${PROFILE}"
for i in $(seq 1 20); do
  sleep 1
  if curl -sf "http://127.0.0.1:${PORT}/json/version" >/dev/null 2>&1; then
    echo "CDP ready on :${PORT} after ${i}s"
    curl -s "http://127.0.0.1:${PORT}/json/version" | python3 -c "import sys,json; print(json.load(sys.stdin).get('Browser','?'))"
    exit 0
  fi
done
echo "CDP failed on :${PORT} — tail ${LOG}" >&2
tail -15 "${LOG}" 2>/dev/null || true
exit 1
REMOTE
}

remote_py() {
  local script="$1"
  shift
  local qargs=()
  local a
  for a in "$@"; do
    qargs+=("$(printf '%q' "$a")")
  done
  # shellcheck disable=SC2029
  ssh "$SSH" "cd ${REMOTE_REPO} && PROJECT_ROOT=${REMOTE_REPO} PYTHONPATH=${REMOTE_REPO}/libs BROWSER_CDP_URL=http://127.0.0.1:${CDP_PORT} ${PY} ${script} ${qargs[*]}"
}

# 24911: local SSH abort trap — capture registration_id, ownership-safe cleanup.
_project_ask_reg_id=""
_project_ask_abort_trap() {
  local id="${_project_ask_reg_id}"
  [[ -z "${id}" ]] && return 0
  remote_py scripts/cortex/cowork_project_ask.py \
    --abort-cleanup-registration-id "${id}" >/dev/null 2>&1 || true
}

_project_ask_with_abort_trap() {
  _project_ask_reg_id=""
  local tmp rc
  tmp="$(mktemp)"
  trap '_project_ask_abort_trap' EXIT INT TERM
  set +e
  "$@" 2>&1 | tee "${tmp}"
  rc="${PIPESTATUS[0]}"
  set -e
  _project_ask_reg_id="$(grep -m1 '^registration_id=' "${tmp}" | sed 's/^registration_id=//' || true)"
  rm -f "${tmp}"
  if [[ "${rc}" -eq 0 ]]; then
    trap - EXIT INT TERM
    _project_ask_reg_id=""
  fi
  return "${rc}"
}

parse_chrome_flags "$@"
set -- "${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}"

cmd="${1:-}"
shift || true

# Parallel lanes MUST name the profile (24612) when hand-picking a port.
# Registry / --intent / --register paths own allocation — skip this gate.
_skip_suffix_gate=0
case "${cmd}" in
  register-lane|deregister-lane|list-lanes) _skip_suffix_gate=1 ;;
  project-ask)
    for a in "$@"; do
      case "$a" in
        --intent|--register|--registration-id|--no-register) _skip_suffix_gate=1; break ;;
      esac
    done
    # Default project-ask uses registry (no hand-picked port) — skip gate.
    if [[ "${CDP_PORT}" == "9222" && -z "${PROFILE_SUFFIX}" ]]; then
      _skip_suffix_gate=1
    fi
    ;;
esac
if [[ "${_skip_suffix_gate}" -eq 0 && "${CDP_PORT}" != "9222" && -z "${PROFILE_SUFFIX}" ]]; then
  echo "error: --port/--cdp-port ${CDP_PORT} requires explicit --profile-suffix" >&2
  echo "  examples: --port 9223 --profile-suffix ask" >&2
  echo "            --port 9224 --profile-suffix fable-consult" >&2
  echo "  preferred: project-ask --register (registry allocates port+profile)" >&2
  exit 2
fi

case "$cmd" in
  ensure-chrome)
    ensure_chrome "${CDP_PORT}" "${PROFILE_SUFFIX}"
    ;;
  status)
    ensure_chrome "${CDP_PORT}" "${PROFILE_SUFFIX}"
    remote_py scripts/cortex/upload_claude_bundles_ui.py --status
    ;;
  upload)
    # Soft preflight BEFORE ensure_chrome: refuse --all --replace unless
    # --force-replace-all (Python CLI is authoritative; catch footgun early).
    has_all=0
    has_replace=0
    has_force=0
    for a in "$@"; do
      case "$a" in
        --all) has_all=1 ;;
        --replace) has_replace=1 ;;
        --force-replace-all) has_force=1 ;;
      esac
    done
    if [[ "${has_all}" -eq 1 && "${has_replace}" -eq 1 && "${has_force}" -eq 0 ]]; then
      echo "error: --all --replace is refused by default (fleet-wide re-upload)." >&2
      echo "  Prefer: upload --slugs SLUG --replace" >&2
      echo "  Override: upload --all --replace --force-replace-all" >&2
      exit 2
    fi
    ensure_chrome "${CDP_PORT}" "${PROFILE_SUFFIX}"
    remote_py scripts/cortex/upload_claude_bundles_ui.py "$@"
    ;;
  uninstall)
    ensure_chrome "${CDP_PORT}" "${PROFILE_SUFFIX}"
    remote_py scripts/cortex/upload_claude_bundles_ui.py --uninstall "$@"
    ;;
  restore-connector)
    ensure_chrome "${CDP_PORT}" "${PROFILE_SUFFIX}"
    remote_py scripts/cortex/restore_claude_mcp_connector.py "$@"
    ;;
  project-chrome)
    ensure_chrome "${CDP_PORT}" "${PROFILE_SUFFIX}"
    remote_py scripts/cortex/cowork_project_chrome.py "$@"
    ;;
  register-lane)
    # Usage: register-lane --holder SEAT [--purpose ask]
    remote_py scripts/cortex/cdp_registry_cli.py register "$@"
    ;;
  deregister-lane)
    # Usage: deregister-lane --registration-id ID [--kill]
    remote_py scripts/cortex/cdp_registry_cli.py deregister "$@"
    ;;
  list-lanes)
    remote_py scripts/cortex/cdp_registry_cli.py list
    ;;
  project-ask)
    # Default: registry owns port+profile (--register on in cowork_project_ask).
    # Do NOT ensure_chrome / inject --cdp-url unless --no-register.
    has_intent=0
    has_no_register=0
    has_registration_id=0
    for a in "$@"; do
      [[ "$a" == "--intent" ]] && has_intent=1
      [[ "$a" == "--no-register" ]] && has_no_register=1
      [[ "$a" == "--registration-id" ]] && has_registration_id=1
    done
    if [[ "${has_intent}" -eq 1 || "${has_registration_id}" -eq 1 ]]; then
      remote_py scripts/cortex/cowork_project_ask.py "$@"
    elif [[ "${has_no_register}" -eq 1 ]]; then
      ensure_chrome "${CDP_PORT}" "${PROFILE_SUFFIX}"
      has_cdp=0
      for a in "$@"; do
        [[ "$a" == "--cdp-url" ]] && has_cdp=1
      done
      if [[ "${has_cdp}" -eq 0 ]]; then
        remote_py scripts/cortex/cowork_project_ask.py --cdp-url "http://127.0.0.1:${CDP_PORT}" "$@"
      else
        remote_py scripts/cortex/cowork_project_ask.py "$@"
      fi
    else
      _project_ask_with_abort_trap remote_py scripts/cortex/cowork_project_ask.py --register "$@"
    fi
    ;;
  -h|--help|help|'') usage 0 ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage 1
    ;;
esac
