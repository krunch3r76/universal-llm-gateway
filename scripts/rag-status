#!/usr/bin/env python3
"""RAG indexing status — snapshot, live tail, and failure management.

Usage:
    rag-status            # snapshot: current state
    rag-status --watch    # live tail via event-service WS
    rag-status --summary  # compact one-liner (for scripting)
    rag-status --failures # permanently skipped chunks (from property index DB)
    rag-status --reset    # clear pending journal + permanent extraction failures
    rag-status --pending  # show bounded pending sample from /indexing/status
"""

import argparse
import asyncio
import json
import socket
import sqlite3
import sys
import time
from collections.abc import AsyncIterator, Callable
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Any

try:
    from transport_utils.rag_client import make_sync_client, resolve_rag_base_url
except ModuleNotFoundError:
    make_sync_client = None
    resolve_rag_base_url = None

EVENT_QUERY_SOCKET = Path("/tmp/universal-protocol/events-query.sock")
EVENT_QUERY_URL = "http://localhost/v1/subscribe"
EVENT_QUERY_API_URL = "http://localhost/v1/query"
WATCH_INTERVAL = 1.5  # seconds between event service availability checks
WATCH_HEARTBEAT_SECONDS = 120.0
WS_RETRY_BASE_SECONDS = 1.0
WS_RETRY_MAX_SECONDS = 30.0
DB_PATH = Path.home() / ".rag" / "store" / "property_index.db"
_error_truncate_chars: int | None = 120
_DEFAULT_SAMPLE_LIMIT = 20
_MAX_SAMPLE_LIMIT = 100


@dataclass
class _WatchCursor:
    resume_seq: int | None = None


async def _iter_event_service_events(
    *,
    resume_seq: int | None,
    signal_filter: str = "rag.*",
) -> AsyncIterator[dict[str, Any]]:
    """Yield frames from event-service subscription over UDS WebSocket."""
    import aiohttp

    connector = aiohttp.UnixConnector(path=str(EVENT_QUERY_SOCKET))
    async with aiohttp.ClientSession(connector=connector) as session:
        async with session.ws_connect(EVENT_QUERY_URL) as ws:
            msg: dict[str, Any] = {
                "type": "subscribe",
                "filter": {"signal": signal_filter},
            }
            if resume_seq is not None:
                msg["resume_from"] = {"seq": resume_seq}
            await ws.send_json(msg)

            async for frame in ws:
                if frame.type == aiohttp.WSMsgType.TEXT:
                    try:
                        data = json.loads(frame.data)
                    except json.JSONDecodeError:
                        continue
                    yield data
                elif frame.type in (aiohttp.WSMsgType.CLOSED, aiohttp.WSMsgType.ERROR):
                    break


def _query_event_service(body: dict[str, Any]) -> dict[str, Any]:
    """Synchronous HTTP POST to event service over UDS."""
    import httpx

    transport = httpx.HTTPTransport(uds=str(EVENT_QUERY_SOCKET))
    with httpx.Client(transport=transport, timeout=10.0) as client:
        resp = client.post(EVENT_QUERY_API_URL, json=body)
        resp.raise_for_status()
        result = resp.json()
    return result if isinstance(result, dict) else {}


def _load_events() -> list[dict[str, Any]]:
    if not EVENT_QUERY_SOCKET.exists():
        return []

    body = {
        "type": "sql",
        "sql": (
            "SELECT * FROM ("
            "SELECT * FROM events WHERE signal LIKE 'rag.%' ORDER BY seq DESC LIMIT 1000"
            ") ORDER BY seq ASC"
        ),
        "limit": 1000,
    }
    try:
        result = _query_event_service(body)
    except Exception as e:
        print(f"⚠ Failed to query event service: {e}", flush=True)
        return []

    rows = result.get("rows", [])
    if not isinstance(rows, list):
        return []

    events: list[dict[str, Any]] = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        ev = dict(row)
        payload = ev.get("payload")
        if isinstance(payload, str):
            try:
                ev["payload"] = json.loads(payload)
            except json.JSONDecodeError:
                ev["payload"] = {}
        elif not isinstance(payload, dict):
            ev["payload"] = {}
        if "timestamp" not in ev and isinstance(ev.get("ts_iso"), str):
            ev["timestamp"] = ev["ts_iso"]

        events.append(ev)
    return events


def _basename(path: str) -> str:
    return Path(path).name


def _build_state(events: list[dict[str, Any]]) -> dict[str, Any]:
    """Derive current indexing state from the full event log."""
    started = False
    in_progress: dict[str, dict[str, Any]] = {}
    extracted_files: list[dict[str, Any]] = []
    indexed_files: list[dict[str, Any]] = []
    failed_files: list[dict[str, Any]] = []
    current_batch: str | None = None

    for ev in events:
        sig: str = ev.get("signal", "")
        p: dict[str, Any] = ev.get("payload", {})
        ts: str = ev.get("timestamp", "")

        match sig:
            case "rag.started":
                started = True
                in_progress = {}
                extracted_files = []
                indexed_files = []
                failed_files = []

            case "rag.extraction.batch.started":
                f: str = p.get("file", "")
                in_progress[f] = {
                    "file": f,
                    "chunk_count": p.get("chunk_count", 0),
                    "completed": 0,
                    "written": 0,
                    "started_ts": ts,
                }
                current_batch = f

            case "rag.extraction.completed":
                if current_batch and current_batch in in_progress:
                    in_progress[current_batch]["completed"] += 1

            case "rag.extraction.batch.completed":
                fname: str = p.get("file", "")
                entry: dict[str, Any] = {
                    "file": fname,
                    "chunk_count": p.get("chunk_count", 0),
                    "successful": p.get("successful", 0),
                    "written": p.get("written", 0),
                    "duration_seconds": p.get("duration_seconds", 0.0),
                    "ts": ts,
                }
                extracted_files.append(entry)
                in_progress.pop(fname, None)

            case "rag.file.indexed":
                indexed_files.append(
                    {
                        "file": p.get("file", ""),
                        "indexed": p.get("indexed", 0),
                        "deleted": p.get("deleted", 0),
                        "ts": ts,
                    }
                )

            case "rag.file.indexing.failed":
                entry: dict[str, Any] = {
                    "file": p.get("file", ""),
                    "error": p.get("error", "unknown"),
                    "ts": ts,
                }
                fail_model = p.get("model")
                if fail_model:
                    entry["model"] = fail_model
                failed_files.append(entry)

            case _:
                pass

    return {
        "started": started,
        "in_progress": in_progress,
        "extracted_files": extracted_files,
        "indexed_files": indexed_files,
        "failed_files": failed_files,
        "current_batch": current_batch,
    }


def _fmt_duration(secs: float) -> str:
    if secs < 60:
        return f"{secs:.1f}s"
    m, s = divmod(int(secs), 60)
    if m < 60:
        return f"{m}m{s:02d}s"
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}m{s:02d}s"


def _short_error(error: str) -> str:
    """Extract a short, informative error string from a full error message."""
    if "503 Service Unavailable" in error:
        return "503 embedding endpoint unavailable"
    if "502 Bad Gateway" in error:
        return "502 bad gateway"
    if "504 Gateway Timeout" in error:
        return "504 gateway timeout"
    if "ReadTimeout" in error:
        return "read timeout (model loading?)"
    if "ConnectError" in error:
        return "connection refused"
    if "extraction failed below threshold" in error:
        return "extraction below threshold"
    if "Single-item embedding failed" in error:
        return "embedding OOM (VRAM insufficient)"
    if "CUDA" in error and "out of memory" in error:
        return "CUDA OOM"
    # Generic: take first line, then cap width for one-line watch readability.
    first_line = error.split("\n")[0]
    if _error_truncate_chars is not None and len(first_line) > _error_truncate_chars:
        keep = max(0, _error_truncate_chars - 3)
        return first_line[:keep] + "..."
    return first_line


def _watch_print(line: str) -> None:
    """Flush watch-mode output immediately to avoid PTY buffering surprises."""
    print(line, flush=True)


def _print_snapshot(state: dict[str, Any]) -> None:
    if not state["started"]:
        print("RAG service not started (no rag.started event found)")
        return

    extracted = state["extracted_files"]
    indexed = state["indexed_files"]
    failed = state["failed_files"]
    in_prog = state["in_progress"]

    indexed_set = {f["file"] for f in indexed}
    failed_set = {f["file"] for f in failed}

    total_chunks = sum(f["chunk_count"] for f in extracted)
    total_written = sum(f["written"] for f in extracted)
    total_duration = sum(f["duration_seconds"] for f in extracted)

    status = "indexing" if in_prog else "idle"
    print(f"Status    : {status}")
    print(
        f"Extracted : {len(extracted)} files  |  {total_written}/{total_chunks} chunks"
    )
    print(f"Indexed   : {len(indexed)} files stored")
    if failed:
        print(f"Failed    : {len(failed)} files")
    if total_duration > 0:
        print(f"Time      : {_fmt_duration(total_duration)} total extraction time")
    print()

    if in_prog:
        print("In progress (extracting):")
        for f, info in in_prog.items():
            done = info["completed"]
            total = info["chunk_count"]
            bar_width = 20
            filled = int(bar_width * done / total) if total else 0
            bar = "█" * filled + "░" * (bar_width - filled)
            print(f"  [{bar}] {done}/{total}  {_basename(f)}")
        print()

    if extracted:
        print("Extracted files:")
        for f in extracted:
            fname = f["file"]
            ok = f["written"] == f["chunk_count"]
            if fname in indexed_set:
                mark = "✓"
                status_tag = "indexed"
            elif fname in failed_set:
                mark = "✗"
                fail_entry = next((ff for ff in failed if ff["file"] == fname), {})
                err = fail_entry.get("error", "")
                model_suffix = ""
                if "model" in fail_entry:
                    model_suffix = f"  model={fail_entry['model']}"
                status_tag = f"{_short_error(err)}{model_suffix}"
            elif ok:
                mark = "…"
                status_tag = "embedding"
            else:
                mark = "!"
                status_tag = f"{f['written']}/{f['chunk_count']} chunks"
            line = (
                f"  {mark} {_basename(fname):50s}"
                f"  {f['written']:>3}/{f['chunk_count']:<3}"
                f"  {_fmt_duration(f['duration_seconds']):>8s}"
                f"  {status_tag}"
            )
            print(line)


def _print_summary(state: dict[str, Any]) -> None:
    if not state["started"]:
        print("not_started")
        return
    extracted = state["extracted_files"]
    indexed = state["indexed_files"]
    failed = state["failed_files"]
    in_prog = state["in_progress"]
    total_written = sum(f["written"] for f in extracted)
    total_chunks = sum(f["chunk_count"] for f in extracted)
    status = "indexing" if in_prog else "idle"
    print(
        f"{status} extracted={len(extracted)} indexed={len(indexed)} "
        f"failed={len(failed)} chunks={total_written}/{total_chunks} "
        f"in_progress={len(in_prog)}"
    )


def _clamp_sample_limit(value: int) -> int:
    """Clamp requested status sample limit into endpoint-supported range."""
    return max(0, min(value, _MAX_SAMPLE_LIMIT))


def _fetch_indexing_status(url: str, sample_limit: int) -> dict[str, Any]:
    """Fetch unified indexing status from the live RAG admin endpoint.

    Returns a dict payload on success; exits non-zero on transport or HTTP
    failure so shell automation can detect degraded status checks.
    """
    normalized_limit = _clamp_sample_limit(sample_limit)
    try:
        if make_sync_client is not None:
            with make_sync_client(url=url, timeout=10.0) as client:
                response = client.get(
                    "/indexing/status",
                    params={"sample_limit": normalized_limit},
                )
                response.raise_for_status()
                payload = response.json()
                if isinstance(payload, dict):
                    return payload
                return {}
        return _fetch_indexing_status_fallback(url, normalized_limit)
    except Exception as exc:
        print(f"Failed to query /indexing/status at {url}: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc


def _fetch_indexing_status_fallback(url: str, sample_limit: int) -> dict[str, Any]:
    """Fallback status fetch without transport_utils/httpx dependency."""
    from http.client import HTTPConnection
    from urllib.request import Request, urlopen

    if url.startswith("unix://"):
        rest = url[7:].lstrip("/")
        uds_path = f"/{rest}" if rest else "/tmp/universal-protocol/rag.sock"

        class _UnixHTTPConnection(HTTPConnection):
            def __init__(self, path: str, timeout: float = 10.0) -> None:
                super().__init__("localhost", timeout=timeout)
                self._path = path

            def connect(self) -> None:  # pragma: no cover - exercised in CLI smoke
                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                sock.settimeout(self.timeout)
                sock.connect(self._path)
                self.sock = sock

        conn = _UnixHTTPConnection(uds_path, timeout=10.0)
        try:
            conn.request("GET", f"/indexing/status?sample_limit={sample_limit}")
            response = conn.getresponse()
            body = response.read().decode("utf-8")
            if response.status >= 400:
                raise RuntimeError(f"HTTP {response.status}: {body}")
            payload = json.loads(body)
            return payload if isinstance(payload, dict) else {}
        finally:
            conn.close()

    base = url.rstrip("/")
    endpoint = f"{base}/indexing/status?sample_limit={sample_limit}"
    request = Request(endpoint, method="GET")
    with urlopen(request, timeout=10.0) as response:
        body = response.read().decode("utf-8")
    payload = json.loads(body)
    return payload if isinstance(payload, dict) else {}


def _default_rag_url() -> str:
    """Resolve default RAG URL with transport_utils when available."""
    if resolve_rag_base_url is not None:
        try:
            return resolve_rag_base_url()
        except Exception:
            pass
    config_path = Path.home() / ".gateway" / "stargate.yaml"
    if not config_path.exists():
        return "unix:///tmp/universal-protocol/rag.sock"
    try:
        import yaml

        data = yaml.safe_load(config_path.read_text()) or {}
    except Exception:
        return "unix:///tmp/universal-protocol/rag.sock"
    rag = data.get("rag")
    if not isinstance(rag, dict):
        return "unix:///tmp/universal-protocol/rag.sock"
    host = rag.get("host")
    port_val = rag.get("port")
    if host is None or port_val is None or not str(host).strip():
        return "unix:///tmp/universal-protocol/rag.sock"
    try:
        port = int(port_val)
    except (TypeError, ValueError):
        return "unix:///tmp/universal-protocol/rag.sock"
    if not (1 <= port <= 65535):
        return "unix:///tmp/universal-protocol/rag.sock"
    return f"http://{host}:{port}"


def _print_status_snapshot(status: dict[str, Any]) -> None:
    """Render human-readable status snapshot from `/indexing/status` payload."""
    print("RAG Operational Status")
    print("======================")
    print("Pending count includes in-flight indexing; after idle it should be zero.")
    print()
    print(f"Pending work      : {int(status.get('pending_count', 0))}")
    print(f"Failed chunks     : {int(status.get('failed_extractions_count', 0))}")
    print(
        "Permanent failures: "
        f"{int(status.get('failed_extractions_permanent_count', 0))}"
    )
    if bool(status.get("chroma_available", True)):
        print(
            "Chroma chunks     : "
            f"{status.get('chunks', 0)} ({status.get('collection', 'unknown')})"
        )
    else:
        print(f"Chroma chunks     : degraded ({status.get('chroma_error', 'unknown')})")
    print(
        "Property index    : "
        f"{'available' if bool(status.get('property_index_available', False)) else 'degraded'}"
    )
    watchers = status.get("watchers", [])
    if isinstance(watchers, list) and watchers:
        print("\nWatchers:")
        for watcher in watchers:
            if not isinstance(watcher, dict):
                continue
            print(
                "  - "
                f"{watcher.get('path', '')} "
                f"(enabled={watcher.get('enabled', False)}, "
                f"reload_count={watcher.get('reload_count', 0)}, "
                f"error_count={watcher.get('error_count', 0)})"
            )


def _print_status_summary(status: dict[str, Any]) -> None:
    """Render compact one-line status suitable for scripts and shell checks."""
    chroma_state = "ok" if bool(status.get("chroma_available", True)) else "degraded"
    prop_state = (
        "ok" if bool(status.get("property_index_available", False)) else "degraded"
    )
    print(
        " ".join(
            [
                f"pending={int(status.get('pending_count', 0))}",
                f"failed={int(status.get('failed_extractions_count', 0))}",
                f"permanent={int(status.get('failed_extractions_permanent_count', 0))}",
                f"chunks={status.get('chunks', 'na')}",
                f"watchers={len(status.get('watchers', [])) if isinstance(status.get('watchers'), list) else 0}",
                f"chroma={chroma_state}",
                f"property_index={prop_state}",
            ]
        )
    )


def _print_status_pending(status: dict[str, Any]) -> None:
    """Print bounded pending sample from status payload."""
    sample = status.get("pending_sample", [])
    if not isinstance(sample, list) or not sample:
        print("No pending files.")
        return
    print(f"Pending sample: {len(sample)}")
    for source in sample:
        print(f"  {source}")
    if bool(status.get("pending_sample_truncated", False)):
        print("\n  (sample truncated; increase --sample-limit up to 100)")


def _print_failures() -> None:
    """Query the property index DB for permanently skipped chunks."""
    if not DB_PATH.exists():
        print(f"Property index DB not found: {DB_PATH}")
        print("RAG service may not have run yet.")
        return

    conn = sqlite3.connect(str(DB_PATH))
    try:
        cols = {row[1] for row in conn.execute("PRAGMA table_info(failed_extractions)")}
        has_permanent = "permanent" in cols

        if has_permanent:
            perm_rows = conn.execute(
                "SELECT source, chunk_id, attempt_count, recorded_at"
                " FROM failed_extractions WHERE permanent = 1"
                " ORDER BY source, chunk_id"
            ).fetchall()
            transient_rows = conn.execute(
                "SELECT source, COUNT(*) FROM failed_extractions"
                " WHERE permanent = 0 GROUP BY source ORDER BY source"
            ).fetchall()
        else:
            perm_rows = []
            transient_rows = conn.execute(
                "SELECT source, COUNT(*) FROM failed_extractions"
                " GROUP BY source ORDER BY source"
            ).fetchall()

        total_perm = len(perm_rows)
        total_transient = sum(r[1] for r in transient_rows)

        print(f"Permanently skipped : {total_perm} chunks")
        print(f"Transient failures  : {total_transient} chunks (will retry)")
        if not has_permanent:
            print(
                "  (note: DB predates permanent column — "
                "retry vs permanent distinction unavailable)"
            )
        print()

        if perm_rows:
            by_file: dict[str, list[tuple[str, int, str]]] = {}
            for source, chunk_id, attempt_count, recorded_at in perm_rows:
                by_file.setdefault(source, []).append(
                    (chunk_id, attempt_count, recorded_at)
                )

            print("Permanently skipped by file:")
            for source, chunks in by_file.items():
                print(f"  {_basename(source)}  ({len(chunks)} chunks)")
                for chunk_id, attempt_count, recorded_at in chunks:
                    ts_str = recorded_at[:16] if recorded_at else "?"
                    print(f"    {chunk_id}  attempts={attempt_count}  last={ts_str}")
            print()

        if transient_rows:
            print("Files with transient failures (retrying):")
            for source, count in transient_rows:
                print(f"  {_basename(source):50s}  {count} chunk(s)")
    finally:
        conn.close()


def _print_pending() -> None:
    """Show files stuck in the pending journal."""
    if not DB_PATH.exists():
        print(f"Property index DB not found: {DB_PATH}")
        return

    conn = sqlite3.connect(str(DB_PATH))
    try:
        rows = conn.execute("SELECT file FROM pending ORDER BY file").fetchall()
        if not rows:
            print("No pending files.")
            return
        print(f"Pending files: {len(rows)}")
        print()
        for (f,) in rows:
            exists = Path(f).exists()
            mark = " " if exists else "✗"
            print(f"  {mark} {_basename(f)}")
        missing = sum(1 for (f,) in rows if not Path(f).exists())
        if missing:
            print(f"\n  ({missing} files no longer exist on disk)")
    finally:
        conn.close()


def _reset() -> None:
    """Clear pending journal and permanent extraction failures."""
    if not DB_PATH.exists():
        print(f"Property index DB not found: {DB_PATH}")
        return

    conn = sqlite3.connect(str(DB_PATH))
    try:
        pending_count = conn.execute("SELECT COUNT(*) FROM pending").fetchone()[0]
        conn.execute("DELETE FROM pending")

        cols = {row[1] for row in conn.execute("PRAGMA table_info(failed_extractions)")}
        perm_count = 0
        if "permanent" in cols:
            perm_count = conn.execute(
                "SELECT COUNT(*) FROM failed_extractions WHERE permanent = 1"
            ).fetchone()[0]
            conn.execute("DELETE FROM failed_extractions WHERE permanent = 1")
        else:
            perm_count = conn.execute(
                "SELECT COUNT(*) FROM failed_extractions"
            ).fetchone()[0]
            conn.execute("DELETE FROM failed_extractions")

        conn.commit()
        print(f"Cleared {pending_count} pending entries")
        print(f"Cleared {perm_count} permanent extraction failures")
        print()
        print("On next RAG restart, all watched files will be re-evaluated")
        print("by _initial_reindex (unchanged files skip quickly via hash check).")
    finally:
        conn.close()


@dataclass
class _SweepState:
    total_files: int = 0
    processed: int = 0
    reindexed: int = 0
    unchanged: int = 0
    errors: int = 0
    started_seen: bool = False
    completed_seen: bool = False


def _render_sweep_line(ts: str, mark: str, path: str, state: _SweepState) -> str:
    remaining = max(0, state.total_files - state.processed)
    return (
        f"{ts}  [{mark}]  {_basename(path)}  "
        f"{state.processed}/{state.total_files} processed  "
        f"({state.reindexed} reindexed, {state.unchanged} unchanged, {state.errors} errors)  "
        f"{remaining} remaining"
    )


def _parse_ts(ts: str) -> float:
    if not ts or "T" not in ts:
        return 0.0
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        return dt.timestamp()
    except (ValueError, TypeError):
        return 0.0


def _as_float(value: Any) -> float | None:
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def _as_int(value: Any) -> int | None:
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def _file_index_duration_seconds(
    payload: dict[str, Any],
    indexed_ts: str,
    batch_start_by_file: dict[str, float] | None = None,
) -> float | None:
    """Per-file effective index duration from Stargate metadata.

    Fallback order:
    1) payload.duration_seconds when > 0
    2) indexed_ts - payload.batch_start_ts
    3) indexed_ts - batch_start_by_file[file] (local watch-mode fallback)
    """
    direct = _as_float(payload.get("duration_seconds"))
    if direct is not None and direct > 0:
        return direct

    batch_start = payload.get("batch_start_ts")
    if batch_start and indexed_ts:
        start = _parse_ts(batch_start)
        end = _parse_ts(indexed_ts)
        if start > 0 and end > 0:
            return max(0.0, end - start)
    if batch_start_by_file is not None and indexed_ts:
        path = payload.get("file", "")
        if path:
            start = batch_start_by_file.get(path)
            end = _parse_ts(indexed_ts)
            if start is not None and end > 0:
                return max(0.0, end - start)
    return None


def _inference_to_index_seconds(
    *,
    queue_wait_seconds: float | None,
    processing_seconds: float | None,
    wall_seconds: float | None,
    extract_seconds: float | None,
) -> float | None:
    """Duration from first inference start (post-queue) to file indexed.

    Preferred path uses wall-clock duration and queue wait:
    inference_to_index = wall_seconds - queue_wait_seconds.

    Fallback path combines pipeline post-queue processing and index tail:
    inference_to_index = processing_seconds + (wall_seconds - extract_seconds).
    """
    if wall_seconds is not None and queue_wait_seconds is not None:
        return max(0.0, wall_seconds - max(0.0, queue_wait_seconds))

    if (
        wall_seconds is not None
        and processing_seconds is not None
        and extract_seconds is not None
    ):
        tail = max(0.0, wall_seconds - max(0.0, extract_seconds))
        return max(0.0, processing_seconds + tail)

    if processing_seconds is not None:
        return max(0.0, processing_seconds)

    return None


def _render_watch_event(
    ev: dict[str, Any],
    *,
    emit: Callable[[str], None],
    dir_start_ts: float | None,
    batch_start_by_file: dict[str, float],
    batch_active: bool,
    batch_seen_activity: bool,
    inflight_files: set[str],
    extract_secs_by_file: dict[str, float],
    pending_extract_starts_ref: list[int],
    batch_done: int,
    batch_failed: int,
    batch_skipped: int,
    batch_effective_secs: float,
    sweep_by_path: dict[str, _SweepState],
    on_reset: Callable[[], None],
    on_start_batch: Callable[[str, str, str], None],
    on_complete_batch: Callable[[str], None],
) -> tuple[float | None, bool, bool, int, int, int, float, int | None]:
    """Render one watch event and return updated counters plus optional seq cursor."""
    sig = ev.get("signal", "")
    p = ev.get("payload", {})
    if not isinstance(p, dict):
        p = {}

    ts_unix_ms = _as_int(ev.get("ts_unix_ms"))
    ts_text = ev.get("timestamp", "")
    if ts_text:
        ts = ts_text[:19].replace("T", " ")
    elif ts_unix_ms is not None:
        ts = datetime.fromtimestamp(ts_unix_ms / 1000).strftime("%Y-%m-%d %H:%M:%S")
    else:
        ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ts_full = ts_text

    seq = _as_int(ev.get("seq"))

    if sig == "rag.article.upserted":
        src = _basename(p.get("source_path", ""))
        action = "created" if bool(p.get("created")) else "updated"
        h = str(p.get("content_hash", ""))
        h_short = h[:12] + "..." if len(h) > 12 else h
        emit(f"{ts}  [ARTICLE ]  {src}  {action}  hash={h_short}")
        return (
            dir_start_ts,
            batch_active,
            batch_seen_activity,
            batch_done,
            batch_failed,
            batch_skipped,
            batch_effective_secs,
            seq,
        )

    match sig:
        case "rag.started":
            dir_start_ts = None
            batch_start_by_file.clear()
            batch_active = False
            sweep_by_path.clear()
            on_reset()
            emit(f"{ts}  [START   ]  RAG service started")
            return (None, False, False, 0, 0, 0, 0.0, seq)

        case "rag.directory.index.started":
            total_files = _as_int(p.get("total_files"))
            if batch_active:
                on_complete_batch(ts)
            files_label = (
                str(total_files)
                if total_files is not None and total_files >= 0
                else "?"
            )
            on_start_batch(ts, sig, files_label)
            if total_files == 0:
                batch_seen_activity = True
            if ts_full:
                dir_start_ts = _parse_ts(ts_full)
            batch_start_by_file.clear()
            nfiles = p.get("total_files", 0)
            emit(f"{ts}  [DIR     ]  directory index started  ({nfiles} files)")
            return (
                dir_start_ts,
                True,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.extraction.batch.started":
            path = p.get("file", "")
            if not batch_active:
                on_start_batch(ts, sig, "?")
            batch_seen_activity = True
            pending_extract_starts_ref[0] += 1
            if path:
                inflight_files.add(path)
            if path and ts_full:
                t = _parse_ts(ts_full)
                if t > 0:
                    batch_start_by_file[path] = t
            n = p.get("chunk_count", 0)
            emit(f"{ts}  [EXTRACT ]  {_basename(path)}  ({n} chunks)")
            return (
                dir_start_ts,
                True,
                True,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.extraction.batch.completed":
            fname = p.get("file", "")
            batch_seen_activity = True
            pending_extract_starts_ref[0] = max(0, pending_extract_starts_ref[0] - 1)
            extract_secs = _as_float(p.get("duration_seconds"))
            if fname:
                inflight_files.add(fname)
            if fname and extract_secs is not None and extract_secs >= 0:
                extract_secs_by_file[fname] = extract_secs
            w = p.get("written", 0)
            n = p.get("chunk_count", 0)
            file_duration = (
                extract_secs if extract_secs is not None and extract_secs >= 0 else 0.0
            )
            d = _fmt_duration(file_duration)
            ok = w == n
            mark = "✓" if ok else "!"
            since_start = ""
            if dir_start_ts is not None and ts_full:
                end_ts = _parse_ts(ts_full)
                if end_ts > 0:
                    since_start = (
                        f"  {_fmt_duration(end_ts - dir_start_ts)} since dir start"
                    )
            fail_count = n - w if n > w else 0
            fail_note = ""
            if fail_count:
                fail_note = (
                    f"  ({fail_count} extraction"
                    f" {'failure' if fail_count == 1 else 'failures'})"
                )
            emit(
                f"{ts}  [{mark} CHUNK ]  "
                f"{_basename(fname)}  "
                f"{w}/{n} chunks  "
                f"{d}{since_start}{fail_note}"
            )
            return (
                dir_start_ts,
                batch_active,
                True,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.file.indexed":
            idx = p.get("indexed", 0)
            noise_n = p.get("noise_chunks", p.get("bibliography_chunks", 0))
            path = p.get("file", "")
            extract_secs = extract_secs_by_file.get(path) if path else None
            proc_secs = _as_float(p.get("processing_seconds"))
            queue_wait_secs = _as_float(p.get("queue_wait_seconds"))
            fallback_dur = _file_index_duration_seconds(p, ts_full, batch_start_by_file)
            payload_dur = _as_float(p.get("duration_seconds"))
            wall_secs = (
                fallback_dur
                if fallback_dur is not None
                else (payload_dur if payload_dur is not None else None)
            )
            if wall_secs is not None:
                wall_secs = max(0.0, wall_secs)

            display_secs = wall_secs
            if display_secs is None and proc_secs is not None:
                display_secs = max(0.0, proc_secs)
            if display_secs is None:
                display_secs = 0.0
            d = _fmt_duration(display_secs)
            breakdown = ""
            if extract_secs is not None:
                tail_source = wall_secs if wall_secs is not None else display_secs
                tail_secs = max(0.0, tail_source - max(0.0, extract_secs))
                breakdown = (
                    f"  (extract {_fmt_duration(extract_secs)} "
                    f"+ tail {_fmt_duration(tail_secs)})"
                )
            if queue_wait_secs is not None and queue_wait_secs > 0:
                breakdown += f"; queue {_fmt_duration(queue_wait_secs)}"
            infer_to_index_secs = _inference_to_index_seconds(
                queue_wait_seconds=queue_wait_secs,
                processing_seconds=proc_secs,
                wall_seconds=wall_secs,
                extract_seconds=extract_secs,
            )
            if infer_to_index_secs is not None:
                breakdown += f"; infer→index {_fmt_duration(infer_to_index_secs)}"
            if path:
                batch_start_by_file.pop(path, None)
            noise_note = f"  ({noise_n} noise)" if noise_n else ""
            emit(
                f"{ts}  [✓ DONE  ]  "
                f"{_basename(path)}  "
                f"{idx} chunks stored  "
                f"{d}{breakdown}{noise_note}"
            )
            new_done = batch_done + (1 if batch_active else 0)
            new_effective = (
                batch_effective_secs + display_secs
                if batch_active
                else batch_effective_secs
            )
            if batch_active:
                batch_seen_activity = True
            if path:
                inflight_files.discard(path)
                extract_secs_by_file.pop(path, None)
            on_complete_batch(ts)
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                new_done,
                batch_failed,
                batch_skipped,
                new_effective,
                seq,
            )

        case "rag.file.indexing.failed":
            path = p.get("file", "")
            error = p.get("error", "unknown")
            fail_model = p.get("model", "")
            short = _short_error(error)
            model_tag = f"  model={fail_model}" if fail_model else ""
            emit(f"{ts}  [✗ FAIL  ]  {_basename(path)}  {short}{model_tag}")
            new_failed = batch_failed + (1 if batch_active else 0)
            if path:
                inflight_files.discard(path)
                extract_secs_by_file.pop(path, None)
            on_complete_batch(ts)
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                new_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.extraction.failed":
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case _ if sig in {
            "rag.file.indexing.skipped",
            "rag.file.skipped",
        }:
            path = p.get("file", "")
            reason = p.get("reason", "skipped")
            # Per-file unchanged skips dominate follow-mode output; keep them in
            # batch counts but suppress the individual line.
            if reason != "unchanged":
                emit(f"{ts}  [↷ SKIP  ]  {_basename(path)}  {reason}")
            new_skipped = batch_skipped + (1 if batch_active else 0)
            if path:
                inflight_files.discard(path)
                extract_secs_by_file.pop(path, None)
            on_complete_batch(ts)
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                new_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.extraction.permanently.skipped":
            cid = p.get("chunk_id", "?")
            src = _basename(p.get("source", "?"))
            att = p.get("attempt_count", "?")
            emit(f"{ts}  [PERM ✗  ]  {src}  chunk={cid}  attempts={att}")
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.extraction.completed":
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.pending.reconciled":
            r = p.get("reconciled", 0)
            c = p.get("cleared", 0)
            ft = p.get("failed_transient", 0)
            fp = p.get("failed_permanent", 0)
            emit(
                f"{ts}  [RECONC  ]  "
                f"{r} reconciled  "
                f"{c} cleared  "
                f"{ft} transient  "
                f"{fp} permanent"
            )
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.watch.initial.started":
            path = p.get("path", "")
            total = _as_int(p.get("total_files"))
            if not path or total is None or total < 0:
                emit(f"{ts}  [SWEEP ! ]  {_basename(path)}  invalid progress payload")
                return (
                    dir_start_ts,
                    batch_active,
                    batch_seen_activity,
                    batch_done,
                    batch_failed,
                    batch_skipped,
                    batch_effective_secs,
                    None,
                )
            state = _SweepState()
            state.total_files = total
            state.started_seen = True
            sweep_by_path[path] = state
            emit(_render_sweep_line(ts, "SWEEP→ ", path, state))
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.watch.initial.progress":
            path = p.get("path", "")
            total = _as_int(p.get("total_files"))
            processed = _as_int(p.get("processed"))
            reindexed = _as_int(p.get("reindexed"))
            unchanged = _as_int(p.get("unchanged"))
            errors = _as_int(p.get("errors"))
            state = sweep_by_path.get(path)
            invalid = (
                not path
                or total is None
                or processed is None
                or reindexed is None
                or unchanged is None
                or errors is None
                or total < 0
                or processed < 0
                or reindexed < 0
                or unchanged < 0
                or errors < 0
                or processed != (reindexed + unchanged + errors)
                or processed > total
                or (
                    state is not None
                    and state.started_seen
                    and total != state.total_files
                )
                or (state is not None and processed < state.processed)
            )
            if invalid:
                emit(f"{ts}  [SWEEP ! ]  {_basename(path)}  invalid progress payload")
                return (
                    dir_start_ts,
                    batch_active,
                    batch_seen_activity,
                    batch_done,
                    batch_failed,
                    batch_skipped,
                    batch_effective_secs,
                    None,
                )
            assert (
                total is not None
                and processed is not None
                and reindexed is not None
                and unchanged is not None
                and errors is not None
            )
            if state is None:
                state = _SweepState()
            if not state.started_seen:
                state.started_seen = True
                state.total_files = total
                emit(_render_sweep_line(ts, "SWEEP→ ", path, state))
            if processed == state.processed:
                return (
                    dir_start_ts,
                    batch_active,
                    batch_seen_activity,
                    batch_done,
                    batch_failed,
                    batch_skipped,
                    batch_effective_secs,
                    seq,
                )
            state.total_files = total
            state.processed = processed
            state.reindexed = reindexed
            state.unchanged = unchanged
            state.errors = errors
            sweep_by_path[path] = state
            emit(_render_sweep_line(ts, "SWEEP→ ", path, state))
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.watch.initial.complete":
            path = p.get("path", "")
            files = _as_int(p.get("files"))
            reindexed = _as_int(p.get("reindexed"))
            unchanged = _as_int(p.get("unchanged"))
            state = sweep_by_path.get(path)
            if (
                not path
                or files is None
                or reindexed is None
                or unchanged is None
                or files < 0
                or reindexed < 0
                or unchanged < 0
            ):
                emit(f"{ts}  [SWEEP ! ]  {_basename(path)}  invalid progress payload")
                return (
                    dir_start_ts,
                    batch_active,
                    batch_seen_activity,
                    batch_done,
                    batch_failed,
                    batch_skipped,
                    batch_effective_secs,
                    None,
                )
            assert files is not None and reindexed is not None and unchanged is not None
            if state is None:
                state = _SweepState(total_files=files, started_seen=True)
            if state.completed_seen:
                return (
                    dir_start_ts,
                    batch_active,
                    batch_seen_activity,
                    batch_done,
                    batch_failed,
                    batch_skipped,
                    batch_effective_secs,
                    seq,
                )
            if state.total_files < files:
                state.total_files = files
            state.reindexed = reindexed
            state.unchanged = unchanged
            state.processed = max(
                state.processed,
                state.reindexed + state.unchanged + state.errors,
            )
            if state.processed > state.total_files:
                state.total_files = state.processed
            state.completed_seen = True
            sweep_by_path[path] = state
            line = _render_sweep_line(ts, "SWEEP✓ ", path, state)
            line = line.rsplit(" ", 2)[0] + "  0 remaining"
            emit(line)
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.post.index.stale":
            steps = p.get("stale_steps", [])
            emit(f"{ts}  [⚠ STALE ]  post-index steps overdue: {', '.join(steps)}")
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.orphan.purged":
            files = p.get("files", 0)
            chunks = p.get("chunks", 0)
            sources = p.get("sources", [])
            if files > 0:
                detail = f": {', '.join(sources)}" if sources else ""
                emit(
                    f"{ts}  [ORPHAN  ]  purged {files} missing files ({chunks} chunks){detail}"
                )
            else:
                emit(f"{ts}  [ORPHAN  ]  no missing files")
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case "rag.exclusion.purged":
            files = p.get("files", 0)
            chunks = p.get("chunks", 0)
            sources = p.get("sources", [])
            if files > 0:
                detail = f": {', '.join(sources)}" if sources else ""
                emit(
                    f"{ts}  [EXCLUDE ]  purged {files} excluded files ({chunks} chunks){detail}"
                )
            else:
                emit(f"{ts}  [EXCLUDE ]  no excluded files to purge")
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )

        case _:
            if sig.startswith("rag."):
                emit(f"{ts}  [{sig}]  {json.dumps(p)}")
            return (
                dir_start_ts,
                batch_active,
                batch_seen_activity,
                batch_done,
                batch_failed,
                batch_skipped,
                batch_effective_secs,
                seq,
            )


async def _watch_mode_async() -> None:
    """Stream watch events from event-service WebSocket only."""
    cursor = _WatchCursor()
    had_ws_session = False
    backoff = WS_RETRY_BASE_SECONDS
    waiting_for_socket = False
    last_event_at = time.monotonic()
    idle_heartbeat_emitted = False

    dir_start_ts: float | None = None
    batch_start_by_file: dict[str, float] = {}
    batch_id = 0
    batch_active = False
    batch_seen_activity = False
    inflight_files: set[str] = set()
    extract_secs_by_file: dict[str, float] = {}
    pending_extract_starts = 0
    pending_extract_starts_ref: list[int] = [0]
    batch_done = 0
    batch_failed = 0
    batch_skipped = 0
    batch_effective_secs = 0.0
    sweep_by_path: dict[str, _SweepState] = {}

    def _emit_watch_line(line: str) -> None:
        _watch_print(line)

    def _reset_batch_counters() -> None:
        nonlocal batch_seen_activity, pending_extract_starts, batch_done
        nonlocal batch_failed, batch_skipped, batch_effective_secs
        batch_seen_activity = False
        pending_extract_starts = 0
        pending_extract_starts_ref[0] = 0
        batch_done = 0
        batch_failed = 0
        batch_skipped = 0
        batch_effective_secs = 0.0
        inflight_files.clear()
        extract_secs_by_file.clear()

    def _start_batch(ts: str, trigger: str, files_label: str) -> None:
        nonlocal batch_id, batch_active
        batch_id += 1
        batch_active = True
        _reset_batch_counters()
        _emit_watch_line(
            f"{ts}  [BATCH↑ ]  batch #{batch_id} started  trigger={trigger}  files={files_label}"
        )

    def _complete_batch_if_ready(ts: str) -> None:
        nonlocal batch_active
        if not batch_active or inflight_files or pending_extract_starts_ref[0] > 0:
            return
        if not batch_seen_activity:
            return
        _emit_watch_line(
            f"{ts}  [BATCH✓ ]  batch #{batch_id} completed  "
            f"done={batch_done} failed={batch_failed} skipped={batch_skipped}  "
            f"total_effective={_fmt_duration(batch_effective_secs)}"
        )
        batch_active = False

    async def _idle_heartbeat_loop() -> None:
        nonlocal idle_heartbeat_emitted
        while True:
            await asyncio.sleep(WATCH_INTERVAL)
            if waiting_for_socket:
                continue
            idle_seconds = max(0.0, time.monotonic() - last_event_at)
            if idle_seconds < WATCH_HEARTBEAT_SECONDS or idle_heartbeat_emitted:
                continue
            idle_heartbeat_emitted = True
            ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            _emit_watch_line(
                f"{ts}  [IDLE    ]  {_fmt_duration(idle_seconds)} since last rag event"
            )

    async def _consume_event(ev: dict[str, Any]) -> None:
        nonlocal dir_start_ts, batch_active, batch_seen_activity, batch_done
        nonlocal \
            batch_failed, \
            batch_skipped, \
            batch_effective_secs, \
            pending_extract_starts, \
            last_event_at, \
            idle_heartbeat_emitted
        last_event_at = time.monotonic()
        idle_heartbeat_emitted = False
        pending_extract_starts_ref[0] = pending_extract_starts
        updated = _render_watch_event(
            ev,
            emit=_emit_watch_line,
            dir_start_ts=dir_start_ts,
            batch_start_by_file=batch_start_by_file,
            batch_active=batch_active,
            batch_seen_activity=batch_seen_activity,
            inflight_files=inflight_files,
            extract_secs_by_file=extract_secs_by_file,
            pending_extract_starts_ref=pending_extract_starts_ref,
            batch_done=batch_done,
            batch_failed=batch_failed,
            batch_skipped=batch_skipped,
            batch_effective_secs=batch_effective_secs,
            sweep_by_path=sweep_by_path,
            on_reset=_reset_batch_counters,
            on_start_batch=_start_batch,
            on_complete_batch=_complete_batch_if_ready,
        )
        (
            dir_start_ts,
            batch_active,
            batch_seen_activity,
            batch_done,
            batch_failed,
            batch_skipped,
            batch_effective_secs,
            seq,
        ) = updated
        pending_extract_starts = pending_extract_starts_ref[0]
        if seq is not None:
            cursor.resume_seq = seq

    heartbeat_task = asyncio.create_task(_idle_heartbeat_loop())
    try:
        while True:
            if not EVENT_QUERY_SOCKET.exists():
                if not waiting_for_socket:
                    _emit_watch_line(
                        f"Waiting for event service socket {EVENT_QUERY_SOCKET} ..."
                    )
                    waiting_for_socket = True
                await asyncio.sleep(WATCH_INTERVAL)
                continue
            waiting_for_socket = False

            try:
                async for ev in _iter_event_service_events(
                    resume_seq=cursor.resume_seq
                ):
                    if ev.get("type") == "subscribed":
                        had_ws_session = True
                        backoff = WS_RETRY_BASE_SECONDS
                        last_event_at = time.monotonic()
                        idle_heartbeat_emitted = False
                        _emit_watch_line("subscribed (waiting for rag.* events)")
                        continue
                    await _consume_event(ev)
                had_ws_session = True
                backoff = WS_RETRY_BASE_SECONDS
            except OSError as e:
                if had_ws_session:
                    _emit_watch_line(
                        f"⚠ Event service disconnected ({e}), retrying WebSocket stream"
                    )
                else:
                    _emit_watch_line(
                        f"⚠ Event service unavailable ({e}), retrying WebSocket stream"
                    )
                await asyncio.sleep(backoff)
                backoff = min(WS_RETRY_MAX_SECONDS, backoff * 2.0)
                continue
            except ModuleNotFoundError as e:
                _emit_watch_line(f"⚠ Missing dependency for watch mode: {e}")
                raise
            except Exception as e:
                _emit_watch_line(f"⚠ Unexpected error in watch stream: {e}")
                raise
    finally:
        heartbeat_task.cancel()
        try:
            await heartbeat_task
        except asyncio.CancelledError:
            pass


def _watch_mode() -> None:
    """Sync wrapper for async watch mode."""
    try:
        asyncio.run(_watch_mode_async())
    except KeyboardInterrupt:
        print("\nStopped.")


def main() -> None:
    global _error_truncate_chars

    parser = argparse.ArgumentParser(
        description="RAG indexing status",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    group = parser.add_mutually_exclusive_group()
    _ = group.add_argument(
        "--watch",
        "-w",
        action="store_true",
        help="live tail via event-service WS",
    )
    _ = group.add_argument(
        "--summary",
        "-s",
        action="store_true",
        help="compact one-liner for scripting",
    )
    _ = group.add_argument(
        "--failures",
        "-f",
        action="store_true",
        help="show permanently skipped chunks from the property index DB",
    )
    _ = group.add_argument(
        "--pending",
        "-p",
        action="store_true",
        help="show bounded pending sample from /indexing/status",
    )
    _ = group.add_argument(
        "--reset",
        action="store_true",
        help="clear pending journal + permanent extraction failures (run with RAG stopped)",
    )
    _ = parser.add_argument(
        "--full-errors",
        action="store_true",
        help="show full error text in status/watch output (no truncation)",
    )
    _ = parser.add_argument(
        "--json",
        action="store_true",
        help="emit raw /indexing/status JSON (default/summary/pending paths)",
    )
    _ = parser.add_argument(
        "--url",
        default=_default_rag_url(),
        help="override RAG base URL (defaults to stargate.yaml resolution)",
    )
    _ = parser.add_argument(
        "--sample-limit",
        type=int,
        default=_DEFAULT_SAMPLE_LIMIT,
        help="pending sample limit for /indexing/status (0-100)",
    )
    args = parser.parse_args()
    if args.full_errors:
        _error_truncate_chars = None

    if args.watch:
        _watch_mode()
        return
    if args.failures:
        _print_failures()
        return
    if args.reset:
        _reset()
        return

    sample_limit = _clamp_sample_limit(args.sample_limit)
    if args.summary:
        status = _fetch_indexing_status(args.url, 0)
        if args.json:
            print(json.dumps(status, indent=2, sort_keys=True))
            return
        _print_status_summary(status)
        return
    if args.pending:
        status = _fetch_indexing_status(args.url, sample_limit)
        if args.json:
            print(json.dumps(status, indent=2, sort_keys=True))
            return
        _print_status_pending(status)
        return

    status = _fetch_indexing_status(args.url, sample_limit)
    if args.json:
        print(json.dumps(status, indent=2, sort_keys=True))
        return
    _print_status_snapshot(status)


if __name__ == "__main__":
    main()
