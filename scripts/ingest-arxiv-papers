#!/usr/bin/env python3
"""Download and ingest arXiv papers into the RAG corpus.

Downloads PDFs from arXiv and ingests them via pipeline_test ingest-papers,
preserving publication dates as metadata for recency-aware retrieval.

Usage:
  scripts/ingest-arxiv-papers [--dry-run] [--corpus-dir PATH]
"""

from __future__ import annotations

import argparse
import subprocess
import sys
import time
from pathlib import Path

import httpx

# Papers curated for relevance to large-LLM prompting and consensus pipeline work.
# Format: (arxiv_id, published_date, slug, category)
