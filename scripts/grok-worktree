#!/usr/bin/env bash
# Ad-hoc grok-direct worktree bootstrap via local git (grokbuild-worker retired).
set -euo pipefail

WORKTREE_ROOT="${WORKTREE_ROOT:-/mnt/torus/projects/ulg-grok-worktrees}"

usage() {
  echo "Usage: scripts/grok-worktree <name> [<branch>]" >&2
  echo "WORKTREE_ROOT=${WORKTREE_ROOT}" >&2
  exit 1
}

[[ $# -ge 1 && $# -le 2 ]] || usage

name="$1"
source_repo="$(pwd)"
branch="${2:-$(git -C "$source_repo" rev-parse --abbrev-ref HEAD)}"
worktree_path="${WORKTREE_ROOT}/${name}"

if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "invalid worktree name: ${name}" >&2
  exit 1
fi

if [[ -e "$worktree_path" ]]; then
  echo "worktree path already exists: ${worktree_path}" >&2
  exit 1
fi

mkdir -p "$WORKTREE_ROOT"
git -C "$source_repo" worktree add "$worktree_path" "$branch"

echo "$worktree_path"
cd "$worktree_path"
exec grok
