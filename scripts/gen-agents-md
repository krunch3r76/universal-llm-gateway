#!/usr/bin/env python3
"""Generate the MCP surface block of AGENTS.md from mcp-registry.toml.

Reads the canonical `mcp-registry.toml` at the workspace root and emits the
Grok `~/.grok/config.toml` TOML block that belongs in the AGENTS.md
§"MCP surface" section.

Usage:
    scripts/gen-agents-md [--registry mcp-registry.toml] [--target grok-direct]

Output (stdout): TOML block ready to paste into AGENTS.md § MCP surface,
or to write directly to ~/.grok/config.toml when piped with --raw.

Flags:
    --registry PATH   Path to mcp-registry.toml (default: mcp-registry.toml
                      relative to the workspace root, detected via git).
    --target TARGET   Projection target class (default: grok-direct).
    --raw             Emit bare TOML (no markdown fences). Suitable for
                      appending to ~/.grok/config.toml directly.
    --check           Exit non-zero if the generated output differs from the
                      MCP surface block already in AGENTS.md (CI diff gate).
"""

from __future__ import annotations

import argparse
import subprocess
import sys
import tomllib
from pathlib import Path
from typing import Any

_SCHEMA_VERSION = "1"
_RECURSION_DEPTH_LIMIT = 2  # MQ3 invariant — mirrors worker enforcement


def _workspace_root() -> Path:
    """Return workspace root by walking up to the git root."""
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
        return Path(out)
    except subprocess.CalledProcessError:
        return Path.cwd()


def _load_registry(path: Path) -> dict[str, Any]:
    with path.open("rb") as f:
        return tomllib.load(f)


def _warn_if_exclude_for(server: dict[str, Any], target: str) -> str | None:
    """Return a WARNING comment string when tool exclusions require server-side enforcement."""
    excluded = server.get("tool_filter", {}).get("exclude_for", {}).get(target, [])
    if not excluded:
        return None
    tool_list = ", ".join(excluded)
    return (
        f"# WARNING: server-side tool denial required for {target}:\n"
        f"#   {tool_list}\n"
        f"# (grok CLI TOML has no per-server tool-filter primitive — enforce\n"
        f"# via vortex bearer-token scoping; see docs/vortex-token-scopes.md.)"
    )


def _emit_grok_toml_block(server: dict[str, Any], target: str) -> str:
    """Emit a single [mcp_servers.<name>] block for a grok-direct server entry."""
    name = server["name"]
    url = server.get("url", "")
    transport = server.get("transport", "http")
    auth_env = server.get("auth", {}).get("env", "")

    lines: list[str] = [
        f"[mcp_servers.{name}]",
        f'url = "{url}"',
        f'type = "{transport}"',
        "enabled = true",
        "",
    ]

    warning = _warn_if_exclude_for(server, target)
    if warning:
        lines.append(warning)
        lines.append("")

    if auth_env:
        lines.append(f"[mcp_servers.{name}.headers]")
        lines.append(f'Authorization = "Bearer <{auth_env}>"')

    return "\n".join(lines)


def generate(registry_path: Path, target: str) -> str:
    """Return the TOML config string for all servers projecting to `target`."""
    data = _load_registry(registry_path)

    version = data.get("schema_version")
    if version != _SCHEMA_VERSION:
        print(
            f"WARNING: schema_version={version!r} != expected {_SCHEMA_VERSION!r}",
            file=sys.stderr,
        )

    servers = data.get("server", [])
    blocks: list[str] = []
    for server in servers:
        applicable = server.get("applicable_targets", [])
        if target not in applicable:
            continue
        if server.get("transport") == "cursor-internal":
            continue
        blocks.append(_emit_grok_toml_block(server, target))

    header = (
        "# Auto-generated by scripts/gen-agents-md from mcp-registry.toml.\n"
        '# Source: mcp-registry.toml (schema_version="1"; locked 2026-05-22).\n'
        "# Do not edit this block directly — edit mcp-registry.toml and re-run.\n"
    )
    return header + "\n".join(blocks) + "\n"


def _extract_agents_md_mcp_block(agents_md: Path) -> str | None:
    """Extract the generated TOML block from the MCP surface section of AGENTS.md."""
    text = agents_md.read_text()
    marker_start = "<!-- gen-agents-md:start -->"
    marker_end = "<!-- gen-agents-md:end -->"
    start = text.find(marker_start)
    end = text.find(marker_end)
    if start == -1 or end == -1:
        return None
    return text[start + len(marker_start) : end].strip()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--registry",
        type=Path,
        default=None,
        help="Path to mcp-registry.toml (default: workspace root).",
    )
    parser.add_argument(
        "--target",
        default="grok-direct",
        help="Projection target class (default: grok-direct).",
    )
    parser.add_argument(
        "--raw",
        action="store_true",
        help="Emit bare TOML without markdown fences.",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Exit non-zero if generated output differs from AGENTS.md block.",
    )
    args = parser.parse_args(argv)

    root = _workspace_root()
    registry = args.registry or root / "mcp-registry.toml"

    if not registry.exists():
        print(f"ERROR: registry not found: {registry}", file=sys.stderr)
        return 1

    output = generate(registry, args.target)

    if args.check:
        agents_md = root / "AGENTS.md"
        if not agents_md.exists():
            print("ERROR: AGENTS.md not found for --check", file=sys.stderr)
            return 1
        current = _extract_agents_md_mcp_block(agents_md)
        if current is None:
            print(
                "ERROR: gen-agents-md markers not found in AGENTS.md.\n"
                "Add <!-- gen-agents-md:start --> / <!-- gen-agents-md:end --> "
                "around the MCP surface TOML block.",
                file=sys.stderr,
            )
            return 1
        if current.strip() != output.strip():
            print("DIFF: AGENTS.md MCP block is out of sync with mcp-registry.toml.")
            print("Re-run: scripts/gen-agents-md > /dev/null  (and update AGENTS.md)")
            return 1
        print("OK: AGENTS.md MCP block matches mcp-registry.toml.")
        return 0

    if args.raw:
        print(output, end="")
    else:
        print("```toml")
        print(output, end="")
        print("```")

    return 0


if __name__ == "__main__":
    sys.exit(main())
