#!/usr/bin/env python3
"""Toggle global CDP → cursor-sdk reroute in route_policy.yaml."""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path
from typing import Any

import yaml

_REPO = Path(__file__).resolve().parent.parent
_POLICY_PATH = _REPO / "config" / "routing" / "route_policy.yaml"
_ENABLED_RE = re.compile(
    r"(^cdp_reroute:\n(?:  .+\n)*?  enabled:\s*)(true|false)",
    re.MULTILINE,
)


def _load_block() -> dict[str, Any]:
    data = yaml.safe_load(_POLICY_PATH.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise SystemExit(f"invalid policy file: {_POLICY_PATH}")
    block = data.get("cdp_reroute")
    if not isinstance(block, dict):
        raise SystemExit("cdp_reroute block missing from route_policy.yaml")
    return block


def cmd_status() -> int:
    block = _load_block()
    print(f"cdp_reroute.enabled={block.get('enabled')!r}")
    print(f"target_model={block.get('target_model')!r}")
    print(f"effort={block.get('effort')!r}")
    print(f"match_prefixes={block.get('match_prefixes')!r}")
    return 0


def _set_enabled(enabled: bool) -> None:
    text = _POLICY_PATH.read_text(encoding="utf-8")
    if "cdp_reroute:" not in text:
        raise SystemExit("cdp_reroute block missing from route_policy.yaml")
    repl = rf"\g<1>{'true' if enabled else 'false'}"
    updated, count = _ENABLED_RE.subn(repl, text, count=1)
    if count != 1:
        raise SystemExit("could not locate cdp_reroute.enabled in route_policy.yaml")
    _POLICY_PATH.write_text(updated, encoding="utf-8")


def cmd_set(enabled: bool) -> int:
    _set_enabled(enabled)
    print(f"cdp_reroute.enabled={enabled}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="CDP global reroute toggle")
    parser.add_argument("command", choices=["status", "on", "off"])
    args = parser.parse_args()
    if args.command == "status":
        return cmd_status()
    if args.command == "on":
        return cmd_set(True)
    return cmd_set(False)


if __name__ == "__main__":
    sys.exit(main())
