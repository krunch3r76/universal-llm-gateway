#!/usr/bin/env python3
"""Query the event service — operations, SQL, and WebSocket subscriptions.

Usage:
  query-events --op recent-failures --limit 10
  query-events --op noise-profile --minutes 5
  query-events --op pipeline-trace --execution-id c4c7448d
  query-events --op operations
  query-events --sql "SELECT signal, COUNT(*) c FROM events GROUP BY signal ORDER BY c DESC LIMIT 20"
  query-events --sql "SELECT * FROM events WHERE execution_id = ?" --sql-param c4c7448d
  query-events --subscribe --filter signal=federation.*
"""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import sys
from typing import Any

_QUERY_SOCKET = os.environ.get(
    "EVENTS_QUERY_SOCK", "/tmp/universal-protocol/events-query.sock"
)


def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="Query the event service over UDS.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    p.add_argument(
        "--op", help="Named operation (e.g. recent-failures, pipeline-trace)"
    )
    p.add_argument(
        "--param",
        action="append",
        default=[],
        help="Operation param as key=value (repeatable)",
    )
    p.add_argument("--sql", help="Raw SQL query (SELECT only)")
    p.add_argument(
        "--sql-param",
        action="append",
        default=[],
        help="Bind parameter for --sql query (repeatable, positional order)",
    )
    p.add_argument(
        "--subscribe",
        action="store_true",
        help="Subscribe to live events via WebSocket",
    )
    p.add_argument(
        "--filter",
        action="append",
        default=[],
        help="Subscription filter as key=value (repeatable)",
    )
    p.add_argument(
        "--limit",
        type=int,
        default=None,
        help="Max rows (forwarded on --op only when given; --sql defaults to 100)",
    )
    p.add_argument(
        "--socket",
        default=None,
        help="Origin UDS socket. Default authority is the Stargate capability URL.",
    )
    p.add_argument("--compact", action="store_true", help="Compact JSON output")
    return p


def _parse_kv(items: list[str]) -> dict[str, str]:
    result: dict[str, str] = {}
    for item in items:
        if "=" not in item:
            print(f"Invalid key=value: {item}", file=sys.stderr)
            sys.exit(1)
        k, v = item.split("=", 1)
        result[k.strip()] = v.strip()
    return result


def _authority(socket_path: str | None) -> tuple[str, str]:
    from transport_utils import DEFAULT_STARGATE_URL

    if socket_path:
        return f"unix://{socket_path}", "/api/v1/observability"
    return DEFAULT_STARGATE_URL, "/api/v1/capabilities/observability"


def _forward_unknown(tokens: list[str]) -> dict[str, str]:
    """Turn ``--key value`` and ``--key=value`` into params. Other tokens exit 2."""
    params: dict[str, str] = {}
    index = 0
    while index < len(tokens):
        token = tokens[index]
        if not token.startswith("--") or token == "--":
            print(f"Unexpected argument: {token}", file=sys.stderr)
            sys.exit(2)
        body = token[2:]
        if "=" in body:
            key, value = body.split("=", 1)
            index += 1
        else:
            if index + 1 >= len(tokens) or tokens[index + 1].startswith("-"):
                print(f"Missing value for --{body}", file=sys.stderr)
                sys.exit(2)
            key, value = body, tokens[index + 1]
            index += 2
        params[key.replace("-", "_")] = value
    return params


def _query(
    socket_path: str | None,
    *,
    op: str | None,
    params: dict[str, str],
    sql: str | None,
    sql_params: list[str],
    limit: int | None,
) -> dict[str, Any]:
    """Call the canonical capability URL, or the origin when --socket is set."""
    url, prefix = _authority(socket_path)
    follow = socket_path is None
    if sql:
        return _sql(url, prefix, sql, sql_params, limit, follow)
    if op == "operations" or op is None:
        return _listing(url, prefix, follow)
    forwarded = dict(params)
    if limit is not None:
        forwarded["limit"] = str(limit)
    return _member(url, prefix, op, forwarded, follow)


def _client(url: str, follow: bool) -> Any:
    from transport_utils import make_sync_client

    return make_sync_client(url, timeout=10.0, follow_redirects=follow)


def _interpret(resp: Any) -> dict[str, Any]:
    from event_store.query_client import _from_response

    return _from_response(resp)


def _listing(url: str, prefix: str, follow: bool) -> dict[str, Any]:
    import httpx

    try:
        with _client(url, follow) as client:
            return _interpret(client.get(prefix))
    except httpx.HTTPStatusError as exc:
        return _interpret(exc.response)
    except httpx.HTTPError as exc:
        from event_store.query_client import _transport_error

        return _transport_error(exc)


def _member(
    url: str, prefix: str, name: str, params: dict[str, str], follow: bool
) -> dict[str, Any]:
    import httpx

    try:
        with _client(url, follow) as client:
            return _interpret(client.get(f"{prefix}/{name}", params=params))
    except httpx.HTTPStatusError as exc:
        return _interpret(exc.response)
    except httpx.HTTPError as exc:
        from event_store.query_client import _transport_error

        return _transport_error(exc)


def _sql(
    url: str,
    prefix: str,
    sql: str,
    sql_params: list[str],
    limit: int | None,
    follow: bool,
) -> dict[str, Any]:
    import httpx

    body: dict[str, Any] = {"sql": sql, "limit": 100 if limit is None else limit}
    if sql_params:
        body["params"] = sql_params
    try:
        with _client(url, follow) as client:
            return _interpret(client.post(f"{prefix}/sql", json=body))
    except httpx.HTTPStatusError as exc:
        return _interpret(exc.response)
    except httpx.HTTPError as exc:
        from event_store.query_client import _transport_error

        return _transport_error(exc)


async def _subscribe(
    socket_path: str, event_filter: dict[str, str], compact: bool
) -> None:
    """Connect via WebSocket and stream events."""
    import aiohttp

    connector = aiohttp.UnixConnector(path=socket_path)
    async with aiohttp.ClientSession(connector=connector) as session:
        async with session.ws_connect("http://localhost/v1/subscribe") as ws:
            sub_msg: dict[str, Any] = {"type": "subscribe"}
            if event_filter:
                sub_msg["filter"] = event_filter
            await ws.send_json(sub_msg)

            async for msg in ws:
                if msg.type == aiohttp.WSMsgType.TEXT:
                    data = json.loads(msg.data)
                    indent = None if compact else 2
                    print(json.dumps(data, indent=indent, default=str))
                elif msg.type in (aiohttp.WSMsgType.CLOSED, aiohttp.WSMsgType.ERROR):
                    break


def _emit_failure(result: dict[str, Any], indent: int | None, socket_path: str | None) -> None:
    message = str(result.get("error") or "")
    if socket_path is None and result.get("status") is None:
        message = f"{message} Break glass with --socket."
        result = {**result, "error": message}
    print(json.dumps(result, indent=indent, default=str), file=sys.stderr)
    sys.exit(1)


def main() -> None:
    parser = _build_parser()
    args, unknown = parser.parse_known_args()
    indent = None if args.compact else 2

    if args.subscribe:
        event_filter = _parse_kv(args.filter)
        socket_path = args.socket or _QUERY_SOCKET
        try:
            asyncio.run(_subscribe(socket_path, event_filter, args.compact))
        except KeyboardInterrupt:
            pass
        return

    extra = _forward_unknown(unknown) if args.op else {}
    if unknown and not args.op:
        _forward_unknown(unknown)
    params = {**_parse_kv(args.param), **extra}
    try:
        result = _query(
            args.socket,
            op=args.op,
            params=params,
            sql=args.sql,
            sql_params=list(args.sql_param or []),
            limit=args.limit,
        )
    except Exception as exc:
        print(f"Query failed: {exc}", file=sys.stderr)
        sys.exit(1)
    status = result.get("status")
    if result.get("error") and (status is None or (isinstance(status, int) and status >= 400)):
        _emit_failure(result, indent, args.socket)
    print(json.dumps(result, indent=indent, default=str))


if __name__ == "__main__":
    main()
