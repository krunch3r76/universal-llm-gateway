#!/usr/bin/env bash
# Launch the Model Manager TUI.
# Creates $HOME/.venvs/universal and installs host requirements if missing.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$HOME/.venvs/universal"
VENV_PYTHON="$VENV_DIR/bin/python"
PY_VERSION="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"

check_venv_support() {
    if python3 -m ensurepip --version &>/dev/null; then
        return 0
    fi

    echo "Error: python3-venv is not installed." >&2
    echo "" >&2

    if command -v apt &>/dev/null; then
        echo "  sudo apt install python${PY_VERSION}-venv" >&2
    elif command -v dnf &>/dev/null; then
        echo "  sudo dnf install python${PY_VERSION}-venv" >&2
    elif command -v pacman &>/dev/null; then
        echo "  sudo pacman -S python" >&2
    elif command -v zypper &>/dev/null; then
        echo "  sudo zypper install python3-venv" >&2
    else
        echo "  Install the python3-venv package for your distribution." >&2
    fi

    echo "" >&2
    echo "Then re-run: ./manage" >&2
    exit 1
}

HEADLESS_SUBCOMMANDS="relay topology"
is_headless() {
    [[ -n "${1:-}" ]] && [[ " $HEADLESS_SUBCOMMANDS " == *" $1 "* ]]
}

REQUIREMENTS_FILE="$SCRIPT_DIR/requirements.host.txt"
STAMP_FILE="$VENV_DIR/.requirements-stamp"

if [[ ! -f "$VENV_PYTHON" ]]; then
    check_venv_support

    if ! is_headless "${1:-}"; then
        echo ""
        echo "A Python virtual environment is needed for the TUI and host services."
        echo ""
        echo "  Location: $VENV_DIR"
        echo "  Python:   $(python3 --version)"
        echo "  Deps:     requirements.host.txt (no GPU/torch — those run in Docker)"
        echo ""
        read -rp "Create venv and install? [Y/n] " answer
        if [[ "${answer,,}" =~ ^n ]]; then
            echo "Aborted." >&2
            exit 0
        fi
        echo ""
    fi

    echo "Creating venv at $VENV_DIR ..." >&2
    mkdir -p "$(dirname "$VENV_DIR")"
    python3 -m venv "$VENV_DIR"

    echo "Copying sitecustomize.py into venv ..." >&2
    SITE_PACKAGES="$VENV_DIR"/lib/python*/site-packages
    cp "$SCRIPT_DIR/sitecustomize.py" $SITE_PACKAGES/

    echo "Installing host requirements ..." >&2
    "$VENV_DIR/bin/pip" install -r "$REQUIREMENTS_FILE"
    cp "$REQUIREMENTS_FILE" "$STAMP_FILE"
    echo ""
    if is_headless "${1:-}"; then
        echo "Done."
    else
        echo "Done. Launching TUI ..."
    fi
    echo ""
elif ! diff -q "$REQUIREMENTS_FILE" "$STAMP_FILE" &>/dev/null; then
    echo "requirements.host.txt changed — syncing venv ..." >&2
    "$VENV_DIR/bin/pip" install -r "$REQUIREMENTS_FILE"
    cp "$REQUIREMENTS_FILE" "$STAMP_FILE"
    echo "" >&2
fi

# Ensure model directory exists as current user (not root via Docker bind mount)
MODEL_DIR="$HOME/.models"
_node_env="$HOME/.gateway/nodes/localhost.env"
if [[ -f "$_node_env" ]]; then
    _val=$(grep -E '^MODEL_PATH=' "$_node_env" | head -1 | cut -d= -f2-)
    [[ -n "$_val" ]] && MODEL_DIR="$_val"
fi

if [[ -d "$MODEL_DIR" ]]; then
    _owner=$(stat -c '%u' "$MODEL_DIR" 2>/dev/null || stat -f '%u' "$MODEL_DIR" 2>/dev/null)
    if [[ "$_owner" == "0" && "$(id -u)" != "0" ]]; then
        echo "ERROR: $MODEL_DIR is owned by root." >&2
        echo "Docker created this directory via a bind mount." >&2
        echo "Fix with:  sudo chown -R $(id -u):$(id -g) $MODEL_DIR" >&2
        exit 1
    fi
else
    mkdir -p "$MODEL_DIR"
fi

# Local environment overrides (canonical location for all entry points)
if [[ -f "$SCRIPT_DIR/.env.local" ]]; then
    set -a
    source "$SCRIPT_DIR/.env.local"
    set +a
fi

case "${1:-}" in
    relay)
        shift
        exec "$VENV_PYTHON" -m scripts.model_manager.relay "$@"
        ;;
    topology)
        shift
        exec "$VENV_PYTHON" -m scripts.model_manager.topology "$@"
        ;;
    *)
        exec "$VENV_PYTHON" -m scripts.model_manager.ui "$@"
        ;;
esac
